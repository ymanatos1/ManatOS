digraph G {
 graph [fontname="Arial", fontsize=10, bgcolor="white", labelloc="t", label="ManatOS - Authentication, Session and Organization-scoped Read Flow"];
 node [fontname="Arial", fontsize=9, shape=box, style="rounded,filled", fillcolor="white"]; edge [fontname="Arial", fontsize=8]; rankdir=LR;
 login [label="Login\nidentity + credential"];
 user [label="SysUser\nrole + principalId"];
 token [label="AccessTokenStore\nconcurrent sessions"];
 request [label="Authenticated API request\nBearer + x-request-id"];
 policy [label="AuthorizationService\nAdmin: all rows\nUser/Superuser: organization scope\nGuest: restricted areas"];
 org [label="Organization scope\nuser.principalId -> principal\nrootPrincipalId"];
 result [label="Authorized collection\nthen filter/sort/page"];
 login -> user -> token -> request -> policy -> result; user -> org -> policy;
}
