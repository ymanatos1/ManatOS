digraph Runtime {
 graph [fontname="Arial",fontsize=11,bgcolor="white",labelloc="t",label="TypeScript Runtime and Context Ownership",pad="0.22",rankdir=TB];
 node [fontname="Arial",fontsize=10,shape=box,style="rounded,filled",fillcolor="white"];
 metadata [label="Canonical shared contracts\nmetadata / expressions / CTX engine",fillcolor="#fff3cd"];
 uis [label="shared.UI semantic runtime\nUIS surfaces / fields / Flows",fillcolor="#e8f4e5"];
 ng [label="Angular adapter / NG1 host",fillcolor="#dcecff"];
 ejs [label="EJS adapter / EJS1 host",fillcolor="#dcecff"];
 ejs0 [label="EJS0 (separate established host)",fillcolor="#f4f4f4"];
 api [label="API process\nrequest CTX / authorization / transactions",fillcolor="#dcecff"];
 store [label="Active InMemory/JSON store\nrepository semantics",fillcolor="#fce8e6"];
 metadata -> uis;metadata -> api;uis -> ng;uis -> ejs;ng -> api;ejs -> api;ejs0 -> api;api -> store;
}
