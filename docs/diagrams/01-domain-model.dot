digraph Domains {
  graph [fontname="Arial",fontsize=11,bgcolor="white",labelloc="t",label="Application Foundation: Shared Domain, Platform and Application",pad="0.25",rankdir=TB,nodesep="0.45",ranksep="0.55"];
  node [fontname="Arial",fontsize=10,shape=box,style="rounded,filled",fillcolor="#f7f8fa"];
  foundation [label="Shared application foundation\nMetadata / CTX / Expressions / UIS\nAPI / Authorization / Storage", fillcolor="#dcecff"];
  shared [label="Shared business domain (code: Company)\nUsers / Person and Organization Principals\nLicenses / Contacts / External identities", fillcolor="#e8f4e5"];
  proto [label="protoCRM - multi-application platform\nApplication catalogue / Apps Playground\nApplication design and execution architecture", fillcolor="#fff3cd"];
  pano [label="Panoptes - special-purpose application\nSurveillance: Projects / Posts / Guards", fillcolor="#fff3cd"];
  foundation -> shared [label="shared model"];
  foundation -> proto [label="shared runtime"];
  foundation -> pano [label="shared runtime"];
  shared -> proto [style=dashed,label="identity / license relationships"];
  shared -> pano [style=dashed,label="identity / access"];
}
