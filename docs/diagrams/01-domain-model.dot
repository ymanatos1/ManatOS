digraph G {
 graph [fontname="Arial", fontsize=10, bgcolor="white", labelloc="t", label="ManatOS - Company and protoCRM Domain Ownership"];
 node [fontname="Arial", fontsize=9, shape=box, style="rounded,filled", fillcolor="white"];
 edge [fontname="Arial", fontsize=8]; rankdir=LR;
 company [label="ManatOS / Company scope\nUsers + Account\nPrincipals + organization hierarchy\nLicenses\nExternal Authentication Providers", fillcolor="#dcecff"];
 user [label="SysUser\nauthenticates\noptional principalId"];
 principal [label="SysPrincipal\nPerson / Group / Company / System\nparentId + rootPrincipalId"];
 license [label="SysLicense\nprincipalId + platformId\noptional applicationId"];
 platform [label="Platform\nprotoCRM", fillcolor="#e8f4e5"];
 app [label="SysApplication\nprotoCRM-owned managed application", fillcolor="#e8f4e5"];
 future [label="Future application-defined entities\nreuse generic metadata/CTX/storage infrastructure\nnot automatically SysBO-prefixed", fillcolor="#fff1da"];
 company -> user; company -> principal; company -> license; user -> principal [label="identifies Person"]; principal -> principal [label="parent/root"]; license -> principal [label="customer"]; license -> platform; license -> app [style=dashed,label="restriction"]; platform -> app; app -> future [style=dashed];
}
