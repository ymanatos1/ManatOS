digraph UIS {
 graph [fontname="Arial",fontsize=11,bgcolor="white",labelloc="t",label="UIS Semantic Contracts and Rendering Adapters",pad="0.22",rankdir=TB];
 node [fontname="Arial",fontsize=10,shape=box,style="rounded,filled",fillcolor="white"];
 canonical [label="Canonical metadata / CTX / API contracts",fillcolor="#fff3cd"];
 semantic [label="shared.UI\nSurface Host · embedded components\nList · Entry · Popup · Flow",fillcolor="#e8f4e5"];
 ng [label="shared.UI.NG → ui.NG1\nAngular DOM / focus / host",fillcolor="#dcecff"];
 ejs [label="shared.UI.EJS → ui.EJS1\nEJS templates / browser host",fillcolor="#dcecff"];
 api [label="API authority\nauthorization / persistence",fillcolor="#fce8e6"];
 canonical -> semantic;semantic -> ng;semantic -> ejs;ng -> api;ejs -> api;
}
