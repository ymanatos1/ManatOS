# =============================================================================
# ManatOS API environment configuration
# =============================================================================
# Copy this file to api/.env and provide environment-specific values there.
# Never commit real passwords, encryption keys, API keys, or other secrets.
#
# Configuration is intentionally split into two categories:
#   1. Deployment/bootstrap settings, which remain environment-managed.
#   2. SysConfiguration bootstrap/default values, which can be persisted and
#      subsequently maintained by an Admin from Configuration > Configuration.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment / process
# -----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_ACCESS_TOKEN_MINUTES=60

# Primary datastore used by the current JSON persistence adapter.
DATA_FILE=../data/database.json

# -----------------------------------------------------------------------------
# Trusted UI/BFF -> API authentication
# -----------------------------------------------------------------------------
# Authenticates trusted server-to-server operations from the ManatOS UI/BFF.
# This is NOT an OAuth/provider key and is never intended for browser code.
#
# Generate a strong random value once per environment, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - Put the EXACT SAME value in api/.env and ui/.env.
# - Keep it server-side; never expose it to browser JavaScript or commit it.
# - Use different values for development/test/production.
# - Do NOT move this root trust secret into SysConfiguration.
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Bootstrap administrator
# -----------------------------------------------------------------------------
# Optional first-Admin bootstrap. Change the example password before using the
# project outside local development.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# -----------------------------------------------------------------------------
# Reversible application-secret encryption
# -----------------------------------------------------------------------------
# Used for secrets that ManatOS must later recover, such as OAuth Client Secrets
# and sensitive SysConfiguration values such as SMTP_PASSWORD.
#
# SECRETS_ENCRYPTION_ACTIVE_KEY_ID is a non-secret identifier for the currently
# active key generation. Keep "v1" until intentionally rotating encryption keys.
#
# Generate SECRETS_ENCRYPTION_KEY ONCE per environment:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - Do not commit or share the encryption key.
# - Back it up securely; losing it makes persisted encrypted secrets unreadable.
# - Do NOT regenerate it on every restart.
# - Do NOT reuse INTERNAL_API_KEY or the UI SESSION_SECRET.
# - Use different keys for development/test/production.
# - This root key remains deployment-managed and outside SysConfiguration.
SECRETS_ENCRYPTION_ACTIVE_KEY_ID=v1
SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# File/database-independent logging infrastructure
# -----------------------------------------------------------------------------
# Console formatting: pretty | json.
LOG_FORMAT=pretty

# A non-empty path enables the corresponding file sink; empty/omitted disables it.
LOG_FILE_PATH=../data/logs/manatos-api.log
LOG_FILE_MIN_LEVEL=info
LOG_ERROR_FILE_PATH=../data/logs/manatos-api-error.log
LOG_ERROR_FILE_MIN_LEVEL=error
LOG_FILE_MAX_BYTES=5242880

# Reserved for an independent future database log sink. Empty = disabled.
# Keeping this sink optional allows database outages to be diagnosed through
# console/file logging.
LOG_DATABASE_URL=
LOG_DATABASE_MIN_LEVEL=error

# =============================================================================
# SysConfiguration bootstrap / fallback values
# =============================================================================
# The values below differ from the deployment/root settings above.
#
# They provide initial or fallback values for Admin-maintainable runtime
# configuration. Missing SysConfiguration records are automatically seeded by
# the API from the corresponding environment value, or from the built-in default
# when no environment value is supplied.
#
# After a SysConfiguration record exists, its persisted value is authoritative
# wherever that setting supports runtime configuration. Consequently, changing
# an environment value below does NOT necessarily override an existing record.
#
# Sensitive SysConfiguration values (currently SMTP_PASSWORD) are encrypted
# before persistence and are never returned as plaintext by normal API/UI reads.
# Root trust material such as INTERNAL_API_KEY, SESSION_SECRET and
# SECRETS_ENCRYPTION_KEY must NEVER be moved into SysConfiguration.
#
# Prefer Configuration > Configuration in the Admin UI for routine maintenance
# after initial setup. Settings marked restart-required there take effect after
# the corresponding service is restarted.
# =============================================================================

# -----------------------------------------------------------------------------
# API / diagnostics
# -----------------------------------------------------------------------------
# Generic API list-query pagination defaults and safety limit.
API_DEFAULT_PAGE_SIZE=10
API_MAX_PAGE_SIZE=500

# API diagnostic detail returned to clients: none | basic | operations | full.
# "operations" retains semantic operation traces for power-user diagnostics
# without putting the full trace into routine server logs.
API_ERROR_DETAIL_LEVEL=operations

# Minimum severity written to the API console.
# Levels: debug | info | warn | error | fatal.
LOG_CONSOLE_MIN_LEVEL=info
LOG_CONSOLE_TESTS_MIN_LEVEL=error

# Administrator-assisted email verification fallback.
ADMIN_EMAIL_VERIFICATION_ENABLED=false

# -----------------------------------------------------------------------------
# Mail / SMTP
# -----------------------------------------------------------------------------
# These values seed/fallback the Mail SysConfiguration group. Mail transport
# settings are restart-required because the SMTP transport is constructed by
# the API service at startup.
MAIL_ENABLED=true
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com

# SMTP account password. When seeded into SysConfiguration, this plaintext
# bootstrap value is encrypted at rest with SECRETS_ENCRYPTION_KEY and is never
# returned to clients. Prefer entering the real value through the Admin UI.
SMTP_PASSWORD=your-mailbox-password

MAIL_FROM_ADDRESS=mailbox@example.com
MAIL_FROM_NAME=Application

# Keep true whenever the SMTP server presents a publicly trusted certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
