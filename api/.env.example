NODE_ENV=development
API_PORT=3000
API_ACCESS_TOKEN_MINUTES=60

# Generic API list-query pagination defaults and safety limit.
API_DEFAULT_PAGE_SIZE=10
API_MAX_PAGE_SIZE=500

# Primary datastore.
DATA_FILE=../data/database.json

# Trusted UI -> API operations. Use a strong secret outside development.
INTERNAL_API_KEY=change-this-internal-key

# API diagnostic detail returned to clients: none | basic | operations | full.
# "operations" retains the operation trace for power-user diagnostics without
# putting the full trace into routine server logs.
API_ERROR_DETAIL_LEVEL=operations

# Administrator-assisted email verification fallback.
ADMIN_EMAIL_VERIFICATION_ENABLED=false

# Optional first-admin bootstrap.
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# ---------------------------------------------------------------------------
# SMTP / transactional email
# ---------------------------------------------------------------------------
MAIL_ENABLED=true
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mailbox@example.com
SMTP_PASSWORD=your-mailbox-password
MAIL_FROM_ADDRESS=mailbox@example.com
MAIL_FROM_NAME=Application

# Keep true whenever the SMTP server presents a publicly trusted certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# Server logging
# ---------------------------------------------------------------------------
# Console formatting: pretty | json.
LOG_FORMAT=pretty

# Optional console threshold. When omitted, defaults to fatal in test and info
# otherwise. Levels: debug | info | warn | error | fatal.
LOG_CONSOLE_MIN_LEVEL=info

# A non-empty path enables that file sink; empty/omitted disables it.
LOG_FILE_PATH=../data/logs/manatos-api.log
LOG_FILE_MIN_LEVEL=info
LOG_ERROR_FILE_PATH=../data/logs/manatos-api-error.log
LOG_ERROR_FILE_MIN_LEVEL=error
LOG_FILE_MAX_BYTES=5242880

# Reserved for an independent future database log sink. Empty = disabled.
# The database sink must remain optional so database outages can still be
# diagnosed through console/file sinks.
LOG_DATABASE_URL=
LOG_DATABASE_MIN_LEVEL=error
