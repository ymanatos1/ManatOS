{
  "name": "@manatos/shared",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./metadata/ui": {
      "types": "./dist/metadata/ui/index.d.ts",
      "import": "./dist/metadata/ui/index.js"
    },
    "./metadata/bo": {
      "types": "./dist/metadata/bo/index.d.ts",
      "import": "./dist/metadata/bo/index.js"
    },
    "./expressions": {
      "types": "./dist/expressions/index.d.ts",
      "import": "./dist/expressions/index.js"
    },
    "./presentation/entry-representation": {
      "types": "./dist/presentation/entry-representation.d.ts",
      "import": "./dist/presentation/entry-representation.js"
    },
    "./presentation/picture-value": {
      "types": "./dist/presentation/picture-value.d.ts",
      "import": "./dist/presentation/picture-value.js"
    },
    "./domain/company-platform": {
      "types": "./dist/domain/company-platform.d.ts",
      "import": "./dist/domain/company-platform.js"
    },
    "./errors/app-error": {
      "types": "./dist/errors/app-error.d.ts",
      "import": "./dist/errors/app-error.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "vitest": "^3.2.4"
  }
}
