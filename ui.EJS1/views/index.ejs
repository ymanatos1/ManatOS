    <meta name="theme-color" content="#557da9" />

    <script>
      (() => {
        try {
          const parse = (raw) => {
            try {
              return raw ? JSON.parse(raw) : null;
            } catch {
              return null;
            }
          };
          const preferences = parse(localStorage.getItem('manatos.ui.preferences.v2'));
          const legacy =
            preferences?.version === 2
              ? null
              : parse(localStorage.getItem('manatos.ui.preferences.v1'));
          const theme =
            preferences?.version === 2
              ? preferences?.paint?.theme
              : legacy?.version === 1
                ? legacy?.theme
                : null;
          document.documentElement.dataset.uiTheme = theme === 'darker' ? 'darker' : 'lighter';
        } catch {
          document.documentElement.dataset.uiTheme = 'lighter';
        }
      })();
    </script>

