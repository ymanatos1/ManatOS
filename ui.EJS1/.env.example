# ============================================================
# ManatOS - UI Configuration
# ============================================================
# Common configuration for all UI hosts.
# Copy to .env and adjust values for each deployment.

# Environment: development, test, production.
UI_ENVIRONMENT=development

# Port on which the UI host listens.
UI_PORT=3003

# ManatOS API server address.
API_BASE_URL=http://localhost:3000

# Public browser-facing UI address.
# Also used for authentication redirects and OAuth callbacks.
UI_PUBLIC_BASE_URL=http://localhost:3003

# Root directory containing the documentation repository.
DOCUMENTATION_REPOSITORY_ROOT=..

# Secret used to protect UI browser sessions.
# Each UI deployment should have its own value.
SESSION_SECRET=

# Trusted request delegation secret.
# Must match the corresponding API configuration.
AUTH_DELEGATION_SECRET=

# Internal server-to-server authentication key.
# Must match the corresponding API configuration.
INTERNAL_API_KEY=
