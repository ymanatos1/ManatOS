<header class="top-header">
  <a
    href="/"
    class="brand-link"
    title="ManatOS home"
    aria-label="ManatOS home"
  >
    <img
      src="/assets/manatos-logo-middle-1.png"
      alt="ManatOS Software Solutions"
      class="brand-logo"
    >
  </a>

  <div class="header-actions">
    <span class="version-badge d-none d-sm-inline">
      v<%= app.version %>
    </span>

    <% if (!currentUser) { %>
      <button
        type="button"
        class="btn btn-info btn-sm header-auth-button"
        data-bs-toggle="modal"
        data-bs-target="#signInModal"
      >
        <i class="bi bi-box-arrow-in-right me-1"></i>
        Sign in
      </button>

      <button
        type="button"
        class="btn btn-success btn-sm header-auth-button"
        data-bs-toggle="modal"
        data-bs-target="#signUpMethodModal"
      >
        <i class="bi bi-person-plus me-1"></i>
        Sign up
      </button>
    <% } else { %>
      <div class="user-summary d-none d-md-flex">
        <span class="user-summary-name"><%= currentUser.name %></span>
      </div>

      <div class="dropdown">
        <button
          class="btn btn-sm btn-outline-light dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <i class="bi bi-person-circle me-1"></i>
          Account
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow-sm account-menu">
          <li class="px-3 pt-2 pb-1">
            <div class="account-menu-name"><%= currentUser.name %></div>
            <span class="badge rounded-pill text-bg-light border account-role-badge">
              <%= currentUser.role %>
            </span>
          </li>

          <li><hr class="dropdown-divider"></li>

          <li>
            <a class="dropdown-item" href="/account">
              <i class="bi bi-person-vcard me-2"></i>
              Account details
            </a>
          </li>

          <li>
            <a class="dropdown-item" href="/personal">
              <i class="bi bi-person-lines-fill me-2"></i>
              Personal details
            </a>
          </li>

          <li><hr class="dropdown-divider"></li>

          <li>
            <a class="dropdown-item" href="/auth/logout">
              <i class="bi bi-box-arrow-right me-2"></i>
              Logout
            </a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</header>
