<ul class="vertical-menu level-<%= level %>">
  <% for (const item of items) { %>
    <% if (item.separatorBefore) { %><li class="vertical-separator"><hr></li><% } %>
    <li>
      <% if (item.children?.length) { %>
        <details <%= level === 0 ? 'open' : '' %>>
          <summary>
            <span><% if (item.icon) { %><i class="bi <%= item.icon %> me-2"></i><% } %><%= item.text %></span>
            <i class="bi bi-chevron-down menu-chevron"></i>
          </summary>
          <%- include('vertical-nav', { items: item.children, level: level + 1 }) %>
        </details>
      <% } else { %>
        <a href="<%= item.url || '#' %>">
          <% if (item.icon) { %><i class="bi <%= item.icon %> me-2"></i><% } %>
          <%= item.text %>
        </a>
      <% } %>
    </li>
  <% } %>
</ul>
