<section class="content-card account-card">
  <div class="account-summary-grid">
    <div class="account-summary-label">User name</div>
    <div class="account-summary-value"><%= currentUser.name %></div>

    <div class="account-summary-label">Email</div>
    <div class="account-summary-value">
      <%= currentUser.email %>
      <span class="badge text-bg-<%= currentUser.emailVerified ? 'success' : 'warning' %> ms-1">
        <%= currentUser.emailVerified ? 'Verified' : 'Not verified' %>
      </span>
    </div>

    <div class="account-summary-label">Website role</div>
    <div class="account-summary-value">
      <span class="badge rounded-pill text-bg-light border"><%= currentUser.role %></span>
    </div>

    <div class="account-summary-label">Local password</div>
    <div class="account-summary-value">
      <span class="status-value <%= currentUser.hasPassword ? 'status-positive' : 'status-neutral' %>">
        <i class="bi <%= currentUser.hasPassword ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"></i>
        <%= currentUser.hasPassword ? 'Configured' : 'Not configured' %>
      </span>
    </div>
  </div>

  <hr class="my-4">

  <div class="form-section-header">
    <h2 class="h5 mb-1">
      <%= currentUser.hasPassword ? 'Change password' : 'Set local password' %>
    </h2>
    <p class="text-secondary mb-0">
      <%= currentUser.hasPassword
        ? 'Confirm your current password, then choose a new one.'
        : 'Add a local password so this account can also sign in with email or user name.' %>
    </p>
  </div>

  <form
    method="post"
    action="/account/password"
    class="form-narrow mt-4"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (currentUser.hasPassword) { %>
      <label class="form-label" for="currentPassword">Current password</label>
      <input
        class="form-control mb-3"
        id="currentPassword"
        type="password"
        name="currentPassword"
        autocomplete="current-password"
        required
      >
    <% } %>

    <label class="form-label" for="newPassword">New password</label>
    <input
      class="form-control password-policy-input"
      id="newPassword"
      type="password"
      name="password"
      autocomplete="new-password"
      required
    >

    <label class="form-label mt-3" for="confirmPassword">Confirm password</label>
    <input
      class="form-control"
      id="confirmPassword"
      type="password"
      name="confirmPassword"
      autocomplete="new-password"
      required
    >

    <%- include('../partials/password-rules') %>

    <button class="btn btn-primary mt-3" type="submit">
      <i class="bi bi-key me-1"></i>
      <%= currentUser.hasPassword ? 'Change password' : 'Set password' %>
    </button>
  </form>
</section>
