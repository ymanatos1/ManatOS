{
  "name": "@manatos/shared-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-page-resources.mjs",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0"
  },
  "dependencies": {
    "@manatos/shared": "0.1.0"
  }
}
