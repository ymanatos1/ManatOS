# =============================================================================
# ManatOS UI/BFF environment configuration
# =============================================================================
# Copy this file to ui/.env and provide environment-specific values there.
# Never commit real session secrets, API keys, or other sensitive values.
#
# Configuration is intentionally split into two categories:
#   1. Deployment/bootstrap settings, which remain environment-managed.
#   2. SysConfiguration-aware UI defaults/fallbacks, grouped at the end.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment / process
# -----------------------------------------------------------------------------
NODE_ENV=development
UI_PORT=3001
API_BASE_URL=http://localhost:3000

# Public browser-visible origin of this UI. External-authentication callback
# paths are provider-defined relative /auth/... paths and resolve against this
# origin.
PUBLIC_BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Trusted UI/BFF -> API authentication
# -----------------------------------------------------------------------------
# Authenticates trusted server-to-server UI/BFF operations against the API.
# It is NOT an OAuth/provider credential and must never reach browser JavaScript.
#
# Generate a strong random value once per environment, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - This MUST be the EXACT SAME value as INTERNAL_API_KEY in api/.env.
# - Keep it server-side and never commit the real value.
# - Use different values for development/test/production.
# - Do NOT move this root trust secret into SysConfiguration.
INTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# UI session trust
# -----------------------------------------------------------------------------
# Secret used by Express to sign/protect the UI session cookie/session state.
# Generate a DIFFERENT strong random value once per environment, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - This value belongs only to the UI; it does NOT match an API setting.
# - Do NOT reuse INTERNAL_API_KEY or SECRETS_ENCRYPTION_KEY.
# - Keep it stable: changing it invalidates existing UI sessions.
# - Never commit the real value; use different values per environment.
# - Do NOT move SESSION_SECRET into SysConfiguration.
SESSION_SECRET=

# External-provider Client IDs/Secrets are intentionally NOT configured here.
# Configure Microsoft, Google, Facebook and GitHub through
# Configuration > External authentication. Client Secrets are encrypted by the
# API before persistence; only successfully verified enabled providers are made
# available to sign-in/registration.

# =============================================================================
# SysConfiguration-aware UI bootstrap / fallback values
# =============================================================================
# These values are safe application-behavior defaults rather than root trust
# secrets. The UI can start with its local defaults even when the API is down;
# when the API becomes available, the safe UI-bootstrap projection of persisted
# SysConfiguration can supersede supported local defaults.
#
# SysConfiguration itself is owned/persisted by the API. Routine runtime changes
# should therefore be made from Configuration > Configuration by an Admin rather
# than by repeatedly editing ui/.env.
#
# Changing a value here does NOT necessarily override an already persisted
# SysConfiguration record. Root secrets such as INTERNAL_API_KEY and
# SESSION_SECRET always remain environment-only.
# =============================================================================

# -----------------------------------------------------------------------------
# Navigation / list presentation
# -----------------------------------------------------------------------------
# none    = collapse/open state resets on every page load
# browser = remember left-navigation and Details state in localStorage
UI_NAVIGATION_STATE_PERSISTENCE=browser

# Default SysBO list pagination. Comma-separated positive integers.
# Individual entity UI definitions may override these defaults in code.
UI_PAGE_SIZE_OPTIONS=2,5,10,20,50,100
UI_DEFAULT_PAGE_SIZE=10

# -----------------------------------------------------------------------------
# Sessions / diagnostics
# -----------------------------------------------------------------------------
# Rolling UI-session inactivity timeout in minutes.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Maximum recent session errors retained for diagnostic presentation.
SESSION_ERROR_LOG_MAX_ENTRIES=20

# Whether technical diagnostic detail may be shown in UI error dialogs.
SHOW_TECHNICAL_ERROR_DETAILS=true

# Allow Admin users to verify another user's email from the UI when the
# corresponding server-side policy permits the operation.
ALLOW_ADMIN_EMAIL_VERIFICATION=true
