<%#
  V2 SysBO entry host adapter.

  Normal page surfaces use the reusable EntryPage composition
  (TitleBar + host-neutral entry content). Hosted popups reuse the exact same
  entry-content component directly; PopupHost owns the popup caption/chrome.
%>
<% if (typeof entryPopupHost !== 'undefined' && entryPopupHost) { %>
  <%- include('../../components/runtime/entity-entry') %>
<% } else { %>
  <%- include('../../components/page/entry-page', {
    entryContentPartial: '../runtime/entity-entry',
  }) %>
<% } %>
