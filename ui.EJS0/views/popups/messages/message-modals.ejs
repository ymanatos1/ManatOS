<%#
  COMPONENT: Message modal family

  Purpose:
  - Renders reusable semantic message/confirmation modals.

  Inputs / metadata:
  - Message popup content and action metadata.

  CTX contract:
  - Shared popup runtime projects active modal state.

  Embeds / delegates:
  - ../shared/message-popup.ejs.

  Runtime contract:
  - Bootstrap popup runtime owns lifecycle.
%>

<%#
  Application-level information and error messages projected through MessagePopupLayout.
  Callers provide semantic status/message data; this template chooses the appropriate title,
  icon, severity surface and action set while preserving one consistent compact appearance.
%>
<% if (typeof warningMessage !== 'undefined' && warningMessage) { %>
  <%- include('../shared/message-popup', {
    modalId: 'warningMessageModal',
    labelId: 'warningMessageModalLabel',
    dialogClass: 'modal-md',
    icon: 'bi-exclamation-triangle',
    headerClass: 'bg-warning-subtle',
    modalTitle: typeof warningTitle !== 'undefined' && warningTitle
      ? warningTitle
      : 'Operation completed with a warning',
    message: warningMessage,
    actions: typeof warningActionUrl !== 'undefined' && warningActionUrl
      ? [{
          label: typeof warningActionLabel !== 'undefined' && warningActionLabel ? warningActionLabel : 'Continue',
          variant: 'btn-primary',
          href: warningActionUrl
        }]
      : [{ label: 'OK', variant: 'btn-primary', dismiss: true }]
  }) %>
<% } %>

<% if (typeof informationMessage !== 'undefined' && informationMessage) { %>
  <%- include('../shared/message-popup', {
    modalId: 'informationMessageModal',
    labelId: 'informationMessageModalLabel',
    dialogClass: 'modal-md',
    icon: 'bi-check-circle',
    headerClass: 'bg-primary-subtle',
    modalTitle: typeof informationTitle !== 'undefined' && informationTitle
      ? informationTitle
      : 'Information',
    message: informationMessage,
    actions: typeof informationActionUrl !== 'undefined' && informationActionUrl
      ? [{
          label: typeof informationActionLabel !== 'undefined' && informationActionLabel ? informationActionLabel : 'Continue',
          variant: 'btn-primary',
          href: informationActionUrl
        }]
      : [{ label: 'OK', variant: 'btn-primary', dismiss: true }]
  }) %>
<% } %>

<%
  const runtimeApplicationError =
    typeof applicationError !== 'undefined' && applicationError ? applicationError : null;
%>
<%- include('../shared/message-popup', {
  modalId: 'applicationErrorModal',
  labelId: 'applicationErrorModalLabel',
  dialogClass: 'modal-lg',
  icon: 'bi-exclamation-triangle',
  headerClass: 'bg-danger-subtle',
  modalTitle: 'Operation failed',
  message: runtimeApplicationError?.userMessage || '',
  operationTrace: runtimeApplicationError?.operationTrace || [],
  autoShow: Boolean(runtimeApplicationError),
  popupInvocation: runtimeApplicationError
    ? {
        error: {
          name: runtimeApplicationError.name || 'AppError',
          code: runtimeApplicationError.code || null,
          message: runtimeApplicationError.message || null,
          userMessage: runtimeApplicationError.userMessage || null,
          retryable: runtimeApplicationError.retryable === true,
          operationTrace: runtimeApplicationError.operationTrace || []
        }
      }
    : {},
  actions: [
    { label: 'Cancel', variant: 'btn-secondary', dismiss: true },
    {
      label: 'Retry',
      variant: 'btn-primary',
      action: 'retry',
      className: runtimeApplicationError?.retryable ? '' : 'd-none'
    }
  ]
}) %>
