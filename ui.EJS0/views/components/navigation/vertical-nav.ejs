<%#
  COMPONENT: Vertical navigation

  Purpose:
  - Renders the authenticated workspace navigation tree from the canonical navigation projection.

  Inputs / metadata:
  - app.navigation.vertical and current route/section state.

  CTX contract:
  - None; permissions/visibility are resolved before presentation.

  Embeds / delegates:
  - None.

  Runtime contract:
  - shell runtime owns collapse/restore behavior; Bootstrap owns nested collapse affordances where present.
%>

<ul class="vertical-menu level-<%= level %>">
  <% for (const item of items) { %>
    <% if (item.separatorBefore) { %>
      <li class="vertical-separator"><hr></li>
    <% } %>

    <li>
      <% if (item.children?.length) { %>
        <details <%= level === 0 ? 'open' : '' %>>
          <summary title="<%= item.text %>">
            <span class="vertical-menu-caption">
              <% if (item.icon) { %>
                <i class="bi <%= item.icon %> me-2"></i>
              <% } %>
              <span><%= item.text %></span>
            </span>

            <i class="bi bi-chevron-down menu-chevron"></i>
          </summary>

          <%- include('vertical-nav',
            {
              items: item.children,
              level: level + 1
            }
          ) %>
        </details>
      <% } else if (item.action === 'open-preferences') { %>
        <button
          type="button"
          class="vertical-menu-action"
          data-bs-toggle="modal"
          data-bs-target="#preferencesModal"
          title="<%= item.text %>"
          aria-label="<%= item.text %>"
        >
          <span class="vertical-menu-caption">
            <% if (item.icon) { %>
              <i class="bi <%= item.icon %> me-2"></i>
            <% } %>
            <span><%= item.text %></span>
          </span>
        </button>
      <% } else { %>
        <a href="<%= item.url || '#' %>" title="<%= item.text %>">
          <span class="vertical-menu-caption">
            <% if (item.icon) { %>
              <i class="bi <%= item.icon %> me-2"></i>
            <% } %>
            <span><%= item.text %></span>
          </span>
        </a>
      <% } %>
    </li>
  <% } %>
</ul>
