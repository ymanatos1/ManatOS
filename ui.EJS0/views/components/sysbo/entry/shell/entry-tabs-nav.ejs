<%#
  COMPONENT: Entry tabs navigation

  Purpose:
  - Renders metadata-declared entry tabs with canonical labels/icons and active state.

  Inputs / metadata:
  - metadataUI entry tab definitions and selected tab key.

  CTX contract:
  - None.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Bootstrap/tab navigation plus shell persistence where configured.
%>
<% const effectiveTabDomPrefix = typeof tabDomPrefix === 'string' && tabDomPrefix ? tabDomPrefix : 'metadata'; %>

<ul class="nav nav-tabs entity-tabs align-items-center" role="tablist" aria-label="Metadata-driven record tabs">
      <% for (let tabIndex = 0; tabIndex < tabs.length; tabIndex += 1) { %>
        <% const tab = tabs[tabIndex]; %>
        <li class="nav-item" role="presentation">
          <button
            class="nav-link <%= tab.id === activeTabId ? 'active' : '' %>"
            id="<%= effectiveTabDomPrefix %>-<%= tab.id %>-tab"
            data-bs-toggle="tab"
            data-bs-target="#<%= effectiveTabDomPrefix %>-<%= tab.id %>-pane"
            type="button"
            role="tab"
            aria-controls="<%= effectiveTabDomPrefix %>-<%= tab.id %>-pane"
            aria-selected="<%= tab.id === activeTabId ? 'true' : 'false' %>"
            data-v2-tab-id="<%= tab.id %>"
            <% if (typeof tab.staticVisible === 'boolean') { %>data-v2-tab-static-visible="<%= tab.staticVisible ? 'true' : 'false' %>"<% } %>
            <% if (tab.visibleExpression) { %>
              data-v2-tab-visible-expression="<%= tab.visibleExpression %>"
            <% } %>
            <% if (tab.navigationTrack?.statePath) { %>
              data-navigation-track-path="<%= tab.navigationTrack.statePath %>"
              data-navigation-track-value="<%= tab.id %>"
            <% } %>
          >
            <% if (tab.icon) { %>
              <i class="bi bi-<%= tab.icon %> me-1" aria-hidden="true"></i>
            <% } %>
            <%= tab.label %>
          </button>
        </li>
      <% } %>

      <% if (typeof entryUIViewCatalog !== 'undefined' && Array.isArray(entryUIViewCatalog) && entryUIViewCatalog.length) { %>
        <li
          class="nav-item ms-auto"
          role="presentation"
          data-surface-tools-anchor
          data-surface-tools-kind="entry"
          data-surface-tools-direction="end"
          data-entry-ui-view-key="<%= entryUIViewKey %>"
          data-entry-ui-view-catalog="<%= JSON.stringify(entryUIViewCatalog) %>"
        ></li>
      <% } %>
    </ul>
