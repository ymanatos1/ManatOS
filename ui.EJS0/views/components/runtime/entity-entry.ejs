<%#
  COMPONENT: V2 EntityEntry visual renderer

  Purpose:
  - Renders canonical host-neutral V2 metadata-driven entry content from browser-owned CTX entry state.

  Inputs / metadata:
  - Canonical entity/UI metadata, factual entryRenderValues, reference data, record mode/identity and route form context.

  CTX contract:
  - Initial scalar values are SSR facts only; runtime visibility/editability/tab state is owned by
    the browser-authored ctx.ui.level entry surface.

  Embeds / delegates:
  - Reuses the canonical entity-field dispatcher so field-type presentation is shared rather than reimplemented.

  Runtime contract:
  - This slice establishes V2 visual ownership. Browser-side mutation/event ownership remains an
    explicit acceptance item for the following entry-runtime slice; no new entity-specific decisions
    belong here.
%>
<%
  const isViewMode = recordMode === 'view';
  const isEntryPopupHost = typeof entryPopupHost !== 'undefined' && entryPopupHost;
  const isNew = recordMode === 'create';
  const showEntryActions = typeof entryActionsVisible === 'undefined' || entryActionsVisible !== false;
  const compactEntryDensity = typeof entryDensity !== 'undefined' && entryDensity === 'compact';
  const entrySurfaceClass = [
    'content-card',
    compactEntryDensity ? 'entry-density-compact' : '',
  ]
    .filter(Boolean)
    .join(' ');
  const projectedPresentation = typeof entryPresentation !== 'undefined' && entryPresentation
    ? entryPresentation
    : null;
  const projectedTabs = Array.isArray(projectedPresentation?.tabs) ? projectedPresentation.tabs : [];
  const projectedRegions = Array.isArray(projectedPresentation?.regions) ? projectedPresentation.regions : [];
  const showTabNavigation = projectedTabs.length > 0;
  const v2EntryActions = Object.entries(metadataUI.record.entryActions || {})
    .map(([key, action]) => ({ key, ...action }))
    .sort((left, right) => Number(left?.order || 0) - Number(right?.order || 0));
  const v2SaveAction = {
    ...(metadataUI.record.entryActions?.save || {}),
    label: metadataUI.record.entryActions?.save?.label || 'Save',
    icon: metadataUI.record.entryActions?.save?.icon || 'check-circle',
    tone: metadataUI.record.entryActions?.save?.tone || 'primary',
  };
  const v2DeleteAction = isViewMode
    ? null
    : v2EntryActions.find((action) => action.kind === 'delete') || null;
  const v2CommandActions = isViewMode
    ? []
    : v2EntryActions.filter((action) => action.kind === 'command');
  const v2ActionClass = (action, fallbackTone = 'primary') =>
    `btn btn-${action?.tone || fallbackTone}`;
  const renderValues = typeof entryRenderValues !== 'undefined' && entryRenderValues
    ? entryRenderValues
    : {};
  /*
   * SSR deliberately renders the declarative tab/field inventory without creating
   * an effective V2 view-model. Browser policy owns runtime visibility, editability
   * and requested-tab activation after ctx.ui is constructed.
   */
  const metadataTabsById = new Map((metadataUI.record.tabs || []).map((tab) => [tab.id, tab]));
  /*
   * Materialization order/topology comes from UiPresentationDefinition.  Raw
   * metadata is joined back only for semantic rendering details that the typed
   * projection intentionally does not own yet (representations, expressions,
   * component options, collection semantics, etc.).
   *
   * A physically tabless view has projected regions and therefore one render
   * group but no tab navigation.  The single metadata tab is only its semantic
   * payload; it does not recreate a physical tab in the presentation model.
   */
  const visibleTabs = projectedTabs.length > 0
    ? projectedTabs.map((projectedTab, index) => {
        const tab = metadataTabsById.get(projectedTab.id);
        return {
          id: projectedTab.id,
          label: projectedTab.label || tab?.label || projectedTab.id,
          order: index,
          readOnly: tab?.readOnly === true,
          metadata: tab || { id: projectedTab.id, label: projectedTab.label, order: index, content: [] },
        };
      })
    : projectedRegions.length > 0
      ? (() => {
          const tab = (metadataUI.record.tabs || [])[0];
          return tab
            ? [{ id: tab.id || 'content', label: tab.label || '', order: 0, readOnly: tab.readOnly === true, metadata: tab }]
            : [{ id: 'content', label: '', order: 0, readOnly: false, metadata: { id: 'content', content: metadataUI.record.content || [] } }];
        })()
      : [];
  const debuggingTabEnabled = Boolean(app?.ui?.debugTools);
  const activeTabId = visibleTabs[0]?.id || '';
  const overrides = metadataUI.record.fieldOverrides || {};
  const compiledEntityContextEntry = typeof ctx !== 'undefined' && ctx?.entities
    ? Object.entries(ctx.entities).find(([, candidate]) => candidate?.key === definition.key)
    : null;
  const compiledEntityContextName = compiledEntityContextEntry?.[0] ?? null;
  const compiledEntityContext = compiledEntityContextEntry?.[1] ?? null;
  const compiledEntityMetadata = compiledEntityContext?.metadata || {};
  const references = typeof referenceData !== 'undefined' && referenceData ? referenceData : {};
  const selectorContexts = typeof referenceSelectorContexts !== 'undefined' && referenceSelectorContexts
    ? referenceSelectorContexts
    : {};
  const fieldLabel = (field) => overrides[field.key]?.label || field.label;
  const valueFor = (key) => renderValues[key] ?? null;
  const fieldState = (key) => ({
    value: valueFor(key),
    ux: { required: metadata.fieldDefinition?.[key]?.required === true },
  });
  const fieldVisible = () => true;
  const fieldEditable = () => !isViewMode;
  const expressionText = (value) =>
    value && typeof value === 'object' && typeof value.expression === 'string'
      ? value.expression
      : null;
  const debugElementNameParts = (displayName) => {
    const value = String(displayName ?? '');
    const lastDot = value.lastIndexOf('.');
    return lastDot < 0
      ? { prefix: '', leaf: value }
      : { prefix: value.slice(0, lastDot + 1), leaf: value.slice(lastDot + 1) };
  };

  /*
   * The V2 renderer uses the framework-neutral debugging-model builder so the
   * debugger inventory stays complete (field calculations, related calculations,
   * UI presentation, tabs and actions) instead of maintaining a reduced renderer-
   * specific list that can drift from the metadata actually driving the surface.
   */
  /*
   * Public ctx.ui is browser-owned and therefore intentionally absent from the
   * server render context. SSR may consume bootstrap facts, but it must not
   * reconstruct or inspect a private server UI topology.
   */
  const v2Bootstrap = typeof uiBootstrap !== 'undefined' && uiBootstrap ? uiBootstrap : {};
  const v2BootstrapFacts = v2Bootstrap?.entry?.facts && typeof v2Bootstrap.entry.facts === 'object'
    ? v2Bootstrap.entry.facts
    : {};
  const v2LevelPath = typeof v2Bootstrap?.levelPath === 'string'
    ? v2Bootstrap.levelPath
    : '';
  const tabSurfaceToken = String(entryPopupToken || v2Bootstrap?.levelToken || v2Bootstrap?.token || 'page')
    .replace(/[^A-Za-z0-9_-]+/g, '-');
  const tabDomPrefix = [
    'metadata',
    tabSurfaceToken,
    String(v2LevelPath).replace(/[^A-Za-z0-9_-]+/g, '-'),
    String(definition.key).replace(/[^A-Za-z0-9_-]+/g, '-'),
    String(recordId || 'new').replace(/[^A-Za-z0-9_-]+/g, '-'),
  ].join('-');
  const v2FieldScope = Object.fromEntries(
    Object.entries(metadata.fieldDefinition || {})
      .filter(([, fieldMetadata]) => fieldMetadata?.sensitive !== true)
      .map(([key, fieldMetadata]) => {
      if (fieldMetadata?.type === 'reference') {
        const options = Array.isArray(references[key]) ? references[key] : [];
        return [key, {
          value: valueFor(key),
          option: options.find((item) => item?.id === valueFor(key)) ?? null,
          options,
        }];
      }
      const canonicalEnumItems = enumItemsForField(fieldMetadata);
      const richItems = canonicalEnumItems.length
        ? canonicalEnumItems
        : (Array.isArray(fieldMetadata?.optionItems) ? fieldMetadata.optionItems : []);
      if (fieldMetadata?.type === 'enum' || richItems.length) {
        /*
         * Keep debugger/render-time expression scope identical to the V2 runtime
         * scope. Runtime reference data is authoritative when present because it
         * already contains caller restrictions and server-filtered option sets.
         * Canonical metadata enriches those options, but must never silently put
         * removed options back into scope (or make FirstCtx()/field.option inspect
         * a different option domain than the live entry runtime).
         */
        const runtimeOptions = Array.isArray(references[key]) ? references[key] : [];
        const options = runtimeOptions.length
          ? runtimeOptions.map((item) => {
              const value = item?.value;
              return {
                ...(richItems.find((candidate) => candidate?.value === value) || {}),
                ...item,
                value,
              };
            })
          : (() => {
              const canonicalValues = enumValuesForField(fieldMetadata);
              const optionValues = canonicalValues.length
                ? canonicalValues
                : richItems.map((item) => item?.value);
              return optionValues.map((value) => ({
                ...(richItems.find((item) => item?.value === value) || { value, label: String(value) }),
                value,
              }));
            })();
        return [key, {
          value: valueFor(key),
          option: options.find((item) => item?.value === valueFor(key)) ?? null,
          options,
        }];
      }
      return [key, { value: valueFor(key) }];
    }),
  );
  const v2ExpressionScope = {
    ...v2FieldScope,
    ...v2BootstrapFacts,
    mode: recordMode,
    permissions: typeof permissions !== 'undefined' ? permissions : {},
  };
  /*
   * V2 SSR never evaluates declarative UI expressions. Dynamic values are
   * intentionally left unresolved so the browser-owned canonical AST evaluator
   * is the only runtime interpreter of UI metadata. Static literals remain
   * available to the markup/debug inventory.
   */
  const dynamicUIValue = (candidate) => {
    if (candidate && typeof candidate === 'object' && typeof candidate.expression === 'string') {
      return undefined;
    }
    return candidate;
  };
  const ctxValue = (key) => valueFor(key);
  const ctxFields = v2ExpressionScope;
  const referenceLabel = (fieldKey, value) => {
    if (value === undefined || value === null || value === '') return 'None';
    const match = (references[fieldKey] || []).find(
      (candidate) => String(candidate?.id ?? candidate?.value ?? '') === String(value),
    );
    return projectedReferenceRepresentation(match, value).name;
  };
  const relatedCollections = metadataUI.record.relatedCollections || {};
  const pageCollectionResourceData =
    typeof collectionResourceData !== 'undefined' && collectionResourceData
      ? collectionResourceData
      : {};
  const relatedMetadataRegistry =
    typeof relatedEntityMetadata !== 'undefined' && relatedEntityMetadata ? relatedEntityMetadata : {};
  /*
   * Related rows have already crossed the canonical calculated-record projector
   * before rendering. Presentation consumes that projected row value directly;
   * only an expression explicitly declared by the related collection is a
   * presentation-time value calculation.
   */
  const collectionValue = (row, _collectionKey, _collection, fieldKey, field) =>
    resolveProjectedRelatedCollectionValue(row, fieldKey, field);
  const relatedReferenceRepresentation = (sourceKey, fieldKey, value) => {
    if (value === undefined || value === null || value === '') {
      return { name: '—', icons: [] };
    }
    const candidates = pageCollectionResourceData?.[sourceKey]?.references?.[fieldKey] || [];
    const match = candidates.find(
      (candidate) => String(candidate?.id ?? candidate?.value ?? '') === String(value),
    );
    return projectedReferenceRepresentation(match, value);
  };
  const relatedRowHref = (collection, row) => {
    const presentationEntityKey = collection.relatedEntityKey || collection.entityKey;
    const rowId = row?.id;
    if (rowId === undefined || rowId === null || rowId === '') return null;
    if (collection.rowHref) {
      return String(collection.rowHref).replaceAll('{id}', encodeURIComponent(String(rowId)));
    }
    // A related SysBO row is an entry reference even when its list-view metadata
    // does not redundantly author a route template. Value objects deliberately
    // remain non-routable until they have their own canonical local-entry host.
    return String(presentationEntityKey).startsWith('sys-')
      ? `/bo/${encodeURIComponent(presentationEntityKey)}/${encodeURIComponent(String(rowId))}`
      : null;
  };
  const optionItemForField = metadataOptionItemForField;
  const enumToneClass = metadataOptionToneClass;
  const formatValue = formatMetadataValue;
  const fieldRepresentationFor = metadataFieldRepresentation;
  const { entityDebuggingDisplayRows, uiDebuggingDisplayRows } = buildMetadataDebuggingModel({
    debuggingTabEnabled,
    metadata,
    metadataUI,
    compiledEntityContextName,
    ctxFields,
    ctxValue,
    dynamicUIValue,
    overrides,
    relatedCollections,
    entryContextPath: v2LevelPath,
    entryFieldValuePath: (fieldKey) => `${v2LevelPath}.data.fields.${fieldKey}.value`,
  });
  const enumItemsFor = (field) => {
    const contextual = Array.isArray(references[field.key]) ? references[field.key] : [];
    const canonical = enumItemsForField(field);
    const raw = contextual.length ? contextual : enumValuesForField(field).map((value) => ({ value, label: value }));
    return raw.map((option) => ({
      ...(canonical.find((candidate) => String(candidate?.value ?? '') === String(option?.value ?? option)) || {}),
      ...(typeof option === 'object' ? option : { value: option, label: option }),
    }));
  };
  const dateOnlyValue = (value) => value ? String(value).slice(0, 10) : '';
  const datetimeLocalValue = (value) => value ? String(value).replace('Z', '').slice(0, 16) : '';
  const durationParts = (value) => {
    let source = value;
    if (typeof source === 'string' && source.trim()) source = JSON.parse(source);
    if (!source || typeof source !== 'object' || Array.isArray(source)) return { years: '', months: '', days: '' };
    return { years: source.years ?? '', months: source.months ?? '', days: source.days ?? '' };
  };
  const durationSerializedValue = (value) => {
    const parts = durationParts(value);
    return parts.years === '' && parts.months === '' && parts.days === '' ? '' : JSON.stringify(parts);
  };

  /*
   * Metadata components delegate through one canonical host partial. The entry
   * renderer supplies effective field/value accessors while component selection,
   * bindings and browser mount shape remain shared infrastructure.
   */
  const providerDefinitions =
    typeof externalAuthProviderDefinitions !== 'undefined' && Array.isArray(externalAuthProviderDefinitions)
      ? externalAuthProviderDefinitions
      : [];
  const v2FieldComponentContext = {
    definition,
    item,
    metadata,
    ctxValue,
    referenceLabel,
    overrides,
    expressionText,
    compiledEntityMetadata,
    dynamicUIValue,
    ctxFields,
    referenceValues: references,
    projectedReferenceRepresentation,
    referenceSelectorContexts: selectorContexts,
    fieldVisible,
    fieldEditable,
    valueFor,
    fieldLabel,
    isViewMode,
    enumItemsFor,
    dateOnlyValue,
    datetimeLocalValue,
    durationParts,
    durationSerializedValue,
    formatValue,
  };
  const metadataComponentContext = {
    item,
    metadata,
    entryRenderValues: renderValues,
    referenceData: references,
    fieldLabel,
    isNew,
    isViewMode,
    ctxValue,
    externalAuthProviderDefinitions: providerDefinitions,
    componentData: {
      providerDefinitions,
      collectionResourceData: pageCollectionResourceData,
    },
    relatedMetadataRegistry,
    credentialTest: typeof credentialTest !== 'undefined' ? credentialTest : null,
    suggestedProvider: typeof suggestedProvider !== 'undefined' ? suggestedProvider : null,
    fieldComponentContext: v2FieldComponentContext,
  };
  const componentBindingContractFor = (component) => {
    const bindings = {};
    const bindingExpressions = {};
    for (const [bindingKey, bindingValue] of Object.entries(component?.bindings || {})) {
      if (
        bindingValue
        && typeof bindingValue === 'object'
        && typeof bindingValue.expression === 'string'
      ) {
        bindingExpressions[bindingKey] = bindingValue.expression;
        continue;
      }
      bindings[bindingKey] = bindingValue;
    }
    return { bindings, bindingExpressions };
  };
  const componentOptionsFor = (component) => ({
    ...(component?.options || {}),
    entityIcon: component?.options?.entityIcon || String(definition.icon || '').replace(/^bi-/, ''),
    ...(component?.key === 'hierarchy-tree' && typeof entryRepresentationRuntime !== 'undefined'
      ? { entryRepresentation: entryRepresentationRuntime }
      : {}),
  });
  const detailsColumnSpansFor = (columns) => {
    const explicit = columns.map((column) => {
      const resolved = dynamicUIValue(column.span ?? null, ctxFields, {
        source: 'ui-metadata',
        sourcePath: 'tabs.details.content.column.span',
        targetPath: 'tabs.details.content.column.span',
        purpose: 'resolve details column span',
      });
      const numeric = Number(resolved);
      return Number.isFinite(numeric) && numeric > 0
        ? Math.max(1, Math.min(12, Math.trunc(numeric)))
        : null;
    });
    const compact = columns.map((column, index) => {
      if (explicit[index] !== null) return false;
      const meaningful = (column.content || []).filter((item) => item.kind !== 'spacer' && item.kind !== 'break');
      return meaningful.length > 0 && meaningful.every(
        (item) => item.kind === 'field' && item.representation === 'portrait',
      );
    });
    const reserved = explicit.reduce((sum, span) => sum + (span || 0), 0)
      + compact.reduce((sum, isCompact) => sum + (isCompact ? 3 : 0), 0);
    const flexibleCount = columns.filter((_, index) => explicit[index] === null && !compact[index]).length;
    let remaining = Math.max(flexibleCount, 12 - reserved);
    let flexibleRemaining = flexibleCount;
    return columns.map((_, index) => {
      if (explicit[index] !== null) return explicit[index];
      if (compact[index]) return 3;
      const span = flexibleRemaining > 0
        ? Math.max(1, Math.floor(remaining / flexibleRemaining))
        : 1;
      remaining -= span;
      flexibleRemaining -= 1;
      return span;
    });
  };
  const contentSpanContractFor = (content, fallback) => {
    const staticSpan = Number(content?.span);
    return {
      fallback,
      span: Number.isFinite(staticSpan)
        ? Math.max(1, Math.min(12, Math.trunc(staticSpan)))
        : fallback,
      expression: expressionText(content?.span),
    };
  };
%>
<section class="<%= entrySurfaceClass %>" data-ui-engine="v2" data-v2-entity-entry>
  <form
    class="metadata-driven-record-form manatos-entry-initializing"
    method="post"
    autocomplete="off"
    action="/bo/<%= definition.key %>/<%= ownerEditing ? 'owned/save' : 'save' %>"
    data-record-mode="<%= recordMode %>"
    data-form-i18n="<%= JSON.stringify({
      newReady: metadataText('@CM.NewEntryReady'),
      newIncomplete: metadataText('@CM.NewEntryIncomplete'),
      noChanges: metadataText('@CM.NoChanges'),
      unsaved: metadataText('@CM.UnsavedChanges'),
      unsavedIncomplete: metadataText('@CM.UnsavedChangesIncomplete'),
      editingRelated: metadataText('@CM.EditingRelatedEntry'),
      editingRelatedMany: metadataText('@CM.EditingRelatedEntries'),
      reviewUnsaved: metadataText('@CM.ReviewUnsavedChanges'),
      noUnsaved: metadataText('@CM.NoUnsavedChanges'),
      currentUnsaved: metadataText('@CM.CurrentUnsavedEntryChanges'),
      cancel: metadataText('@CM.Cancel'),
      close: metadataText('@CM.Close'),
      cancelEditing: metadataText('@CM.CancelEditing'),
      closeEntry: metadataText('@CM.CloseEntry'),
      entryInit: metadataText('@CM.EntryInitialization'),
      finishRelated: metadataText('@CM.FinishRelatedEditor'),
      noChangesToSave: metadataText('@CM.NoChangesToSave'),
      completeRequired: metadataText('@CM.CompleteRequiredFields')
    }) %>"
    data-entity-key="<%= definition.key %>"
    data-ui-view-key="<%= typeof entryUIViewKey === 'string' ? entryUIViewKey : '' %>"
    data-ui-view-type="<%= typeof entryUIViewType === 'string' ? entryUIViewType : '' %>"
    data-v2-entry-form
    data-owner-editing="<%= ownerEditing ? 'true' : 'false' %>"
    aria-busy="true"
    data-initialization-visibility="pending"
    data-ctx-scope-path="<%= v2LevelPath %>"
    data-ui-engine="v2"
    <% if (!isViewMode) { %>data-dirty-guard="true"<% } %>
  >
    <div class="manatos-entry-opening-status" role="status" aria-live="polite" aria-atomic="true">
      <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
      <span>Opening page…</span>
    </div>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (typeof entryUIViewKey === 'string' && entryUIViewKey) { %>
      <input type="hidden" name="_entryUIView" value="<%= entryUIViewKey %>">
    <% } %>
    <script type="application/json" data-entry-ui-view-metadata>
      <%- JSON.stringify(
        typeof entryUIViewMetadata !== 'undefined' ? entryUIViewMetadata : metadataUI,
      ).replace(/</g, '\\u003c') %>
    </script>
    <% if (typeof entryPopupHost !== 'undefined' && entryPopupHost) { %>
      <%#
        Hosted entries carry the canonical popup invocation token. The shared
        popup runtime uses it to convert data-form-close-cancel into a parent-
        window popup lifecycle close rather than iframe navigation.
      %>
      <input type="hidden" name="_entryHost" value="popup">
      <input type="hidden" name="_entryToken" value="<%= entryPopupToken || '' %>">
      <% if (compactEntryDensity) { %><input type="hidden" name="_entryDensity" value="compact"><% } %>
      <% if (typeof entryRecoverable !== 'undefined' && entryRecoverable === false) { %><input type="hidden" name="_entryRecoverable" value="0"><% } %>
      <input type="hidden" name="_entryDefaults" value="<%= JSON.stringify(entryInvocationDefaults || {}) %>">
      <input type="hidden" name="_entryOverrides" value="<%= JSON.stringify(entryInvocationOverrides || {}) %>">
    <% } %>
    <% if ((ownerEditing || !isNew) && recordId) { %><input type="hidden" name="id" value="<%= recordId %>"><% } %>
    <% if (ownerEditing && ownerContext) { %>
      <%# Document-boundary continuation only. Live Entry/Owner communication uses the runtime owner provider. %>
      <input type="hidden" name="_ownerEntries" value="<%= JSON.stringify(ownerContext.entries || []) %>">
      <input type="hidden" name="_ownerEntriesOriginal" value="<%= JSON.stringify(ownerContext.entriesOriginal || []) %>">
      <input type="hidden" name="_ownerFields" value="<%= JSON.stringify(ownerContext.fields || {}) %>">
      <input type="hidden" name="_ownerName" value="<%= ownerContext.name || 'organization' %>">
      <input type="hidden" name="_ownerKind" value="<%= ownerContext.kind || 'sysbo-hierarchy' %>">
      <input type="hidden" name="_ownerIdentityField" value="<%= ownerContext.identityField || 'id' %>">
      <input type="hidden" name="_ownerWorkspaceTransaction" value="<%= JSON.stringify(ownerContext.workspaceTransaction || { version: 1, mutations: [] }) %>">
      <input type="hidden" name="_ownerRecycleBin" value="<%= JSON.stringify(ownerContext.recycleBin || []) %>">
      <input type="hidden" name="_ownerRuntimeResources" value="<%= JSON.stringify(ownerContext.runtimeResources || {}) %>">
      <% if (ownerContext.recoveryUrl) { %><input type="hidden" name="_ownerRecoveryUrl" value="<%= ownerContext.recoveryUrl %>"><% } %>
      <input type="hidden" name="_ownerMode" value="<%= ownerContext.mode || 'edit' %>">
      <input type="hidden" name="_ownerCollectionsOriginal" value="<%= JSON.stringify(ownerCollectionBaselines || {}) %>">
      <input type="hidden" name="_ownerFocusedMemberId" value="<%= recordId || '' %>">
      <input type="hidden" name="_ownerEntryMode" value="<%= recordMode %>">
    <% } %>

    <% if (!showTabNavigation) { %>
      <div class="d-none" data-entry-view-tools-caption-source>
        <%- include('../sysbo/entry/shell/entry-tabs-nav', {
          tabs: [], activeTabId, tabDomPrefix, entryUIViewCatalog, entryUIViewKey,
        }) %>
      </div>
    <% } %>

    <% if (showTabNavigation) { %>
    <div>
    <%- include('../sysbo/entry/shell/entry-tabs-nav', {
      tabs: visibleTabs.map((tab) => ({
        ...tab.metadata,
        id: tab.id,
        label: tab.label,
        order: tab.order,
        visibleExpression: expressionText(tab.metadata?.visible),
        staticVisible: typeof tab.metadata?.visible === 'boolean' ? tab.metadata.visible : null,
      })),
      activeTabId,
      tabDomPrefix,
      entryUIViewCatalog,
      entryUIViewKey,
    }) %>
    </div>
    <% } %>

    <% if (debuggingTabEnabled && showTabNavigation) { %>
      <%#
        Developer tooling is capability-gated by the UI server, but runtime tab
        composition is browser-owned. The server supplies an inert template only;
        entry-policy-runtime.js decides whether/where it participates in ctx.ui
        navigation and inserts it into the live tab set.
      %>
      <template data-v2-developer-debugging-tab-template>
        <li class="nav-item" role="presentation" data-v2-developer-debugging-nav>
          <button
            class="nav-link"
            id="<%= tabDomPrefix %>-debugging-tab"
            data-bs-toggle="tab"
            data-bs-target="#<%= tabDomPrefix %>-debugging-pane"
            type="button"
            role="tab"
            aria-controls="<%= tabDomPrefix %>-debugging-pane"
            aria-selected="false"
            data-v2-tab-id="debugging"
            data-v2-tab-static-visible="true"
            data-navigation-track-path="activeTabId"
            data-navigation-track-value="debugging"
          data-debugging-host-tab
          ><i class="bi bi-bug me-1" aria-hidden="true"></i>Debugging<span class="badge rounded-pill text-bg-danger ms-1 d-none" data-debugging-host-errors-count></span></button>
        </li>
        <div
          class="tab-pane fade entity-readonly-tab"
          data-v2-developer-debugging-pane
          data-readonly-tab="true"
          id="<%= tabDomPrefix %>-debugging-pane"
          role="tabpanel"
          tabindex="0"
        >
          <%- include('../debugging/debugging-panel', {
            entityDebuggingDisplayRows, uiDebuggingDisplayRows,
            debugElementNameParts,
            debuggingActiveScopeId,
            debuggingEntityKey: definition.key, debuggingCsrfToken: csrfToken,
            debuggingStartPath: `${v2LevelPath}.data.entry.current`,
            debuggingStartDisplayPath: '#data.entry.current',
            debuggingComponent: null
          }) %>
        </div>
      </template>
    <% } %>

    <div class="tab-content entity-tab-content">
      <% for (const tabState of visibleTabs) { const tab = tabState.metadata; %>
        <%
          const tabContents = Array.isArray(tab.content) ? tab.content : [];
          const flattenedTabContents = (contents) => contents.flatMap((content) =>
            content?.kind === 'column' || content?.kind === 'inline'
              ? flattenedTabContents(content.content || [])
              : [content]);
          const effectiveTabContents = flattenedTabContents(tabContents);
          const tabHasEditableFields = effectiveTabContents.some((content) => {
            if (content?.kind !== 'field') return false;
            const key = content.field;
            if (metadataUI.record.relatedCollections?.[key]) return false;
            const field = metadata.fieldDefinition[key];
            return Boolean(field && !field.sensitive && fieldVisible(field) && fieldEditable(field));
          });
          const tabHasInteractiveComponents = effectiveTabContents.some(
            (content) => content?.kind === 'component' && content.component?.readOnly === false,
          );
          const tabComponentInteractive =
            tab.layout === 'component' && tab.component?.readOnly === false;
          const readOnlyTab = tab.layout === 'summary'
            || (!tabHasEditableFields && !tabHasInteractiveComponents && !tabComponentInteractive);
        %>
        <div
          class="tab-pane fade <%= tabState.id === activeTabId ? 'show active' : '' %> <%= readOnlyTab ? 'entity-readonly-tab' : '' %>"
          <%= readOnlyTab ? 'data-readonly-tab="true"' : '' %>
          id="<%= tabDomPrefix %>-<%= tabState.id %>-pane"
          role="tabpanel"
          tabindex="0"
        >
          <% if (tab.layout === 'component' && tab.component) { %>
            <%
              const component = tab.component;
              const { bindings: componentBindings, bindingExpressions: componentBindingExpressions } = componentBindingContractFor(component);
              const componentOptions = componentOptionsFor(component);
              const componentPartial = typeof metadataComponentPartialFor === 'function'
                ? metadataComponentPartialFor(String(component.key || ''))
                : null;
            %>
            <div class="row g-3">
              <%- include('../sysbo/entry/shell/metadata-component', {
                component,
                componentBindings,
                componentBindingExpressions,
                componentOptions,
                componentPartial,
                metadataComponentContext,
                definition,
                recordMode,
                readOnly: isViewMode || component.readOnly === true,
                ctxScopePath: v2LevelPath,
                span: 12,
                spanExpression: null,
                layoutComponentInstance: String(component.key),
              }) %>
            </div>
          <% } else if (tab.layout === 'details') { %>
            <%
              const detailColumns = (tab.content || []).filter((content) => content.kind === 'column');
              const detailColumnSpans = detailsColumnSpansFor(detailColumns);
            %>
            <div class="row g-3" data-v2-entry-fields data-metadata-details-layout>
              <% for (let columnIndex = 0; columnIndex < detailColumns.length; columnIndex += 1) { %>
                <% const column = detailColumns[columnIndex]; %>
                <div class="col-md-<%= detailColumnSpans[columnIndex] %>" data-metadata-details-column data-v2-layout-column="<%= `${tab.id}:column${columnIndex}` %>">
                  <div class="row g-3">
                    <% for (const content of column.content || []) { %>
                      <% if (content.kind === 'break') { %><div class="w-100" aria-hidden="true"></div><% continue; } %>
                      <% if (content.kind === 'spacer') { %><div class="col-12 metadata-details-spacer" data-metadata-layout-spacer aria-hidden="true"></div><% continue; } %>
                      <% if (content.kind === 'inline') { %>
                        <div class="col-12 d-flex align-items-center gap-2 flex-wrap" data-metadata-inline>
                          <% for (const inlineContent of content.content || []) { %>
                            <% if (inlineContent.kind === 'field') { %>
                              <% const inlineKey = inlineContent.field; %>
                              <% const inlineField = metadata.fieldDefinition[inlineKey]; %>
                              <% if (!inlineField || inlineField.sensitive || !fieldVisible(inlineField)) continue; %>
                              <div class="metadata-inline-field">
                                <% const inlineRepresentation = fieldRepresentationFor(
                                  inlineContent.representation || tab.representation || 'default', inlineField.type
                                ); %>
                                <%- include('../sysbo/entry/fields/field-representation', {
                                  representation: inlineRepresentation, key: inlineKey, field: inlineField,
                                  value: valueFor(inlineKey), item, definition, fieldLabel,
                                  fieldOverride: overrides[inlineKey] || {}, referenceLabel, formatValue,
                                  referenceValues: references, entryRepresentationFor,
                                  displayLabel: inlineContent.label,
                                  relatedFieldKeys: inlineContent.relatedFields || [],
                                  relatedValues: (inlineContent.relatedFields || []).map((relatedKey) => valueFor(relatedKey))
                                }) %>
                              </div>
                            <% } else if (inlineContent.kind === 'action') { %>
                              <% const inlineAction = metadataUI.record.entryActions?.[inlineContent.action]; %>
                              <% if (inlineAction?.kind === 'navigate' && inlineAction.href) { %>
                                <a
                                  class="btn btn-<%= inlineAction.emphasis === 'outline' ? 'outline-' : '' %><%= inlineAction.tone || 'primary' %> btn-sm"
                                  href="<%= inlineAction.href %>"
                                  data-v2-entry-action="<%= inlineContent.action %>"
                                  hidden
                                ><% if (inlineAction.icon) { %><i class="bi bi-<%= inlineAction.icon %> me-1"></i><% } %><%= metadataText(inlineAction.label) %></a>
                              <% } %>
                            <% } %>
                          <% } %>
                        </div>
                        <% continue; %>
                      <% } %>
                      <% if (content.kind === 'collection') { %>
                        <div class="col-12">
                          <%- include('../sysbo/entry/content/related-collections', {
                            tab: { content: [{ kind: 'collection', collection: content.collection }] }, relatedCollections, pageCollectionResourceData,
                            relatedMetadataRegistry, collectionValue, relatedRowHref, relatedReferenceRepresentation,
                            optionItemForField, enumToneClass, formatValue
                          }) %>
                        </div>
                        <% continue; %>
                      <% } %>
                      <% if (content.kind !== 'field') continue; %>
                      <% const key = content.field; %>
                      <% const field = metadata.fieldDefinition[key]; %>
                      <% if (!field || field.sensitive || !fieldVisible(field)) continue; %>
                      <% const editable = fieldEditable(field); %>
                      <div
                        class="col-12 <%= editable ? 'effective-field-editable' : 'effective-field-readonly' %>"
                        data-v2-field-container="<%= key %>"
                        data-ctx-field-container="<%= key %>"
                      >
                        <% const representation = fieldRepresentationFor(
                          content.representation || tab.representation || 'default', field.type
                        ); %>
                        <% if (representation !== 'default') { %>
                          <%- include('../sysbo/entry/fields/field-representation', {
                            representation, key, field, value: valueFor(key), item, definition, fieldLabel,
                            fieldOverride: overrides[key] || {}, referenceLabel, formatValue,
                            referenceValues: references, entryRepresentationFor,
                            displayLabel: content.label,
                            relatedFieldKeys: content.relatedFields || [],
                            relatedValues: (content.relatedFields || []).map((relatedKey) => valueFor(relatedKey))
                          }) %>
                        <% } else { %>
                          <label class="form-label" for="metadata-field-<%= key %>"><%= metadataText(fieldLabel(field)) %>:</label>
                          <%- include('../sysbo/entry/fields/entity-field', {
                            key, field, value: valueFor(key), editable, fieldLabel, enumItemsFor,
                            referenceValues: references, referenceSelectorContexts: selectorContexts,
                            dateOnlyValue, datetimeLocalValue,
                            durationParts, durationSerializedValue, definition, fieldOverride: overrides[key] || null
                          }) %>
                        <% } %>
                      </div>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </div>
          <% } else if (tab.layout === 'summary') { %>
            <%- include('../sysbo/entry/content/summary', {
              tab,
              relatedCollections,
              metadata,
              fieldVisible,
              overrides,
              valueFor,
              ctxFields,
              fieldLabel,
              fieldEditable,
              referenceValues: references,
              formatValue,
              referenceLabel,
              pageCollectionResourceData,
              relatedMetadataRegistry,
              collectionValue,
              relatedRowHref,
              relatedReferenceRepresentation,
              optionItemForField,
              enumToneClass,
              enhancedReadonlyPresentation: true
            }) %>
          <% } else { %>
            <div class="row g-3" data-v2-entry-fields>
              <% const contents = Array.isArray(tab.content) ? tab.content : []; %>
              <% for (const content of contents) { %>
                <% if (content.kind === 'break') { %><div class="w-100" aria-hidden="true"></div><% continue; } %>
                <% if (content.kind === 'spacer') { const spanContract = contentSpanContractFor(content, 12); %>
                  <div
                    class="col-md-<%= spanContract.span %>"
                    data-metadata-layout-spacer
                    <% if (spanContract.expression) { %>
                      data-ui-grid-span-expression="<%= spanContract.expression %>"
                      data-ui-grid-span-fallback="<%= spanContract.fallback %>"
                    <% } %>
                    aria-hidden="true"
                  ></div>
                  <% continue; %>
                <% } %>
                <% if (content.kind === 'component' && content.component?.key) { %>
                  <%
                    const component = content.component;
                    const spanContract = contentSpanContractFor(content, 12);
                    const { bindings: componentBindings, bindingExpressions: componentBindingExpressions } = componentBindingContractFor(component);
                    const componentOptions = componentOptionsFor(component);
                    const componentPartial = typeof metadataComponentPartialFor === 'function'
                      ? metadataComponentPartialFor(String(component.key))
                      : null;
                  %>
                  <%- include('../sysbo/entry/shell/metadata-component', {
                    component,
                    componentBindings,
                    componentBindingExpressions,
                    componentOptions,
                    componentPartial,
                    metadataComponentContext,
                    definition,
                    recordMode,
                    readOnly: isViewMode || component.readOnly === true,
                    ctxScopePath: v2LevelPath,
                    span: spanContract.span,
                    spanExpression: spanContract.expression,
                    layoutComponentInstance: (() => {
                      const sameBefore = contents.slice(0, contents.indexOf(content)).filter((candidate) =>
                        candidate?.kind === 'component' && candidate.component?.key === component.key
                      ).length;
                      return sameBefore === 0 ? String(component.key) : String(component.key) + '_' + (sameBefore + 1);
                    })(),
                  }) %>
                  <% continue; %>
                <% } %>
                <% if (content.kind !== 'field') continue; %>
                <% const key = content.field; %>
                <% const spanContract = contentSpanContractFor(content, 6); %>
                <% const field = metadata.fieldDefinition[key]; %>
                <% if (!field || field.sensitive || !fieldVisible(field)) continue; %>
                <% const editable = fieldEditable(field); %>
                <div class="col-md-<%= spanContract.span %> <%= editable ? 'effective-field-editable' : 'effective-field-readonly' %>"
                  data-v2-field-container="<%= key %>" data-ctx-field-container="<%= key %>"
                  <% if (spanContract.expression) { %>
                    data-ui-grid-span-expression="<%= spanContract.expression %>"
                    data-ui-grid-span-fallback="<%= spanContract.fallback %>"
                  <% } %>
                  <% const visibleExpression = expressionText(overrides[key]?.visible); %>
                  <% if (visibleExpression) { %>data-ui-visible-expression="<%= visibleExpression %>"<% } %>
                  <% const editableExpression = expressionText(overrides[key]?.editable); %>
                  <% if (editableExpression) { %>
                    data-ui-editable-expression="<%= editableExpression %>"
                    data-ui-has-readonly-value="<%= Object.prototype.hasOwnProperty.call(overrides[key] || {}, 'readOnlyValue') ? 'true' : 'false' %>"
                    data-ui-readonly-value="<%= JSON.stringify(overrides[key]?.readOnlyValue ?? null) %>"
                  <% } %>
                  <% if (field.calculation?.expression) { %>
                    data-field-calculation-expression="<%= field.calculation.expression %>"
                    data-field-calculation-persisted="<%= field.calculation.persisted === true ? 'true' : 'false' %>"
                  <% } %>>
                  <% const representation = fieldRepresentationFor(
                    content.representation || tab.representation || 'default', field.type
                  ); %>
                  <% if (representation !== 'default') { %>
                    <%- include('../sysbo/entry/fields/field-representation', {
                      representation,
                      key,
                      field,
                      value: valueFor(key),
                      item,
                      definition,
                      fieldLabel,
                      fieldOverride: overrides[key] || {},
                      referenceLabel,
                      formatValue,
                      referenceValues: references,
                      entryRepresentationFor,
                      displayLabel: content.label,
                      relatedFieldKeys: content.relatedFields || [],
                      relatedValues: (content.relatedFields || []).map((relatedKey) => valueFor(relatedKey))
                    }) %>
                  <% } else { %>
                    <label class="form-label" for="metadata-field-<%= key %>">
                      <%= metadataText(fieldLabel(field)) %>:<% if (fieldState(key)?.ux?.required) { %><span
                        aria-label="required"> (*)</span><% } %>
                    </label>
                    <%- include('../sysbo/entry/fields/entity-field', {
                      key, field, value: valueFor(key), editable, fieldLabel, enumItemsFor,
                      referenceValues: references, referenceSelectorContexts: selectorContexts,
                      dateOnlyValue, datetimeLocalValue, durationParts, durationSerializedValue,
                      definition, fieldOverride: overrides[key] || null
                    }) %>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <% if (showEntryActions) { %>
    <div class="d-flex justify-content-between align-items-center mt-4 gap-3 flex-wrap" data-v2-entry-actions data-v2-layout-actions="surface">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% for (const action of v2CommandActions.filter((candidate) => candidate.placement === 'footer-leading')) { %>
          <% if (!isNew && recordId && action.command) { %>
            <button
              class="<%= v2ActionClass(action, 'primary') %>"
              type="submit"
              form="metadata-command-<%= action.key %>"
              data-v2-entry-action="<%= action.key %>"
              hidden
            ><% if (action.icon) { %><i class="bi bi-<%= action.icon %> me-1"></i><% } %><%= metadataText(action.label) %></button>
          <% } %>
        <% } %>
        <% if (!isNew && v2DeleteAction?.placement === 'footer-leading') { %>
          <button
            class="<%= v2ActionClass(v2DeleteAction, 'danger') %>"
            type="button"
            data-v2-entry-action="<%= v2DeleteAction.key %>"
            data-bs-toggle="modal"
            data-bs-target="#deleteEntryModal"
            hidden
          ><i class="bi bi-<%= v2DeleteAction.icon || 'trash' %> me-1"></i><%= metadataText(v2DeleteAction.label) %></button>
        <% } %>
      </div>
      <div class="d-flex gap-2 align-items-center">
        <% if (!isViewMode) { %>
          <button
            type="button"
            class="btn btn-link btn-sm p-0 form-state-indicator small text-secondary me-1 text-decoration-none"
            data-form-state-indicator
            data-v2-layout-status="form-state"
            disabled
            title="<%= metadataText('@CM.NoUnsavedChanges') %>"
          >
            <i class="bi bi-check-circle me-1" data-form-state-icon></i>
            <span data-form-state-text><%= metadataText(isNew ? '@CM.NewEntryIncomplete' : '@CM.NoChanges') %></span>
          </button>
        <% } %>
        <% if (isEntryPopupHost) { %>
          <button
            class="btn btn-secondary<%= compactEntryDensity ? ' btn-sm' : '' %>"
            type="button"
            data-form-close-cancel
            data-cancel-operation
            data-v2-layout-action="close"
          >
            <i class="bi bi-x-circle me-1"></i>
            <span data-form-close-cancel-label><%= metadataText(compactEntryDensity ? '@CM.Cancel' : '@CM.Close') %></span>
          </button>
        <% } else if (ownerEditing) { %>
          <button
            class="btn btn-secondary"
            type="submit"
            formaction="/bo/<%= definition.key %>/owned/return"
            formmethod="post"
            data-form-close-cancel
            data-cancel-operation
            data-v2-layout-action="close"
          >
            <i class="bi bi-x-circle me-1"></i>
            <span data-form-close-cancel-label><%= metadataText('@CM.Close') %></span>
          </button>
        <% } else { %>
          <a
            class="btn btn-secondary dirty-navigation"
            href="/bo/<%= definition.key %>"
            <%= isViewMode ? '' : 'data-form-close-cancel data-cancel-operation' %>
            data-v2-layout-action="close"
          >
            <i class="bi bi-x-circle me-1"></i>
            <span data-form-close-cancel-label><%= metadataText(isViewMode ? '@CM.Back' : '@CM.Close') %></span>
          </a>
        <% } %>
        <% for (const action of v2CommandActions.filter((candidate) => candidate.placement === 'footer-trailing')) { %>
          <% if (!isNew && recordId && action.command) { %>
            <button
              class="<%= v2ActionClass(action, 'primary') %>"
              type="submit"
              form="metadata-command-<%= action.key %>"
              data-v2-entry-action="<%= action.key %>"
              hidden
            ><% if (action.icon) { %><i class="bi bi-<%= action.icon %> me-1"></i><% } %><%= metadataText(action.label) %></button>
          <% } %>
        <% } %>
        <% if (!isNew && v2DeleteAction?.placement === 'footer-trailing') { %>
          <button
            class="<%= v2ActionClass(v2DeleteAction, 'danger') %>"
            type="button"
            data-v2-entry-action="<%= v2DeleteAction.key %>"
            data-bs-toggle="modal"
            data-bs-target="#deleteEntryModal"
            hidden
          ><i class="bi bi-<%= v2DeleteAction.icon || 'trash' %> me-1"></i><%= metadataText(v2DeleteAction.label) %></button>
        <% } %>
        <% if (!isViewMode) { %>
          <span data-v2-entry-action="save" data-v2-layout-action="save" hidden>
            <% if (isEntryPopupHost && compactEntryDensity) { %>
              <button
                class="<%= v2ActionClass(v2SaveAction, 'primary') %> btn-sm"
                type="submit"
                name="_saveMode"
                value="close"
                data-form-save
                disabled
              ><i class="bi bi-check-circle me-1"></i><%= isNew ? 'Create' : 'Save' %></button>
            <% } else { %>
              <%- include('../sysbo/entry/shell/save-split-action', {
                saveAction: v2SaveAction,
                actionClass: v2ActionClass,
              }) %>
            <% } %>
          </span>
        <% } %>
      </div>
    </div>
    <% } %>
  </form>
</section>

<% for (const action of v2CommandActions) { %>
  <% if (!isNew && recordId && action.command) { %>
    <form
      id="metadata-command-<%= action.key %>"
      method="post"
      action="/bo/<%= definition.key %>/<%= recordId %>/<%= action.command %>"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>
  <% } %>
<% } %>

<%- include('../../popups/messages/bo-edit-confirmations', {
  isNew, permissions, deleteEnabled: true, definition, item: renderValues,
  csrfToken, deletePresentation, deleteImpact
}) %>
