<%#
  COMPONENT: Information panel

  Purpose:
  - Renders generic structured informational content with tone, icon, sections and optional collapse behavior.

  Inputs / metadata:
  - panel is an already-resolved presentation object containing title/text/sections/steps/tone/collapse options.

  CTX contract:
  - None; callers may derive panel data from CTX but this component is presentation-only.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Optional collapse controls use local data-information-panel* hooks.
%>

<%#
  Generic metadata-driven information panel.

  This renderer owns only information presentation: tone, icon, title, text,
  sections and optional collapse/expand behavior. It deliberately knows nothing
  about the owning entity or workflow. Callers supply already-resolved panel
  content from metadata/CTX/application state.
%>
<%
  const info = typeof panel !== 'undefined' && panel ? panel : {};
  const infoTone = String(info.tone || 'light');
  const infoIcon = info.icon ? String(info.icon) : '';
  const infoTitle = info.title ? String(info.title) : '';
  const infoText = info.text ? String(info.text) : '';
  const infoIntroduction = info.introduction ? String(info.introduction) : '';
  const infoSteps = Array.isArray(info.steps) ? info.steps : [];
  const infoSections = Array.isArray(info.sections) ? info.sections : [];
  const infoConfiguredRule = info.configuredRule ? String(info.configuredRule) : '';
  const infoWarning = info.warning ? String(info.warning) : '';
  const infoCollapsible = info.collapsible === true;
  const infoInitiallyCollapsed = infoCollapsible && info.initiallyCollapsed === true;
  const requestedId = String(info.id || `information-panel-${Math.random().toString(36).slice(2)}`);
  const infoId = requestedId.replace(/[^A-Za-z0-9_-]/g, '-');
  const bodyId = `${infoId}-body`;
  const alertClass = infoTone === 'light' || infoTone === 'neutral'
    ? 'alert-light'
    : `alert-${infoTone}`;
%>
<div
  class="alert <%= alertClass %> border small mb-0 metadata-information-panel"
  data-information-panel
  data-information-panel-tone="<%= infoTone %>"
  <% if (infoCollapsible) { %>data-information-panel-collapsible="true"<% } %>
>
  <% if (infoCollapsible) { %>
    <button
      class="metadata-information-panel-toggle"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#<%= bodyId %>"
      aria-controls="<%= bodyId %>"
      aria-expanded="<%= infoInitiallyCollapsed ? 'false' : 'true' %>"
    >
      <span class="d-inline-flex align-items-center gap-2">
        <!-- Generic affordance: collapsible panels advertise expand/collapse beside the title. -->
        <i class="bi bi-chevron-right metadata-information-panel-chevron" aria-hidden="true"></i>
        <% if (infoIcon) { %><i class="bi bi-<%= infoIcon %>" aria-hidden="true"></i><% } %>
        <% if (infoTitle) { %><strong><%= infoTitle %></strong><% } %>
      </span>
    </button>
  <% } else if (infoTitle || infoIcon) { %>
    <div class="metadata-information-panel-heading d-flex align-items-center gap-2">
      <% if (infoIcon) { %><i class="bi bi-<%= infoIcon %>" aria-hidden="true"></i><% } %>
      <% if (infoTitle) { %><strong><%= infoTitle %></strong><% } %>
    </div>
  <% } %>

  <div
    id="<%= bodyId %>"
    class="<%= infoCollapsible ? `collapse${infoInitiallyCollapsed ? '' : ' show'}` : '' %>"
    data-information-panel-body
  >
    <% if (infoText) { %><div class="<%= infoTitle || infoIcon ? 'mt-1' : '' %>"><%= infoText %></div><% } %>
    <% if (infoIntroduction) { %><p class="mb-2 <%= infoTitle || infoIcon ? 'mt-2' : '' %>"><%= infoIntroduction %></p><% } %>

    <% if (infoSteps.length) { %>
      <ul class="mb-0 <%= infoTitle || infoIcon || infoIntroduction ? 'mt-2' : '' %>">
        <% for (const step of infoSteps) { %><li><%= step %></li><% } %>
      </ul>
    <% } %>

    <% for (const section of infoSections) { %>
      <div class="metadata-information-panel-section <%= infoTitle || infoIntroduction || infoText || infoSteps.length ? 'mt-2' : '' %>">
        <% if (section?.title) { %><div class="fw-semibold"><%= section.title %></div><% } %>
        <% if (section?.text) { %><div class="mt-1"><%= section.text %></div><% } %>
        <% if (Array.isArray(section?.steps) && section.steps.length) { %>
          <ul class="mb-0 <%= section?.title || section?.text ? 'mt-1' : '' %>">
            <% for (const step of section.steps) { %><li><%= step %></li><% } %>
          </ul>
        <% } %>
      </div>
    <% } %>

    <% if (infoConfiguredRule) { %><div class="mt-2"><%= infoConfiguredRule %></div><% } %>
    <% if (infoWarning) { %><div class="mt-2"><strong>Important:</strong> <%= infoWarning %></div><% } %>
  </div>
</div>
