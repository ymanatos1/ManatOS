<%#
  COMPONENT: Authentication summary

  Purpose:
  - Renders the canonical authentication/external-identity summary for an account or SysUser projection.

  Inputs / metadata:
  - Canonical SysUser metadata, related-collection metadata, current values, auth provider presentation helpers.

  CTX contract:
  - Reads already-resolved account/SysUser values; it does not mutate CTX.

  Embeds / delegates:
  - entry-icons.ejs for canonical entity/provider icon presentation.

  Runtime contract:
  - Pure server-rendered presentation; links/actions are owned by their surrounding page.
%>

<%
  const externalIdentityCollection = relatedCollectionMetadataFor('sys-users', 'externalIdentities');
  const externalIdentityMetadata = externalIdentityCollection
    ? relatedEntityMetadata?.[externalIdentityCollection.entityKey]
    : null;
  const externalIdentityProviderField = externalIdentityMetadata?.fieldDefinition?.provider;
  const externalIdentityEntityIcon = externalIdentityCollection?.rowIcon || externalIdentityCollection?.icon || null;

  // Provider presentation comes from the same canonical option metadata used by
  // related-collections. Runtime authProviders is only a defensive fallback for
  // a future provider value not yet known to the canonical catalogue.
  const providerFor = (providerKey) => {
    const canonical = metadataOptionItemForField(externalIdentityProviderField, providerKey);
    if (canonical) return {
      key: providerKey,
      label: canonical.label || providerKey,
      icon: canonical.icon ? `bi-${String(canonical.icon).replace(/^bi-/, '')}` : null,
    };
    return authProviders.find((candidate) => candidate.key === providerKey);
  };

  /*
   * Status text comes from the same canonical SysUser calculated fields used by
   * metadata-driven SysUser forms. This partial owns presentation only; it must
   * not duplicate those business/presentation calculations from raw booleans.
   */
  const resolvedEmailVerificationStatus = emailVerificationStatus || 'Not verified';
  const resolvedLocalPasswordStatus = localPasswordStatus || 'Not configured';
  const emailIsVerified = resolvedEmailVerificationStatus === 'Verified';
  const localPasswordConfigured = resolvedLocalPasswordStatus === 'Configured';


  const principalRepresentation =
    showPrincipalReference === true && accountPrincipal
      ? entryRepresentationFor('sys-principals', accountPrincipal)
      : null;
  const principalDisplayName =
    principalRepresentation?.name || accountPrincipal?.name || '';

  const verificationSourceDisplayName = (source) => {
    if (source === 'internal') {
      return 'ManatOS';
    }

    return providerFor(source)?.label || source;
  };
%>

<div class="account-summary-grid authentication-summary-grid">
  <% if (showPrincipalReference === true) { %>
    <div class="account-summary-label"><%= metadataText('@CM.PrincipalPerson') %></div>
    <div class="account-summary-value">
      <% if (accountPrincipal) { %>
        <a
          class="metadata-reference-link"
          href="/bo/sys-principals/<%= encodeURIComponent(accountPrincipal.id) %>"
        >
          <%- include('../sysbo/entry/shell/entry-icons', {
            entryRepresentation: principalRepresentation,
            iconGroupClass: 'metadata-entry-icons me-1'
          }) %>
          <%= principalDisplayName %>
        </a>
      <% } else { %>
        <span class="text-secondary"><%= metadataText('@CM.NoPersonPrincipalLinked') %></span>
      <% } %>
    </div>
  <% } %>
  <div class="account-summary-label"><%= metadataText('@EN.manatos.auth.users.label.EmailVerification') %></div>
  <div class="account-summary-value">
    <span class="badge text-bg-<%= emailIsVerified ? 'success' : 'secondary' %>">
      <%= metadataText(({ Verified: '@CM.Verified', 'Not verified': '@CM.NotVerified' })[resolvedEmailVerificationStatus] || resolvedEmailVerificationStatus) %>
    </span>
  </div>

  <div class="account-summary-label"><%= metadataText('@EN.manatos.auth.users.label.EmailVerificationSource') %></div>
  <div class="account-summary-value">
    <% if (emailIsVerified && authenticationUser.emailVerificationSource) { %>
      <%= verificationSourceDisplayName(authenticationUser.emailVerificationSource) %>
    <% } else { %>
      <span class="text-secondary">—</span>
    <% } %>
  </div>

  <div class="account-summary-label"><%= metadataText('@EN.manatos.auth.users.label.VerifiedAt') %></div>
  <div class="account-summary-value">
    <% if (authenticationUser.emailVerifiedAt) { %>
      <%= formatMetadataValue(authenticationUser.emailVerifiedAt, { format: 'datetime-elapsed', emptyText: '—' }) %>
    <% } else { %>
      <span class="text-secondary">—</span>
    <% } %>
  </div>

  <div class="account-summary-label"><%= metadataText('@EN.manatos.auth.users.label.LocalPassword') %></div>
  <div class="account-summary-value account-password-status">
    <span
      class="status-value <%= localPasswordConfigured ? 'status-positive' : 'status-neutral' %>"
    >
      <i
        class="bi <%= localPasswordConfigured ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"
      ></i>
      <%= metadataText(({ Configured: '@CM.Configured', 'Not configured': '@CM.NotConfigured' })[resolvedLocalPasswordStatus] || resolvedLocalPasswordStatus) %>
    </span>

    <% if (showPasswordAction === true) { %>
      <a class="btn btn-outline-primary btn-sm" href="/account/password">
        <i class="bi bi-key me-1"></i>
        <%= metadataText(localPasswordConfigured ? '@CM.ChangePassword' : '@CM.SetPassword') %>
      </a>
    <% } %>
  </div>
</div>

<div class="authentication-identities mt-4">
  <h3 class="h6 mb-3">
    <% if (externalIdentityCollection?.icon) { %><i class="bi bi-<%= externalIdentityCollection.icon %> me-1"></i><% } %>
    <%= metadataText(externalIdentityCollection?.label || '@EN.manatos.auth.externalIdentities.pluralLabel.ExternalIdentities') %>
  </h3>

  <% if (authenticationIdentities && authenticationIdentities.length > 0) { %>
    <div class="authentication-identity-list">
      <% for (const identity of authenticationIdentities) { %>
        <%
          const identityPopupFields = [
            'provider',
            'email',
            'displayName',
            'providerEmailVerificationStatus',
          ].map((key) => ({
            key,
            label: metadataText(externalIdentityMetadata?.fieldDefinition?.[key]?.label || key),
            type: externalIdentityMetadata?.fieldDefinition?.[key]?.type || 'string',
          }));
          const identityPopupRecord = {
            ...identity,
            providerEmailVerificationStatus: identity.emailVerified
              ? 'Provider email verified'
              : 'Provider email not verified',
          };
          const identityPopupDescriptor = {
            entityKey: externalIdentityCollection?.entityKey || 'external-identities',
            title: `External identity - ${
              metadataText(providerFor(identity.provider)?.label || identity.provider || 'Provider')
            }`,
            record: identityPopupRecord,
            fields: identityPopupFields,
          };
        %>
        <div class="authentication-identity-row">
          <div class="authentication-provider">
            <%
              const identityProvider = providerFor(identity.provider);
              const identityRepresentation = externalIdentityCollection
                ? entryRepresentationFor(externalIdentityCollection.entityKey, identity, externalIdentityEntityIcon)
                : null;
            %>
            <%- include('../sysbo/entry/shell/entry-icons', {
              entryRepresentation: identityRepresentation,
              iconGroupClass: 'metadata-entry-icons me-1 text-secondary'
            }) %>
            <i
              class="bi <%= identityProvider?.icon || 'bi-box-arrow-in-right' %>"
              aria-hidden="true"
            ></i>
            <button
              type="button"
              class="btn btn-link p-0 border-0 align-baseline fw-semibold metadata-related-entry-link"
              data-value-object-entry="<%= JSON.stringify(identityPopupDescriptor) %>"
            ><%= metadataText(identityProvider?.label || identity.provider) %></button>
          </div>

          <div class="authentication-identity-email">
            <%= identity.email || metadataText('@CM.NoEmailSupplied') %>
          </div>

          <div>
            <span class="badge text-bg-<%= identity.emailVerified ? 'success' : 'secondary' %>">
              <%= metadataText(identity.emailVerified ? '@CM.ProviderEmailVerified' : '@CM.ProviderEmailNotVerified') %>
            </span>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="text-secondary small"><%= metadataText('@CM.NoExternalProvidersLinked') %></div>
  <% } %>
</div>
