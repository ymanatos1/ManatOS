<%#
  COMPONENT: Password rules

  Purpose:
  - Renders the reusable password-policy checklist used by account creation/reset workflows.

  Inputs / metadata:
  - includeMatchRule controls whether the password-match rule is shown.

  CTX contract:
  - None; this is transient workflow presentation, not an entity-field component.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Browser auth form runtime updates data-rule states as the user types.
%>

<div class="password-rules small mt-2">
  <div data-rule="length"><i class="bi bi-circle me-1"></i>More than 8 characters</div>
  <div data-rule="alpha"><i class="bi bi-circle me-1"></i>At least one alphabetic character</div>
  <div data-rule="number"><i class="bi bi-circle me-1"></i>At least one numeric character</div>
  <div data-rule="symbol"><i class="bi bi-circle me-1"></i>At least one symbol character</div>
  <% if (typeof includeMatchRule !== 'undefined' && includeMatchRule) { %>
    <div data-rule="match"><i class="bi bi-circle me-1"></i>Passwords match</div>
  <% } %>
</div>
