<%#
  COMPONENT: Application footer

  Purpose:
  - Renders the persistent corporate footer and standard informational navigation.

  Inputs / metadata:
  - Application/company branding locals and configured footer links.

  CTX contract:
  - None.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Pure shell presentation.
%>

<footer class="corporate-footer">
  <div class="footer-brand">
    <strong>ManatOS</strong>
    <span>© <%= new Date().getFullYear() %> ManatOS Software Solutions</span>
  </div>
  <div class="footer-links">
    <a href="/company"><%= metadataText('@CM.Company') %></a>
    <a href="#"><%= metadataText('@CM.Privacy') %></a>
    <a href="#"><%= metadataText('@CM.Terms') %></a>
    <a href="#"><%= metadataText('@CM.Contact') %></a>
    <span class="footer-version">v<%= app.version %></span>
  </div>
</footer>
