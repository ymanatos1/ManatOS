<% if (!currentUser) { %>
  <div
    class="modal fade"
    id="signUpMethodModal"
    tabindex="-1"
    aria-labelledby="signUpMethodModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered auth-modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h2 class="modal-title h5 mb-1" id="signUpMethodModalLabel">
              Create your account
            </h2>
            <p class="modal-subtitle mb-0">
              Choose how you want to register.
            </p>
          </div>
          <button
            class="btn-close"
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>

        <div class="modal-body">
          <div class="auth-provider-list">
            <% for (const provider of authProviders) { %>
              <% if (provider.configured) { %>
                <a
                  class="btn btn-outline-secondary auth-provider-button"
                  href="/auth/<%= provider.key %>"
                >
                  <i class="bi <%= provider.icon %>"></i>
                  <span>Register with <%= provider.label %></span>
                  <i class="bi bi-chevron-right auth-provider-chevron"></i>
                </a>
              <% } else { %>
                <button
                  class="btn btn-outline-secondary auth-provider-button"
                  type="button"
                  disabled
                  title="<%= provider.label %> authentication is not configured yet."
                >
                  <i class="bi <%= provider.icon %>"></i>
                  <span>Register with <%= provider.label %></span>
                  <span class="badge text-bg-light border ms-auto">Not configured</span>
                </button>
              <% } %>
            <% } %>
          </div>

          <div class="auth-divider" aria-hidden="true">
            <span>or</span>
          </div>

          <button
            class="btn btn-primary auth-provider-button"
            type="button"
            data-bs-dismiss="modal"
            data-bs-toggle="modal"
            data-bs-target="#emailRegistrationModal"
          >
            <i class="bi bi-envelope"></i>
            <span>Register with Email</span>
            <i class="bi bi-chevron-right auth-provider-chevron"></i>
          </button>
        </div>
      </div>
    </div>
  </div>


  <div
    class="modal fade"
    id="emailRegistrationModal"
    tabindex="-1"
    aria-labelledby="emailRegistrationModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered auth-modal-dialog">
      <form
        class="modal-content"
        method="post"
        action="/auth/register/email"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header">
          <div>
            <h2 class="modal-title h5 mb-1" id="emailRegistrationModalLabel">
              Register with Email
            </h2>
            <p class="modal-subtitle mb-0">
              Create a Guest website account. You can add customer licenses later.
            </p>
          </div>
          <button
            class="btn-close"
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>

        <div class="modal-body">
          <label class="form-label" for="registrationName">User name</label>
          <input
            class="form-control mb-3"
            id="registrationName"
            name="name"
            autocomplete="username"
            required
            minlength="2"
          >

          <label class="form-label" for="registrationEmail">Email</label>
          <input
            class="form-control mb-3"
            id="registrationEmail"
            name="email"
            type="email"
            autocomplete="email"
            required
          >

          <label class="form-label" for="registrationPassword">Password</label>
          <input
            class="form-control password-policy-input"
            id="registrationPassword"
            name="password"
            type="password"
            autocomplete="new-password"
            required
          >

          <label class="form-label mt-3" for="registrationPasswordConfirm">
            Confirm password
          </label>
          <input
            class="form-control"
            id="registrationPasswordConfirm"
            name="confirmPassword"
            type="password"
            autocomplete="new-password"
            required
          >

          <%- include('password-rules') %>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">
            Cancel
          </button>
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-person-plus me-1"></i>
            Create account
          </button>
        </div>
      </form>
    </div>
  </div>


  <div
    class="modal fade"
    id="signInModal"
    tabindex="-1"
    aria-labelledby="signInModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered auth-modal-dialog">
      <form
        class="modal-content"
        method="post"
        action="/auth/signin/local"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header">
          <div>
            <h2 class="modal-title h5 mb-1" id="signInModalLabel">Sign in</h2>
            <p class="modal-subtitle mb-0">
              Use a connected provider or your ManatOS credentials.
            </p>
          </div>
          <button
            class="btn-close"
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>

        <div class="modal-body">
          <div class="auth-provider-list">
            <% for (const provider of authProviders) { %>
              <% if (provider.configured) { %>
                <a
                  class="btn btn-outline-secondary auth-provider-button"
                  href="/auth/<%= provider.key %>"
                >
                  <i class="bi <%= provider.icon %>"></i>
                  <span>Continue with <%= provider.label %></span>
                  <i class="bi bi-chevron-right auth-provider-chevron"></i>
                </a>
              <% } else { %>
                <button
                  class="btn btn-outline-secondary auth-provider-button"
                  type="button"
                  disabled
                  title="<%= provider.label %> authentication is not configured yet."
                >
                  <i class="bi <%= provider.icon %>"></i>
                  <span>Continue with <%= provider.label %></span>
                  <span class="badge text-bg-light border ms-auto">Not configured</span>
                </button>
              <% } %>
            <% } %>
          </div>

          <div class="auth-divider" aria-hidden="true">
            <span>or</span>
          </div>

          <label class="form-label" for="signInIdentity">Email or user name</label>
          <input
            class="form-control mb-3"
            id="signInIdentity"
            name="identity"
            autocomplete="username"
            required
          >

          <label class="form-label" for="signInPassword">Password</label>
          <input
            class="form-control mb-2"
            id="signInPassword"
            name="password"
            type="password"
            autocomplete="current-password"
            required
          >

          <button
            class="btn btn-link px-0"
            type="button"
            data-bs-dismiss="modal"
            data-bs-toggle="modal"
            data-bs-target="#passwordRequestModal"
          >
            Forgot or set password?
          </button>
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">
            Cancel
          </button>
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            Sign in
          </button>
        </div>
      </form>
    </div>
  </div>


  <div
    class="modal fade"
    id="passwordRequestModal"
    tabindex="-1"
    aria-labelledby="passwordRequestModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered auth-modal-dialog">
      <form
        class="modal-content"
        method="post"
        action="/auth/password/request"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="modal-header">
          <div>
            <h2 class="modal-title h5 mb-1" id="passwordRequestModalLabel">
              Forgot or set password
            </h2>
            <p class="modal-subtitle mb-0">
              We will send instructions when the account can be identified.
            </p>
          </div>
          <button
            class="btn-close"
            type="button"
            data-bs-dismiss="modal"
            aria-label="Close"
          ></button>
        </div>

        <div class="modal-body">
          <label class="form-label" for="passwordRequestIdentity">
            Email or user name
          </label>
          <input
            class="form-control"
            id="passwordRequestIdentity"
            name="identity"
            autocomplete="username"
            required
          >
        </div>

        <div class="modal-footer">
          <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">
            Cancel
          </button>
          <button class="btn btn-primary" type="submit">
            Send instructions
          </button>
        </div>
      </form>
    </div>
  </div>
<% } %>
