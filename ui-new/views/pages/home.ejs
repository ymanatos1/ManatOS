<section class="home-hero content-card">
  <div class="row align-items-center g-4">
    <div class="col-lg-7">
      <span class="eyebrow">ManatOS platform</span>
      <h2 class="display-6 fw-semibold mt-2 mb-3">A metadata-driven foundation for business applications.</h2>
      <p class="lead text-secondary mb-4">
        Express 5, TypeScript and reusable SysBO metadata provide a clean baseline for secure, maintainable application development.
      </p>

      <% if (!currentUser) { %>
        <div class="d-flex flex-wrap gap-2">
          <button class="btn btn-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#signInModal">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
          </button>
          <button class="btn btn-outline-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#signUpMethodModal">
            <i class="bi bi-person-plus me-2"></i>Create Guest account
          </button>
        </div>
      <% } else { %>
        <div class="welcome-panel">
          <i class="bi bi-person-check-fill"></i>
          <div>
            <span>Signed in as</span>
            <strong><%= currentUser.name %></strong>
            <small><%= currentUser.role %></small>
          </div>
        </div>
      <% } %>
    </div>

    <div class="col-lg-5">
      <div class="platform-summary">
        <div class="summary-icon"><i class="bi bi-boxes"></i></div>
        <h3>Application baseline</h3>
        <p>Authentication, sessions, authorization, metadata-driven CRUD and API integration are connected behind one consistent UI shell.</p>
        <div class="summary-features">
          <span><i class="bi bi-shield-check"></i> Secure sessions</span>
          <span><i class="bi bi-diagram-3"></i> Metadata driven</span>
          <span><i class="bi bi-braces"></i> API first</span>
        </div>
      </div>
    </div>
  </div>
</section>
