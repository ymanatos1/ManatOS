NODE_ENV=development
UI_PORT=3001
API_BASE_URL=http://localhost:3000

# Trusted server-to-server UI -> API operations.
# Generate this value yourself, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - This MUST be the EXACT SAME value as INTERNAL_API_KEY in api/.env.
# - It is not an OAuth/provider credential.
# - Keep it server-side and never commit it or expose it to browser JavaScript.
INTERNAL_API_KEY=

# none    = collapse/open state resets on every page load
# browser = remember left-navigation and Details state in localStorage
UI_NAVIGATION_STATE_PERSISTENCE=browser

# Secret used by Express to protect/sign the UI session.
# Generate a separate strong random value yourself, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# IMPORTANT:
# - This value belongs only to the UI; it does NOT need to match an API value.
# - Do not reuse INTERNAL_API_KEY or SECRETS_ENCRYPTION_KEY.
# - Keep it stable for the environment. Changing it invalidates existing UI sessions.
# - Use different values for development/test/production and never commit the real value.
SESSION_SECRET=

SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ERROR_LOG_MAX_ENTRIES=20
SHOW_TECHNICAL_ERROR_DETAILS=true

# Default SysBO list pagination. Comma-separated positive integers.
# Individual entity UI definitions may override these defaults in code later.
UI_PAGE_SIZE_OPTIONS=2,5,10,20,50,100
UI_DEFAULT_PAGE_SIZE=10


# External provider credentials are NOT stored here. Configure Microsoft, Google,
# Facebook and GitHub from Configuration > External authentication. Client secrets
# are encrypted by the API before persistence.

# Allow Admin users to verify another user email from the UI.
ALLOW_ADMIN_EMAIL_VERIFICATION=true

# Public UI origin. OAuth callback paths are configured as relative /auth/... paths in Configuration > External authentication.
PUBLIC_BASE_URL=http://localhost:3001

# Runtime configuration migration
# UI runtime/default settings are progressively moving to Admin-maintained
# SysConfiguration. These environment values remain startup/fallback defaults.
# Root trust secrets such as INTERNAL_API_KEY and SESSION_SECRET remain environment-only.
