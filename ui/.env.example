NODE_ENV=development
UI_PORT=3001
API_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=change-this-internal-key
# none    = collapse/open state resets on every page load
# browser = remember left-navigation and Details state in localStorage
UI_NAVIGATION_STATE_PERSISTENCE=browser

SESSION_SECRET=change-this-session-secret-to-a-long-random-value
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ERROR_LOG_MAX_ENTRIES=20
SHOW_TECHNICAL_ERROR_DETAILS=true

# Default SysBO list pagination. Comma-separated positive integers.
# Individual entity UI definitions may override these defaults in code later.
UI_PAGE_SIZE_OPTIONS=2,5,10,20,50,100
UI_DEFAULT_PAGE_SIZE=10

# Google OAuth. The UI shows Google as "Not configured" until BOTH the
# client ID and client secret are supplied. Register the callback URL below
# in the Google OAuth client configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Facebook Login. The UI shows Facebook as "Not configured" until BOTH the
# app/client ID and secret are supplied. Register the callback URL below in
# the Facebook Login configuration.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3001/auth/facebook/callback

# GitHub OAuth. The UI shows GitHub as "Not configured" until BOTH the
# client ID and client secret are supplied. Register the callback URL below
# in the GitHub OAuth App configuration. The UI requests read:user and
# user:email so it can resolve the authenticated GitHub login and a verified
# email address even when the user's primary email is private.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# Allow Admin users to verify another user email from the UI.
ALLOW_ADMIN_EMAIL_VERIFICATION=true
