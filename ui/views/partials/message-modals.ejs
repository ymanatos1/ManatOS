
<% if (typeof warningMessage !== 'undefined' && warningMessage) { %>
  <div
    class="modal fade"
    id="warningMessageModal"
    tabindex="-1"
    data-auto-show="true"
    aria-labelledby="warningMessageModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-md">
      <div class="modal-content">
        <div class="modal-header bg-warning-subtle">
          <h2 class="modal-title h5" id="warningMessageModalLabel">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <%= typeof warningTitle !== 'undefined' && warningTitle ? warningTitle : 'Operation completed with a warning' %>
          </h2>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <p class="mb-0"><%= warningMessage %></p>
        </div>

        <div class="modal-footer">
          <% if (typeof warningActionUrl !== 'undefined' && warningActionUrl) { %>
            <a class="btn btn-primary" href="<%= warningActionUrl %>">
              <%= typeof warningActionLabel !== 'undefined' && warningActionLabel ? warningActionLabel : 'Continue' %>
            </a>
          <% } else { %>
            <button class="btn btn-primary" type="button" data-bs-dismiss="modal">OK</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
<% } %>

<% if (typeof informationMessage !== 'undefined' && informationMessage) { %>
