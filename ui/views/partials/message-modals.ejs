    tabindex="-1"
    data-auto-show="true"
    aria-labelledby="informationMessageModalLabel"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-md">
      <div class="modal-content">
        <div class="modal-header bg-primary-subtle">
          <h2 class="modal-title h5" id="informationMessageModalLabel">
            <i class="bi bi-check-circle me-2"></i>
            <%= typeof informationTitle !== 'undefined' && informationTitle ? informationTitle : 'Information' %>
          </h2>
          <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body">
          <p class="mb-0"><%= informationMessage %></p>
        </div>

        <div class="modal-footer">
          <% if (typeof informationActionUrl !== 'undefined' && informationActionUrl) { %>
            <a class="btn btn-primary" href="<%= informationActionUrl %>">
              <%= typeof informationActionLabel !== 'undefined' && informationActionLabel ? informationActionLabel : 'Continue' %>
            </a>
          <% } else { %>
