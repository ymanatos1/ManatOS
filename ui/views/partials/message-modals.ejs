<% if(typeof applicationError!=='undefined'&&applicationError){ %><div class="modal fade" id="applicationErrorModal" tabindex="-1" data-auto-show="true"><div class="modal-dialog modal-lg"><div class="modal-content"><div class="modal-header bg-danger-subtle"><h2 class="modal-title h5"><i class="bi bi-exclamation-triangle me-2"></i>Operation failed</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p><%= applicationError.userMessage %></p><% if(applicationError.operationTrace?.length){ %><details><summary>Show operation details</summary><pre class="operation-trace mt-2"><%= JSON.stringify(applicationError.operationTrace,null,2) %></pre></details><% } %></div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><% if(applicationError.retryable){ %><button class="btn btn-primary" type="button" onclick="window.manatosRetry?.() || history.go(0)">Retry</button><% } %></div></div></div></div><% } %>
