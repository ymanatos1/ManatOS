<ul class="vertical-menu level-<%= level %>">
  <% for (const item of items) { %>
    <% if (item.separatorBefore) { %>
      <li class="vertical-separator"><hr></li>
    <% } %>

    <li>
      <% if (item.children?.length) { %>
        <details <%= level === 0 ? 'open' : '' %>>
          <summary>
            <span class="vertical-menu-caption">
              <% if (item.icon) { %>
                <i class="bi <%= item.icon %> me-2"></i>
              <% } %>
              <span><%= item.text %></span>
            </span>

            <i class="bi bi-chevron-down menu-chevron"></i>
          </summary>

          <%- include(
            'vertical-nav',
            {
              items: item.children,
              level: level + 1
            }
          ) %>
        </details>
      <% } else { %>
        <a
          href="<%= item.url || '#' %>"
          class="<%= item.id === 'logout' ? 'vertical-menu-logout' : '' %>"
        >
          <span class="vertical-menu-caption">
            <% if (item.icon) { %>
              <i class="bi <%= item.icon %> me-2"></i>
            <% } %>
            <span><%= item.text %></span>
          </span>
        </a>
      <% } %>
    </li>
  <% } %>
</ul>
