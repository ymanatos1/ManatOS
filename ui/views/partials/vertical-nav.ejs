<ul class="vertical-menu level-<%= level %>"><% for(const item of items){ %><% if(item.separatorBefore){ %><li><hr></li><% } %><li><% if(item.children?.length){ %><details <%= level===0?'open':'' %>><summary><% if(item.icon){ %><i class="bi <%= item.icon %> me-2"></i><% } %><%= item.text %></summary><%- include('vertical-nav',{items:item.children,level:level+1}) %></details><% }else{ %><a href="<%= item.url || '#' %>"><% if(item.icon){ %><i class="bi <%= item.icon %> me-2"></i><% } %><%= item.text %></a><% } %></li><% } %></ul>
