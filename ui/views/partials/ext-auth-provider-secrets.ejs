<%
  const provider = String(credentialTest?.provider || item.provider || 'microsoft').toLowerCase();
  const providerDefinitions = externalAuthProviderDefinitions || [];
  const storedVerified = item.credentialsVerified === true;
  const hasStoredSecret = item.hasClientSecret === true;
  const pendingStatus = credentialTest?.status || null;
  const pendingVerified = pendingStatus === 'verified' && credentialTest?.hasPendingSecret;
  const credentialChangeVisible = !pendingVerified && (isNew || pendingStatus === 'failed');
  const displayedClientId = credentialTest?.clientId || item.clientId || '';
  const displayedVerified = pendingVerified || (!credentialChangeVisible && storedVerified);
  const canTestStoredCredentials = !isNew && !storedVerified && hasStoredSecret && Boolean(item.clientId) && !credentialChangeVisible;
%>
<div
  class="row g-3"
  data-ext-auth-provider-secrets
  data-stored-credentials-verified="<%= storedVerified ? 'true' : 'false' %>"
>
  <input
    type="hidden"
    value="<%= pendingVerified ? 'verified' : (credentialChangeVisible ? 'required' : (storedVerified ? 'stored-verified' : 'stored-unverified')) %>"
    data-provider-credential-test-state
  >
  <input
    type="hidden"
    value="<%= pendingVerified ? 'true' : 'false' %>"
    data-provider-pending-credential-save
  >

  <% if (!isNew) { %>
    <div class="col-12">
      <div class="alert <%= storedVerified ? 'alert-success' : 'alert-warning' %> border small mb-0">
        <% if (pendingVerified) { %>
          <strong><i class="bi bi-check-circle-fill me-1"></i> New credentials tested successfully</strong>
          <div class="mt-1">The tested Client ID and Client secret are held securely in this server session. Click Save to replace the stored credential pair.</div>
        <% } else if (storedVerified) { %>
          <strong><i class="bi bi-check-circle-fill me-1"></i> Credentials verified</strong>
          <div class="mt-1">
            Client ID and Client secret are stored and were successfully tested
            <%= item.credentialsVerifiedAt ? `on ${new Date(item.credentialsVerifiedAt).toLocaleString()}` : '' %>.
            The plaintext secret is intentionally never returned to the UI.
          </div>
        <% } else { %>
          <strong><i class="bi bi-exclamation-triangle-fill me-1"></i> Credentials stored, not verified</strong>
          <div class="mt-1">Client ID and Client secret are stored securely, but this credential pair has not passed provider verification. You can test the stored pair without re-entering it. Until verification succeeds, the provider is treated as not configured for sign-in.</div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (pendingStatus === 'failed') { %>
    <div class="col-12">
      <div class="alert alert-danger border small mb-0">
        <strong>Credential test failed.</strong>
        <span><%= credentialTest.errorMessage || 'The provider rejected the proposed Client ID / Client secret pair.' %></span>
        <div class="mt-1">You may correct and test the pair again, or save it securely as unverified and return to verification later.</div>
      </div>
    </div>
  <% } %>

  <div class="col-md-6">
    <label class="form-label" for="clientId">Client ID</label>
    <input
      id="clientId"
      class="form-control"
      value="<%= displayedClientId %>"
      autocomplete="off"
      data-provider-client-id
      <%= credentialChangeVisible && !readOnly ? 'name="clientId" required' : 'readonly aria-readonly="true"' %>
    >
  </div>

  <div class="col-md-6" data-provider-secret-display <%= credentialChangeVisible ? 'hidden' : '' %>>
    <label class="form-label">Client secret</label>
    <div class="form-control bg-body-secondary text-secondary" aria-readonly="true">
      <i class="bi <%= hasStoredSecret || pendingVerified ? 'bi-lock-fill' : 'bi-lock' %> me-1"></i>
      <%= pendingVerified
        ? 'New secret tested successfully; ready to save'
        : (hasStoredSecret ? 'Secret stored securely' : 'No secret stored') %>
    </div>
  </div>

  <div class="col-md-6" data-provider-secret-editor <%= credentialChangeVisible ? '' : 'hidden' %>>
    <label class="form-label" for="clientSecret">Client secret</label>
    <input
      id="clientSecret"
      name="clientSecret"
      type="password"
      class="form-control"
      value=""
      <%= credentialChangeVisible && !readOnly ? 'required' : 'disabled' %>
      autocomplete="new-password"
      data-provider-client-secret
    >
    <div class="form-text">Client ID and Client secret are changed as one credential pair. You may save them securely before testing; the provider is not available for sign-in until the pair is verified.</div>
  </div>

  <div class="col-12 d-flex gap-2 flex-wrap align-items-center" data-provider-credential-actions>
    <% if (!readOnly) { %>
      <% if (!credentialChangeVisible && !pendingVerified) { %>
        <button class="btn btn-outline-primary" type="button" data-provider-change-credentials>
          <i class="bi bi-pencil-square me-1"></i>Change credentials
        </button>
      <% } %>

      <button
        class="btn btn-outline-success"
        type="button"
        data-provider-test-credentials
        data-provider-test-url="/bo/sys-ext-auth-providers/test-credentials"
        data-provider-test-stored="<%= canTestStoredCredentials ? 'true' : 'false' %>"
        <%= credentialChangeVisible || canTestStoredCredentials ? '' : 'hidden' %>
        <%= canTestStoredCredentials ? '' : 'disabled' %>
      >
        <i class="bi bi-check2-circle me-1"></i>Test credentials
      </button>

      <% if (!isNew && (hasStoredSecret || item.clientId)) { %>
        <button
          class="btn btn-outline-danger"
          type="button"
          data-bs-toggle="modal"
          data-bs-target="#removeProviderCredentialsModal"
        >
          <i class="bi bi-key me-1"></i>Remove credentials
        </button>
      <% } %>
    <% } %>

    <div class="ms-auto d-flex align-items-center gap-2 small" data-provider-credentials-verified-indicator>
      <span class="text-secondary">Credentials verified</span>
      <span class="badge rounded-pill <%= displayedVerified ? 'text-bg-success' : 'text-bg-secondary' %>">
        <i class="bi <%= displayedVerified ? 'bi-check-circle-fill' : 'bi-x-circle' %> me-1"></i><%= displayedVerified ? 'Yes' : 'No' %>
      </span>
    </div>
  </div>

  <% if (!readOnly) { %>
    <div class="col-12">
      <div class="alert alert-danger border small mb-0 w-100" data-provider-credential-test-feedback hidden></div>
    </div>
  <% } %>

  <% for (const definition of providerDefinitions) { %>
    <div
      class="col-12"
      data-provider-secrets-help="<%= definition.provider %>"
      <%= provider !== definition.provider ? 'hidden' : '' %>
    >
      <div class="alert alert-light border small mb-0">
        <strong><%= definition.secretsHelp.title %></strong>
        <p class="mb-2 mt-2"><%= definition.secretsHelp.introduction %></p>

        <div class="fw-semibold">Client ID</div>
        <ul class="mb-2">
          <% for (const step of definition.secretsHelp.clientId) { %><li><%= step %></li><% } %>
        </ul>

        <div class="fw-semibold">Client secret</div>
        <ul class="<%= definition.secretsHelp.warning ? 'mb-2' : 'mb-0' %>">
          <% for (const step of definition.secretsHelp.clientSecret) { %><li><%= step %></li><% } %>
        </ul>

        <% if (definition.secretsHelp.warning) { %>
          <div><strong>Important:</strong> <%= definition.secretsHelp.warning %></div>
        <% } %>
      </div>
    </div>
  <% } %>
</div>
