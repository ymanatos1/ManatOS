<div class="row g-3">
  <% for (
    const field of Object.values(definition.boMetadata.fieldDefinition)
      .sort((a, b) => a.order - b.order)
  ) { %>
    <% if (field.generated || field.readOnly || field.sensitive) continue; %>
    <% if (false && definition.key === 'sys-users' && field.key === 'emailVerified') continue; /* #16 DISPOSABLE legacy SysUser-only field suppression */ %>

    <div class="col-md-6">
      <label class="form-label"><%= field.label %></label>

      <% if (field.type === 'boolean') { %>
        <div class="form-check form-switch">
          <input
            class="form-check-input"
            type="checkbox"
            name="<%= field.key %>"
            <%= item[field.key] !== false ? 'checked' : '' %>
            <%= readOnly ? 'disabled' : '' %>
          >
        </div>
      <% } else if (field.type === 'enum') { %>
        <select
          class="form-select"
          name="<%= field.key %>"
          <%= field.required ? 'required' : '' %>
          <%= readOnly ? 'disabled' : '' %>
        >
          <option value="">Choose...</option>

          <% for (const option of field.enumValues || []) { %>
            <option
              value="<%= option %>"
              <%= item[field.key] === option ? 'selected' : '' %>
            >
              <%= option %>
            </option>
          <% } %>
        </select>
      <% } else if (field.type === 'reference') { %>
        <select
          class="form-select"
          name="<%= field.key %>"
          <%= field.required ? 'required' : '' %>
          <%= readOnly ? 'disabled' : '' %>
        >
          <option value="">None</option>

          <% for (const reference of referenceData[field.key] || []) { %>
            <option
              value="<%= reference.id %>"
              <%= item[field.key] === reference.id ? 'selected' : '' %>
            >
              <%= reference.name %>
            </option>
          <% } %>
        </select>
      <% } else { %>
        <input
          class="form-control"
          name="<%= field.key %>"
          type="<%=
            field.type === 'email'
              ? 'email'
              : field.type === 'number'
                ? 'number'
                : field.type === 'date'
                  ? 'datetime-local'
                  : 'text'
          %>"
          value="<%= item[field.key] ?? '' %>"
          <%= field.required ? 'required' : '' %>
          <% if (field.minLength !== undefined) { %>minlength="<%= field.minLength %>"<% } %>
          <% if (field.maxLength !== undefined) { %>maxlength="<%= field.maxLength %>"<% } %>
          <%= readOnly ? 'disabled' : '' %>
        >
      <% } %>
    </div>
  <% } %>
</div>
