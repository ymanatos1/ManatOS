<%
  const provider = String(credentialTest?.provider || item.provider || 'microsoft').toLowerCase();
  const enabledValue = credentialTest ? credentialTest.enabled : item.enabled !== false;
  const providerLocked = readOnly || !isNew || credentialTest?.status === 'verified';
  const providerDefinitions = externalAuthProviderDefinitions || [];
  const providerHelp =
    providerDefinitions.find((definition) => definition.provider === provider) ||
    providerDefinitions[0];
  const microsoftDefinition =
    providerDefinitions.find((definition) => definition.provider === 'microsoft');
%>
<div class="row g-3" data-ext-auth-provider-editor>
  <div class="col-md-6">
    <label class="form-label" for="provider">Provider</label>
    <div class="input-group">
      <span
        class="input-group-text ext-auth-provider-icon"
        data-provider-icon
        aria-hidden="true"
      >
        <i class="bi <%= providerHelp?.icon || 'bi-globe2' %>"></i>
      </span>
      <select id="provider" name="provider" class="form-select" <%= providerLocked ? 'disabled' : '' %> required>
        <% for (const definition of providerDefinitions) { %>
          <option
            value="<%= definition.provider %>"
            <%= provider === definition.provider ? 'selected' : '' %>
            data-provider-icon="<%= definition.icon %>"
            data-callback-default="<%= definition.callbackPath %>"
            data-tenant-default="<%= definition.tenant || '' %>"
          ><%= definition.label %></option>
        <% } %>
      </select>
    </div>
    <% if (providerLocked) { %><input type="hidden" name="provider" value="<%= provider %>"><% } %>
    <div class="form-text">Exactly one configuration record is allowed for each supported provider.</div>
  </div>

  <div class="col-md-6">
    <label class="form-label" for="callbackPath">Callback path</label>
    <input
      id="callbackPath"
      name="callbackPath"
      class="form-control"
      value="<%= providerHelp?.callbackPath || item.callbackPath || '' %>"
      readonly
      aria-readonly="true"
      required
    >
    <div class="form-text">
      Provider-defined callback path. ManatOS combines it with <code>PUBLIC_BASE_URL</code>.
      It is generated automatically and cannot be changed by administrators.
    </div>
  </div>

  <div class="col-md-6" data-microsoft-tenant <%= provider !== 'microsoft' ? 'hidden' : '' %>>
    <label class="form-label" for="tenant">Tenant</label>
    <select id="tenant" name="tenant" class="form-select" disabled aria-disabled="true">
      <option value="<%= microsoftDefinition?.tenant || 'common' %>" selected><%= microsoftDefinition?.tenant || 'common' %></option>
    </select>
    <input type="hidden" name="tenant" value="<%= microsoftDefinition?.tenant || 'common' %>" data-microsoft-tenant-value>
    <div class="form-text">Microsoft currently supports only <code>common</code>.</div>
  </div>

  <div class="col-md-6 d-flex align-items-center" data-provider-enabled-field>
    <div class="form-check form-switch mt-md-4">
      <input class="form-check-input" type="checkbox" id="enabled" name="enabled" <%= enabledValue ? 'checked' : '' %> <%= readOnly ? 'disabled' : '' %>>
      <label class="form-check-label" for="enabled">Enabled</label>
    </div>
  </div>

  <% for (const definition of providerDefinitions) { %>
    <div
      class="col-12"
      data-provider-general-help="<%= definition.provider %>"
      <%= provider !== definition.provider ? 'hidden' : '' %>
    >
      <div class="alert alert-light border small mb-0">
        <strong><%= definition.generalHelp.title %></strong>
        <ul class="mb-0 mt-2">
          <% for (const step of definition.generalHelp.steps) { %>
            <li><%= step %></li>
          <% } %>
        </ul>
        <div class="mt-2"><%= definition.generalHelp.configuredRule %></div>
      </div>
    </div>
  <% } %>
</div>
