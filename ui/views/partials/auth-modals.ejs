<% if(!currentUser){ %>
<div class="modal fade" id="signUpMethodModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h5">Create your account</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body d-grid gap-2"><% for(const provider of authProviders){ %><a class="btn btn-outline-primary" href="/auth/<%= provider.key %>"><i class="bi <%= provider.icon %> me-2"></i>Continue with <%= provider.label %></a><% } %><% if(authProviders.length){ %><div class="text-center text-secondary my-2">or</div><% } %><button class="btn btn-primary" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#emailRegistrationModal"><i class="bi bi-envelope me-2"></i>Register with Email</button></div></div></div></div>
<div class="modal fade" id="emailRegistrationModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/auth/register/email"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h2 class="modal-title h5">Register with Email</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">User name</label><input class="form-control mb-3" name="name" required minlength="2"><label class="form-label">Email</label><input class="form-control mb-3" name="email" type="email" required><label class="form-label">Password</label><input class="form-control password-policy-input" name="password" type="password" required><label class="form-label mt-3">Confirm password</label><input class="form-control" name="confirmPassword" type="password" required><%- include('password-rules') %></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create account</button></div></form></div></div>
<div class="modal fade" id="signInModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/auth/signin/local"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h2 class="modal-title h5">Sign in</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div class="d-grid gap-2"><% for(const provider of authProviders){ %><a class="btn btn-outline-primary" href="/auth/<%= provider.key %>"><i class="bi <%= provider.icon %> me-2"></i>Continue with <%= provider.label %></a><% } %></div><% if(authProviders.length){ %><div class="text-center text-secondary my-3">or</div><% } %><label class="form-label">Email or user name</label><input class="form-control mb-3" name="identity" required><label class="form-label">Password</label><input class="form-control mb-2" name="password" type="password" required><button class="btn btn-link px-0" type="button" data-bs-dismiss="modal" data-bs-toggle="modal" data-bs-target="#passwordRequestModal">Forgot or set password?</button></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Sign in</button></div></form></div></div>
<div class="modal fade" id="passwordRequestModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/auth/password/request"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header"><h2 class="modal-title h5">Forgot or set password</h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><p class="text-secondary">Enter your email or user name. If an account exists, password instructions will be sent.</p><input class="form-control" name="identity" required></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Send instructions</button></div></form></div></div>
<% } %>
