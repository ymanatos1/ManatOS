<header class="top-header">
  <div class="header-brand-area">
    <a
      href="/"
      class="brand-link"
      title="ManatOS home"
      aria-label="ManatOS home"
    >
      <!--
        One physical logo element is used for both themes. This prevents
        duplicate branding if theme-specific CSS is stale/cached and makes
        the active asset unambiguous at runtime.
      -->
      <img
        id="themeBrandLogo"
        src="/assets/manatos-logo-middle-1.png"
        data-darker-src="/assets/manatos-logo-middle-1.png"
        data-lighter-src="/assets/manatos-logo-middle-2.png"
        alt="ManatOS Software Solutions"
        class="brand-logo1 theme-brand-logo"
      >

      <!-- Apply the already-restored <html> theme immediately, before paint. -->
      <script>
        (() => {
          const logo = document.getElementById('themeBrandLogo');
          const lighter = document.documentElement.dataset.uiTheme === 'lighter';

          if (logo) {
            logo.src = lighter ? logo.dataset.lighterSrc : logo.dataset.darkerSrc;
            logo.classList.toggle('brand-logo1', !lighter);
            logo.classList.toggle('brand-logo2', lighter);
          }
        })();
      </script>
    </a>

    <span class="version-badge d-none d-sm-inline">
      v<%= app.version %>
    </span>
  </div>

  <div class="header-actions">
    <% if (!currentUser) { %>
      <button
        type="button"
        class="btn btn-info btn-sm header-auth-button"
        data-bs-toggle="modal"
        data-bs-target="#signInModal"
      >
        <i class="bi bi-box-arrow-in-right me-1"></i>
        Sign in
      </button>

      <button
        type="button"
        class="btn btn-success btn-sm header-auth-button"
        data-bs-toggle="modal"
        data-bs-target="#signUpMethodModal"
      >
        <i class="bi bi-person-plus me-1"></i>
        Sign up
      </button>
    <% } else { %>
      <!-- Future notifications entry point. -->
      <button
        type="button"
        class="btn btn-sm btn-outline-light header-notifications-button"
        title="Notifications"
        aria-label="Notifications"
      >
        <i class="bi bi-bell"></i>
      </button>

      <div class="dropdown">
        <button
          class="btn btn-sm btn-outline-light dropdown-toggle"
          type="button"
          data-bs-toggle="dropdown"
          aria-expanded="false"
        >
          <i class="bi bi-person-circle me-1"></i>
          Account
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow-sm account-menu">
          <li class="px-3 pt-2 pb-1">
            <div class="account-menu-name"><%= currentUser.name %></div>
            <span class="badge rounded-pill text-bg-light border account-role-badge">
              <%= currentUser.role %>
            </span>
          </li>

          <li><hr class="dropdown-divider"></li>

          <li>
            <a class="dropdown-item" href="/account">
              <i class="bi bi-person-vcard me-2"></i>
              Account details
            </a>
          </li>

          <li>
            <a class="dropdown-item" href="/personal">
              <i class="bi bi-person-lines-fill me-2"></i>
              Personal details
            </a>
          </li>

          <li>
            <a class="dropdown-item" href="/account/password">
              <i class="bi bi-key me-2"></i>
              <%= currentUser.hasPassword ? 'Change password' : 'Set password' %>
            </a>
          </li>

          <li><hr class="dropdown-divider"></li>

          <li>
            <a class="dropdown-item" href="/auth/logout">
              <i class="bi bi-box-arrow-right me-2"></i>
              Logout
            </a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</header>
