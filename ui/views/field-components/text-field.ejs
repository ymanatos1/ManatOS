<%
  const effectiveEditable = typeof controlEditable === 'boolean' ? controlEditable : editable;
  const inputType = typeof inputTypeOverride === 'string' ? inputTypeOverride : (field.type === 'email' ? 'email' : 'text');
  const effectiveId = typeof inputId === 'string' ? inputId : `metadata-field-${key}`;
  const effectiveName = typeof inputName === 'string' ? inputName : key;
  const effectiveValue = typeof inputValue !== 'undefined' ? inputValue : value;
  const ctxBound = typeof bindCtx === 'boolean' ? bindCtx : true;
  const dataAttributes = typeof inputDataAttributes !== 'undefined' && inputDataAttributes && typeof inputDataAttributes === 'object' ? inputDataAttributes : {};
%>
<div class="input-group metadata-field-input" data-enhanced-field-input data-field-component="<%= field.type === 'email' ? 'email' : 'text' %>">
  <button class="btn metadata-field-input-menu-toggle <%= effectiveEditable ? 'is-enabled' : 'is-readonly' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Text field tools" aria-label="Text field tools for <%= fieldLabel(field) %>">
    <% if (field.type === 'email') { %><i class="bi bi-envelope" aria-hidden="true"></i><% } else { %><span class="metadata-field-type-glyph" aria-hidden="true">Tt</span><% } %>
  </button>
  <input
    class="form-control"
    id="<%= effectiveId %>"
    name="<%= effectiveName %>"
    data-field-control
    <% if (ctxBound) { %>data-ctx-field="<%= key %>"<% } %>
    type="<%= inputType %>"
    value="<%= effectiveValue ?? '' %>"
    <%= field.required ? 'required' : '' %>
    <% if (field.minLength !== undefined) { %>minlength="<%= field.minLength %>"<% } %>
    <% if (field.maxLength !== undefined) { %>maxlength="<%= field.maxLength %>"<% } %>
    <% if (typeof inputAutocomplete === 'string') { %>autocomplete="<%= inputAutocomplete %>"<% } %>
    <% for (const [attributeName, attributeValue] of Object.entries(dataAttributes)) { %><%= attributeName %>="<%= attributeValue %>" <% } %>
    <%= effectiveEditable ? '' : (inputType === 'password' ? 'disabled' : 'readonly') %>
  >
  <%- include('field-tools-menu', { key, editable: effectiveEditable, ctxBound, actions: [
    ...(inputType === 'password' ? [] : [{ action: 'trim', icon: 'text-indent-left', label: 'Trim spaces' }]),
    { action: 'clear', icon: 'eraser', label: 'Clear value' },
  ] }) %>
</div>
