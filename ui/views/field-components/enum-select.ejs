<%
  const effectiveId = typeof inputId === 'string' ? inputId : `metadata-field-${key}`;
  const effectiveName = typeof inputName === 'string' ? inputName : key;
  const ctxBound = typeof bindCtx === 'boolean' ? bindCtx : true;
  /*
   * Contextual option projections may intentionally override labels/availability
   * without repeating canonical presentation metadata. Merge by value so icons
   * (and tones) declared on the canonical field survive that projection for every
   * enum field, including External Authentication Provider.
   */
  const canonicalEnumItems = Array.isArray(field.enumItems)
    ? field.enumItems
    : (Array.isArray(field.optionItems) ? field.optionItems : []);
  const presentationItems = enumItems.map((option) => ({
    ...(canonicalEnumItems.find((candidate) => String(candidate?.value ?? '') === String(option?.value ?? '')) || {}),
    ...option,
  }));
  const richSelected = presentationItems.find((option) => String(option?.value ?? '') === String(value ?? ''));
  const richHasIcons = presentationItems.some((option) => typeof option.icon === 'string' && option.icon);
  const enumToneClass = (option) => {
    const tone = option?.tone;
    if (!tone) return '';
    if (tone === 'danger' && option?.toneStrength === 'soft') return 'text-danger opacity-75';
    if (tone === 'danger' && option?.toneStrength === 'strong') return 'text-danger-emphasis';
    if (tone === 'warning') return 'text-warning-emphasis';
    return `text-${tone}`;
  };
%>
<div class="input-group metadata-field-input metadata-enum-select" data-enhanced-field-input data-field-component="enum" data-metadata-enum-select>
  <div class="dropdown">
    <button class="btn metadata-field-input-menu-toggle <%= editable ? 'is-enabled' : 'is-readonly' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Enumeration field tools" aria-label="Enumeration field tools for <%= fieldLabel(field) %>"><i class="bi bi-list-ul" aria-hidden="true"></i></button>
    <%- include('field-tools-menu', { key, editable, actions: [{ action: 'clear', icon: 'eraser', label: 'Clear value' }] }) %>
  </div>
  <select class="visually-hidden" id="<%= effectiveId %>" name="<%= effectiveName %>" <% if (ctxBound) { %>data-ctx-field="<%= key %>"<% } %> data-enum-items="<%= JSON.stringify(presentationItems) %>" tabindex="-1" aria-hidden="true" <%= field.required ? 'required' : '' %> <%= editable ? '' : 'disabled' %>>
    <option value="">Choose...</option>
    <% for (const option of presentationItems) { %><option value="<%= option.value %>" data-enum-item="<%= JSON.stringify(option) %>" <%= value === option.value ? 'selected' : '' %>><%= option.label || option.value %></option><% } %>
  </select>
  <button type="button" class="form-select metadata-enum-select-toggle text-start" data-bs-toggle="dropdown" data-metadata-enum-toggle aria-expanded="false" <%= editable ? '' : 'disabled' %>>
    <span class="d-flex align-items-center gap-2"><% if (richHasIcons) { %><i class="bi bi-<%= richSelected?.icon || 'list' %> <%= enumToneClass(richSelected) %>" data-enum-selected-icon aria-hidden="true"></i><% } %><span data-enum-selected-label><%= richSelected?.label || richSelected?.value || 'Choose...' %></span></span>
  </button>
  <% if (editable) { %>
    <ul class="dropdown-menu metadata-enum-select-menu w-100" role="listbox">
      <li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center" data-enum-choice="" role="option">Choose...</button></li>
      <% for (const option of presentationItems) { %><li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center <%= value === option.value ? 'active' : '' %>" data-enum-choice="<%= option.value %>" role="option" aria-selected="<%= value === option.value ? 'true' : 'false' %>"><span><%= option.label || option.value %></span><% if (option.icon) { %><i class="bi bi-<%= option.icon %> <%= enumToneClass(option) %> ms-3" aria-hidden="true"></i><% } %></button></li><% } %>
    </ul>
  <% } %>
</div>
