<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title ? title + ' - ' : '' %>ManatOS</title><link rel="icon" href="/assets/favicon.ico"><link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css"><link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css"><link rel="stylesheet" href="/css/site.css"></head>
<body class="<%= currentUser ? 'authenticated' : 'anonymous' %>"><%- include('../partials/header') %><%- include('../partials/horizontal-nav') %><main class="app-shell"><% if(currentUser){ %><aside class="left-navigation"><%- include('../partials/vertical-nav',{items:app.navigation.vertical,level:0}) %></aside><% } %><section class="workspace"><div class="workspace-titlebar"><div><small class="text-secondary">ManatOS / <%= title || 'Home' %></small><h1 class="h4 mb-0"><%= title || 'Home' %></h1></div><% if(currentUser){ %><button class="btn btn-sm btn-outline-secondary" id="toggleDetailsPanel"><i class="bi bi-layout-sidebar-reverse"></i> Details</button><% } %></div><div class="workspace-content"><%- body %></div></section><% if(currentUser){ %><aside class="details-panel d-none" id="detailsPanel"><h2 class="h6">Details</h2><hr><div class="small text-secondary"><% if(app.scopes.workspace.application){ %>Active application: <strong><%= app.scopes.workspace.application.sysApplication.name %></strong><% } else { %>Contextual page details will appear here when required.<% } %></div></aside><% } %></main><%- include('../partials/footer') %><%- include('../partials/auth-modals') %><%- include('../partials/message-modals') %><script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script><script src="/js/site.js"></script></body></html>
