<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <meta
    name="theme-color"
    content="#071a3d"
  >

  <title><%= title ? `${title} - ` : '' %>ManatOS</title>


  <!-- =========================================================
       ManatOS favicons — M1
       ========================================================= -->

  <link
    rel="icon"
    type="image/x-icon"
    href="/assets/m1/favicon.ico?v=4"
  >

  <link
    rel="icon"
    type="image/png"
    sizes="16x16"
    href="/assets/m1/favicon-16x16.png?v=4"
  >

  <link
    rel="icon"
    type="image/png"
    sizes="32x32"
    href="/assets/m1/favicon-32x32.png?v=4"
  >

  <link
    rel="icon"
    type="image/png"
    sizes="48x48"
    href="/assets/m1/favicon-48x48.png?v=4"
  >

  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/assets/m1/apple-touch-icon.png?v=4"
  >


  <!-- =========================================================
       Current website user identity for early UI preference restoration.

       Keeping the EJS expression in HTML metadata avoids embedding EJS
       directly inside JavaScript syntax, which keeps editors/parsers happy.
       ========================================================= -->
  <meta
    name="manatos-user-id"
    content="<%= currentUser?.id || 'anonymous' %>"
  >

  <meta
    name="manatos-ui-boot-id"
    content="<%= typeof uiBootId !== 'undefined' ? uiBootId : 'unknown' %>"
  >

  <meta
    name="csrf-token"
    content="<%= typeof csrfToken === 'string' ? csrfToken : '' %>"
  >


  <!-- =========================================================
       Restore the user's theme before styles paint.

       Theme preference is browser-local and keyed per website user.
       Applying it to <html> here prevents a darker-theme flash after a
       restart/navigation and also selects the correct header logo immediately.
       ========================================================= -->
  <script>
    (() => {
      try {
        const userId =
          document
            .querySelector('meta[name="manatos-user-id"]')
            ?.getAttribute('content') ||
          'anonymous';

        const themeKey = `manatos.ui.theme.${userId}`;
        const storedTheme = localStorage.getItem(themeKey);
        const theme = storedTheme === 'lighter' ? 'lighter' : 'darker';

        const languageKey = `manatos.ui.language.${userId}`;
        const storedLanguage = localStorage.getItem(languageKey);
        const language = storedLanguage === 'el' ? 'el' : 'en';

        document.documentElement.dataset.uiTheme = theme;
        document.documentElement.dataset.uiLanguage = language;
        document.documentElement.lang = language;

        /*
         * Restore development-debugger geometry before first paint. The state is
         * keyed by this UI-server boot id, so an ordinary reload/navigation keeps
         * the debugger stable while a server restart naturally resets it.
         */
        const bootId =
          document
            .querySelector('meta[name="manatos-ui-boot-id"]')
            ?.getAttribute('content') ||
          'unknown';
        const debugVisible =
          sessionStorage.getItem(`manatos.debug.panel.visible.${bootId}`) === 'true';
        const debugState = JSON.parse(
          sessionStorage.getItem(`manatos.debug.ctx.state.v1.${bootId}`) || 'null',
        );

        document.documentElement.dataset.manatosDebugVisible = String(debugVisible);

        /*
         * CTX Viewer and API Traffic are tabs of one developer-tools dock.
         * Restore only the outer dock geometry here; individual tools must not
         * participate in shell layout or maintain independent dock widths.
         */
        const developerToolTab =
          localStorage.getItem('manatos.debug.activeTab.v1') === 'apiTraffic'
            ? 'apiTraffic'
            : 'ctx';
        document.documentElement.dataset.manatosDebugTab = developerToolTab;

        const developerDockWidth = Number(
          sessionStorage.getItem(`manatos.debug.developerDock.width.${bootId}`),
        );
        if (Number.isFinite(developerDockWidth) && developerDockWidth >= 320) {
          document.documentElement.style.setProperty(
            '--manatos-debug-width',
            `${developerDockWidth}px`,
          );
        }

        /*
         * The shell-level CTX CLI is developer-shell state, not page state.
         * Persist it under the same server-boot identity so full navigation and
         * reloads keep it open, while restarting the UI server resets it.
         */
        const debugCliOpen =
          localStorage.getItem(`manatos.debug.cli.open.ctx-viewer.${bootId}`) === 'true';
        document.documentElement.dataset.manatosDebugCliOpen = String(debugCliOpen);

        if (Number.isFinite(debugState?.debuggerWidth)) {
          document.documentElement.style.setProperty(
            '--manatos-debug-width',
            `${debugState.debuggerWidth}px`,
          );
        }

        if (debugState?.propertiesOpen === true) {
          document.documentElement.dataset.manatosDebugPropertiesOpen = 'true';
          if (Number.isFinite(debugState?.propertiesHeight)) {
            document.documentElement.style.setProperty(
              '--manatos-debug-properties-height',
              `${debugState.propertiesHeight}px`,
            );
          }
        }
      } catch {
        document.documentElement.dataset.uiTheme = 'darker';
        document.documentElement.dataset.uiLanguage = 'en';
        document.documentElement.lang = 'en';
      }
    })();
  </script>


  <!-- =========================================================
       Styles
       ========================================================= -->

  <link
    rel="stylesheet"
    href="/vendor/bootstrap/css/bootstrap.min.css"
  >

  <link
    rel="stylesheet"
    href="/vendor/bootstrap-icons/bootstrap-icons.css"
  >

  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <% if (app.ui?.debugTools) { %><link rel="stylesheet" href="/css/debugger/ctx-debug.css"><% } %>
  <link rel="stylesheet" href="/css/ui.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/pages.css">
  <% if (app.currentPlatform?.presentation?.stylesheet) { %>
    <link rel="stylesheet" href="<%= app.currentPlatform.presentation.stylesheet %>">
  <% } %>

  <% if (typeof entryPopupHost !== 'undefined' && entryPopupHost) { %>
    <style>
      /*
       * Hosted entry popups do not render page-navigation chrome at all.
       * These rules now only normalize the remaining content workspace inside
       * the iframe; they are not responsible for hiding shell components.
       */
      body.entry-popup-host .app-shell { display: block !important; min-height: 100vh; }
      body.entry-popup-host .workspace { width: 100% !important; max-width: none !important; }
      body.entry-popup-host .workspace-content { padding: 1rem !important; }
    </style>
  <% } %>
</head>


<body
  class="<%= currentUser ? 'authenticated' : 'anonymous' %> <%= typeof entryPopupHost !== 'undefined' && entryPopupHost ? 'entry-popup-host' : '' %>"
  data-user-id="<%= currentUser?.id || 'anonymous' %>"
>
  <%
    /*
     * Host composition is a presentation concern, not an entity concern.
     * Normal pages render application chrome and shell-owned workspace framing.
     * Hosted entry popups render only their hosted content inside the workspace;
     * popup caption/lifecycle belong to the outer PopupHost.
     */
    const isEntryPopupHost = typeof entryPopupHost !== 'undefined' && entryPopupHost;
    const contentOwnsWorkspaceFrame =
      typeof workspaceFrameOwner === 'string' && workspaceFrameOwner === 'content';
  %>

  <div class="site-frame">

    <% if (!isEntryPopupHost) { %>
      <%- include('../components/layout/header') %>
      <%- include('../components/navigation/horizontal-nav') %>
    <% } %>


    <!-- =========================================================
         Adaptive application shell

         The shell itself owns the layout state.

         Possible states:

           no classes
             Main workspace only.

           has-left-nav
             Left navigation + workspace.

           has-details
             Workspace + Details panel.

           has-left-nav has-details
             Left navigation + workspace + Details.

         This means hidden/absent side areas consume NO horizontal space.
         ========================================================= -->

    <main
      id="appShell"
      class="app-shell <%= currentUser ? 'has-left-nav' : '' %>"
      data-navigation-state-persistence="<%= app.ui.navigationStatePersistence %>"
    >

      <% if (currentUser && !isEntryPopupHost) { %>

        <!-- =====================================================
             Left application navigation
             ===================================================== -->

        <aside
          class="left-navigation"
          id="leftNavigation"
          aria-label="Application navigation"
        >

          <!--
            Keep the collapse control outside/above the Workspace caption.
            It is a shell control, not a navigation entry.
          -->
          <div class="left-navigation-controls">
            <button
              type="button"
              class="btn btn-sm btn-outline-secondary navigation-collapse-button"
              id="collapseLeftNavigation"
              title="Collapse navigation"
              aria-label="Collapse application navigation"
              aria-controls="leftNavigation"
              aria-expanded="true"
            >
              <i class="bi bi-chevron-left"></i>
            </button>
          </div>

          <div class="left-navigation-heading">
            <span>Workspace</span>
          </div>

          <div class="left-navigation-main">
            <%- include('../components/navigation/vertical-nav',
              {
                items: app.navigation.vertical.filter((item) => !item.dockBottom),
                level: 0
              }
            ) %>
          </div>

          <div class="left-navigation-bottom">
            <%- include('../components/navigation/vertical-nav',
              {
                items: app.navigation.vertical.filter((item) => item.dockBottom),
                level: 0
              }
            ) %>
          </div>

        </aside>


        <!-- =====================================================
             Small restore button shown when navigation is collapsed.

             It deliberately lives outside leftNavigation because
             leftNavigation itself becomes hidden.
             ===================================================== -->

        <button
          type="button"
          class="btn btn-outline-secondary left-navigation-restore d-none"
          id="restoreLeftNavigation"
          title="Show navigation"
          aria-label="Show application navigation"
          aria-controls="leftNavigation"
          aria-expanded="false"
        >
          <i class="bi bi-layout-sidebar-inset"></i>
        </button>

      <% } %>


      <!-- =======================================================
           Main workspace
           ======================================================= -->

      <section class="workspace">

        <!--
          Breadcrumbs and workspace actions form the context/action row above
          the coloured page-title surface. The Details control therefore sits
          outside the caption panel and remains aligned to the workspace's
          far-right edge.
        -->
        <% if (!isEntryPopupHost) { %>
        <div class="workspace-heading-row">

          <nav
            class="page-breadcrumb workspace-breadcrumb"
            aria-label="Breadcrumb"
          >
            <%
              /*
               * CTX owns logical page nesting, so breadcrumbs are projected from
               * the CTX page chain rather than rebuilt independently from routes.
               * The fallback keeps routes that do not provide a page CTX resilient
               * without making route structure a second breadcrumb authority.
               */
              const ctxBreadcrumb = Array.isArray(breadcrumbItems) && breadcrumbItems.length
                ? breadcrumbItems
                : [
                    { label: 'ManatOS', href: '/' },
                    {
                      label: (typeof breadcrumbTitle === 'string' && breadcrumbTitle)
                        ? breadcrumbTitle
                        : (title || 'Home'),
                      href: null,
                    },
                  ];
            %>
            <% for (let breadcrumbIndex = 0; breadcrumbIndex < ctxBreadcrumb.length; breadcrumbIndex += 1) { %>
              <% const breadcrumb = ctxBreadcrumb[breadcrumbIndex]; %>
              <% if (breadcrumbIndex > 0) { %>
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
              <% } %>
              <% if (breadcrumb.href && breadcrumbIndex < ctxBreadcrumb.length - 1) { %>
                <a href="<%= breadcrumb.href %>"><%= breadcrumb.label %></a>
              <% } else { %>
                <span<%= breadcrumbIndex === ctxBreadcrumb.length - 1 ? ' aria-current="page"' : '' %>><%= breadcrumb.label %></span>
              <% } %>
            <% } %>
          </nav>


          <% if (currentUser) { %>

            <div class="workspace-heading-actions">

              <!--
                Opens/closes the optional right Details panel.

                When closed, the Details column disappears completely
                and the workspace expands into its area.
              -->
              <button
                class="btn btn-outline-secondary btn-sm details-toggle"
                id="toggleDetailsPanel"
                type="button"
                aria-controls="detailsPanel"
                aria-expanded="false"
              >
                <i class="bi bi-layout-sidebar-reverse me-1"></i>

                Details
              </button>

            </div>

          <% } %>

        </div>
        <% } %>


        <% if (contentOwnsWorkspaceFrame) { %>
          <%- body %>
        <% } else { %>
          <%- include('../components/page/titlebar') %>


          <div class="workspace-content">
            <%- body %>
          </div>
        <% } %>

        <% if (app.ui?.debugTools && !isEntryPopupHost) { %>
          <%- include('../components/debugging/debugging-cli', {
            instanceKey: 'ctx-viewer',
            startPath: 'ctx',
            csrfToken,
            docked: true,
          }) %>
        <% } %>

      </section>


      <% if (currentUser && !isEntryPopupHost) { %>

        <!-- =====================================================
             Optional contextual Details panel
             ===================================================== -->

        <aside
          class="details-panel d-none"
          id="detailsPanel"
          aria-label="Context details"
          aria-hidden="true"
        >

          <div class="details-panel-heading">

            <div>

              <span class="eyebrow">
                Context
              </span>

              <h2>
                Details
              </h2>

            </div>


            <button
              class="btn-close"
              type="button"
              id="closeDetailsPanel"
              aria-label="Close Details panel"
            ></button>

          </div>


          <div class="details-card">

            <% if (app.scopes.workspace.application) { %>

              <span class="details-label">
                Active application
              </span>

              <strong>
                <%= app.scopes.workspace.application.sysApplication.name %>
              </strong>

            <% } else { %>

              <i class="bi bi-info-circle me-1"></i>

              Contextual page information will appear here when required.

            <% } %>

          </div>

        </aside>

      <% } %>


      <% if (app.ui?.debugTools && !isEntryPopupHost) { %>
        <%- include('../components/debugging/developer-tools') %>
      <% } %>

    </main>


    <% if (!isEntryPopupHost) { %>
      <%- include('../components/layout/footer') %>
    <% } %>

  </div>


  <%- include('../popups/auth/auth-modals') %>

  <%- include('../popups/messages/message-modals') %>

  <%- include('../popups/preferences/preferences-modal') %>

  <%- include('../components/layout/busy-overlay') %>


  <script
    src="/vendor/bootstrap/js/bootstrap.bundle.min.js"
  ></script>

  <script src="/js/shell/preferences.js"></script>
  <script src="/js/shell/shell.js"></script>
  <script src="/js/popups/entry-popup.js"></script>
  <% if (app.ui?.debugTools && Array.isArray(ctxDiagnostics) && ctxDiagnostics.length) { %>
    <script>
      (() => {
        const diagnostics = <%- JSON.stringify(ctxDiagnostics).replace(/</g, '\\u003c') %>;
        for (const diagnostic of diagnostics) {
          window.dispatchEvent(new CustomEvent('manatos:ctx-diagnostic', { detail: diagnostic }));
        }
      })();
    </script>
  <% } %>
  <script id="manatosCtxSnapshot" type="application/json"><%- JSON.stringify(typeof browserCtx !== 'undefined' ? browserCtx : null).replace(/</g, '\\u003c') %></script>
  <script id="manatosUiBootstrap" type="application/json"><%- JSON.stringify(typeof uiBootstrap !== 'undefined' ? uiBootstrap : null).replace(/</g, '\\u003c') %></script>
  <script src="/js/runtime/ui-host-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/runtime/context-runtime.js"></script>
  <script src="/js/shell/system-connectivity.js"></script>
  <script src="/js/runtime/bootstrap-runtime.js"></script>
  <% if (app.ui?.debugTools) { %>
    <script src="/js/debugger/expression-format.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
    <script src="/js/debugger/ctx-debug.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
    <script src="/js/debugger/ctx-target-views.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
    <script src="/js/debugger/api-traffic.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
    <script src="/js/debugger/detached-tools.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <% } %>
  <script src="/js/sysbo/list/list-runtime.js"></script>
  <!--
    Popup lifecycle must be installed before any script can auto-show a modal.
    busy.js owns data-auto-show bootstrapping, so loading popup-runtime first
    guarantees every initially visible popup receives its canonical CTX envelope,
    CTX inspection action, explicit-dismissal policy and workspace centering.
  -->
  <script src="/js/popups/popup-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/shell/busy.js"></script>
  <script src="/js/runtime/expression-compiler-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/form-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/runtime/entry-policy-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/runtime/list-action-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/auth/auth-form.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/state.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/field-state.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/save.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/focus.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/configuration/form.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/entry-representation.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/popups/record-selector.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/debugger/cli.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/entry/field-runtime.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/auth/external-provider.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/hierarchy/hierarchy-tree.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/sysbo/hierarchy/hierarchy-workspace.js?boot=<%= typeof uiBootId !== 'undefined' ? encodeURIComponent(uiBootId) : 'unknown' %>"></script>
  <script src="/js/auth/providers.js"></script>

</body>

</html>
