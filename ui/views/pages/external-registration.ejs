<%
  const provider =
    authProviders.find((candidate) => candidate.key === profile.provider) || {
      label: profile.provider,
      icon: 'bi-box-arrow-in-right'
    };
%>

<section class="content-card col-xl-7">
  <h2>Complete external registration</h2>
  <p class="text-secondary">
    <strong><%= provider.label %></strong> authenticated this email address. Choose a unique user name. A local
    password is optional.
  </p>
  <form method="post" action="/auth/register/external">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><label class="form-label"
      >Email</label
    ><input class="form-control mb-3" value="<%= profile.email %>" readonly /><label
      class="form-label"
      >User name</label
    ><input
      class="form-control mb-3"
      name="name"
      value="<%= profile.userName || '' %>"
      required
      minlength="2"
    /><label class="form-label"
      >Local password (optional)</label
    ><input class="form-control password-policy-input" name="password" type="password" /><label
      class="form-label mt-3"
      >Confirm password</label
    ><input class="form-control" name="confirmPassword" type="password" /><%-
    include('../partials/password-rules') %>
    <div class="mt-4 d-flex gap-2">
      <a class="btn btn-secondary" href="/">Cancel</a
      ><button class="btn btn-primary">Create account</button>
    </div>
  </form>
</section>
