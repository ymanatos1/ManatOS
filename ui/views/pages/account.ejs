<section class="content-card"><h2>Account details</h2><dl class="row"><dt class="col-sm-3">User name</dt><dd class="col-sm-9"><%= currentUser.name %></dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9"><%= currentUser.email %> <span class="badge text-bg-<%= currentUser.emailVerified?'success':'warning' %>"><%= currentUser.emailVerified?'Verified':'Not verified' %></span></dd><dt class="col-sm-3">Website role</dt><dd class="col-sm-9"><%= currentUser.role %></dd><dt class="col-sm-3">Local password</dt><dd class="col-sm-9"><%= currentUser.hasPassword?'Configured':'Not configured' %></dd></dl><hr><h3 class="h5"><%= currentUser.hasPassword?'Set a new password':'Set local password' %></h3><form method="post" action="/account/password" class="col-lg-6"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">New password</label><input class="form-control password-policy-input" type="password" name="password" required><label class="form-label mt-3">Confirm password</label><input class="form-control" type="password" name="confirmPassword" required><%- include('../partials/password-rules') %><button class="btn btn-primary mt-3"><i class="bi bi-key me-1"></i><%= currentUser.hasPassword?'Change password':'Set password' %></button></form></section>
