<section class="password-page">
  <div class="form-section-header">
    <h2 class="h5 mb-1">
      <%= currentUser.hasPassword ? 'Change local password' : 'Set local password' %>
    </h2>
    <p class="text-secondary mb-0">
      <%= currentUser.hasPassword
        ? 'Enter your current password, then choose and confirm the new password.'
        : 'Create a local password so this account can also sign in with email or user name.' %>
    </p>
  </div>

  <form
    method="post"
    action="/account/password"
    class="form-narrow mt-4 password-form"
    data-password-form="true"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <% if (currentUser.hasPassword) { %>
      <label class="form-label" for="currentPassword">Current password</label>
      <input
        class="form-control mb-3"
        id="currentPassword"
        type="password"
        name="currentPassword"
        autocomplete="current-password"
        required
      >
    <% } %>

    <label class="form-label" for="newPassword">New password</label>
    <input
      class="form-control password-policy-input"
      id="newPassword"
      type="password"
      name="password"
      autocomplete="new-password"
      required
    >

    <label class="form-label mt-3" for="confirmPassword">Confirm password</label>
    <input
      class="form-control"
      id="confirmPassword"
      type="password"
      name="confirmPassword"
      autocomplete="new-password"
      required
      data-password-confirmation
    >

    <%- include('../partials/password-rules', { includeMatchRule: true }) %>

    <div class="password-form-actions mt-3">
      <button
        class="btn btn-primary"
        type="submit"
        data-password-submit
        disabled
      >
        <i class="bi bi-key me-1"></i>
        <%= currentUser.hasPassword ? 'Change password' : 'Set password' %>
      </button>

      <a class="btn btn-outline-secondary" href="/account">
        Cancel
      </a>
    </div>
  </form>
</section>
