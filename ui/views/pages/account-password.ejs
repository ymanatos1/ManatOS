<%#
  Authenticated local-password popup.

  The same rich popup supports both "set" and "change" modes. changingPassword controls the
  presence of the current-password field and related copy, while the shared popup components
  preserve the same header/hero/footer and password-guidance structure used by recovery.
%>
<%
  const changingPassword = Boolean(currentUser.hasPassword);
  const passwordPopup = changingPassword
    ? popupContent.auth.accountPassword.change
    : popupContent.auth.accountPassword.set;
  const modalTitle = passwordPopup.modalTitle;
%>

<div
  class="modal fade auth-primary-modal auth-password-modal"
  id="accountPasswordModal"
    data-popup-purpose="account-password"
    data-popup-kind="auth-modal"
    data-popup-presentation="rich"
  tabindex="-1"
  aria-labelledby="accountPasswordModalLabel"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered auth-modal-dialog auth-password-form-dialog">
    <form
      class="modal-content password-form"
      method="post"
      action="/account/password"
      data-password-form="true"
      data-busy-submit
      data-busy-title="<%= changingPassword ? 'Changing your password…' : 'Setting your password…' %>"
      data-busy-message="Please wait while the new password is saved securely."
      data-busy-icon="bi-key"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <%- include('../popups/shared/popup-header', {
        labelId: 'accountPasswordModalLabel',
        icon: 'bi-key',
        modalTitle,
        modalSubtitle: passwordPopup.modalSubtitle,
        closeHref: '/account'
      }) %>

      <div class="modal-body auth-primary-modal-body auth-password-modal-body">
        <%- include('../popups/shared/rich-popup-hero', {
          introClass: 'auth-email-registration-intro auth-password-intro',
          illustration: { kind: 'static', name: 'password' },
          contentTitle: passwordPopup.contentTitle,
          contentParagraphs: passwordPopup.contentParagraphs
        }) %>

        <section class="auth-registration-form-card" aria-labelledby="accountPasswordDetailsHeading">
          <div class="auth-modal-section-heading" id="accountPasswordDetailsHeading">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            Password details
          </div>

          <div class="auth-password-fields">
            <% if (changingPassword) { %>
              <div class="auth-password-current-fields">
                <div>
                  <label class="form-label" for="accountUserName">User name</label>
                  <input
                    class="form-control"
                    id="accountUserName"
                    type="text"
                    value="<%= currentUser.name %>"
                    autocomplete="username"
                    readonly
                    aria-readonly="true"
                  >
                </div>

                <div>
                  <label class="form-label" for="currentPassword">Current password</label>
                  <input
                    class="form-control"
                    id="currentPassword"
                    type="password"
                    name="currentPassword"
                    autocomplete="current-password"
                    required
                    autofocus
                  >
                </div>
              </div>
            <% } %>

            <div class="auth-password-new-fields">
              <div>
                <label class="form-label" for="newPassword">New password</label>
                <input
                  class="form-control password-policy-input"
                  id="newPassword"
                  type="password"
                  name="password"
                  autocomplete="new-password"
                  required
                  <%= changingPassword ? '' : 'autofocus' %>
                >
              </div>

              <div>
                <label class="form-label" for="confirmPassword">Confirm password</label>
                <input
                  class="form-control"
                  id="confirmPassword"
                  type="password"
                  name="confirmPassword"
                  autocomplete="new-password"
                  required
                  data-password-confirmation
                >
              </div>
            </div>

            <div class="auth-password-guidance">
              <div class="auth-password-guidance-title">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                Choose a secure password
              </div>
              <%- include('../components/auth/password-rules', { includeMatchRule: true }) %>
            </div>
          </div>
        </section>
      </div>

      <%- include('../popups/shared/popup-footer', {
        footerClass: 'auth-password-modal-footer',
        leftActions: [{ label: 'Back', icon: 'bi-arrow-left', variant: 'btn-outline-secondary', href: '/account' }],
        rightActions: [{ label: modalTitle, icon: 'bi-key', variant: 'btn-primary', type: 'submit', disabled: true, data: { 'password-submit': '' } }]
      }) %>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('accountPasswordModal');
    if (!element || typeof bootstrap === 'undefined') return;
    bootstrap.Modal.getOrCreateInstance(element).show();
  });
</script>
