<%
  const changingPassword = Boolean(currentUser.hasPassword);
  const modalTitle = changingPassword ? 'Change password' : 'Set password';
%>

<div
  class="modal fade auth-primary-modal auth-password-modal"
  id="accountPasswordModal"
  tabindex="-1"
  aria-labelledby="accountPasswordModalLabel"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered auth-modal-dialog auth-password-form-dialog">
    <form
      class="modal-content password-form"
      method="post"
      action="/account/password"
      data-password-form="true"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="modal-header">
        <div>
          <h2 class="modal-title h4 mb-1" id="accountPasswordModalLabel">
            <i class="bi bi-key me-2" aria-hidden="true"></i>
            <%= modalTitle %>
          </h2>
          <p class="modal-subtitle mb-0">
            <%= changingPassword
              ? 'Confirm your current password, then choose a new secure password.'
              : 'Create a local password for your ManatOS account.' %>
          </p>
        </div>
        <a class="btn-close" href="/account" aria-label="Close"></a>
      </div>

      <div class="modal-body auth-primary-modal-body auth-password-modal-body">
        <div class="auth-email-registration-intro auth-password-intro">
          <%- include('../partials/auth/auth-entry-illustration', { mode: 'password' }) %>

          <div class="auth-entry-copy">
            <h3><%= changingPassword ? 'Secure your account' : 'Create your password' %></h3>
            <p class="mb-0">
              <%= changingPassword
                ? 'Enter your current password and choose a replacement that satisfies all password rules.'
                : 'Choose and confirm a password that satisfies all ManatOS password rules.' %>
            </p>
          </div>
        </div>

        <section class="auth-registration-form-card" aria-labelledby="accountPasswordDetailsHeading">
          <div class="auth-modal-section-heading" id="accountPasswordDetailsHeading">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            Password details
          </div>

          <div class="auth-password-fields">
            <% if (changingPassword) { %>
              <div class="auth-password-current-field">
                <label class="form-label" for="currentPassword">Current password</label>
                <input
                  class="form-control"
                  id="currentPassword"
                  type="password"
                  name="currentPassword"
                  autocomplete="current-password"
                  required
                  autofocus
                >
              </div>
            <% } %>

            <div class="auth-password-new-fields">
              <div>
                <label class="form-label" for="newPassword">New password</label>
                <input
                  class="form-control password-policy-input"
                  id="newPassword"
                  type="password"
                  name="password"
                  autocomplete="new-password"
                  required
                  <%= changingPassword ? '' : 'autofocus' %>
                >
              </div>

              <div>
                <label class="form-label" for="confirmPassword">Confirm password</label>
                <input
                  class="form-control"
                  id="confirmPassword"
                  type="password"
                  name="confirmPassword"
                  autocomplete="new-password"
                  required
                  data-password-confirmation
                >
              </div>
            </div>

            <%- include('../partials/password-rules', { includeMatchRule: true }) %>
          </div>
        </section>
      </div>

      <div class="modal-footer auth-password-modal-footer">
        <a class="btn btn-outline-secondary" href="/account">
          <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
          Back
        </a>

        <button
          class="btn btn-primary"
          type="submit"
          data-password-submit
          disabled
        >
          <i class="bi bi-key me-1" aria-hidden="true"></i>
          <%= changingPassword ? 'Change password' : 'Set password' %>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('accountPasswordModal');
    if (!element || typeof bootstrap === 'undefined') return;
    bootstrap.Modal.getOrCreateInstance(element).show();
  });
</script>
