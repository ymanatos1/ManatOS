<section class="content-card"><h2>Personal details</h2><p class="text-secondary">Optional profile information can be completed after registration and changed later.</p><form method="post" action="/personal" class="col-xl-7"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="form-label">First name</label><input class="form-control mb-3" name="firstName" value="<%= currentUser.firstName || '' %>"><label class="form-label">Last name</label><input class="form-control mb-3" name="lastName" value="<%= currentUser.lastName || '' %>"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="4"><%= currentUser.description || '' %></textarea><button class="btn btn-primary mt-3"><i class="bi bi-check-circle me-1"></i>Save</button></form></section>
