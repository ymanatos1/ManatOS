<%
  /*
   * Canonical calendar-duration editor. One hidden canonical field carries the
   * structured CTX/form value; the visible year/month/day controls are merely a
   * convenient editor for that one field and never become independent BO fields.
   */
  const duration = durationParts(value);
  const units = Array.isArray(field.durationUnits) && field.durationUnits.length
    ? field.durationUnits
    : ['years', 'months', 'days'];
  const serializedDuration = durationSerializedValue(value);
%>
<div
  class="metadata-duration-field"
  data-duration-field
  data-duration-field-key="<%= key %>"
  data-duration-nullable="<%= field.nullable ? 'true' : 'false' %>"
>
  <div class="input-group metadata-field-input" data-enhanced-field-input data-field-component="duration">
    <button class="btn metadata-field-input-menu-toggle <%= editable ? 'is-enabled' : 'is-readonly' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Duration field tools" aria-label="Duration field tools for <%= fieldLabel(field) %>"><i class="bi bi-hourglass-split" aria-hidden="true"></i></button>
    <input
      type="hidden"
      id="metadata-field-<%= key %>"
      name="<%= key %>"
      value="<%= serializedDuration %>"
      data-ctx-field="<%= key %>"
      data-ctx-value-type="duration"
      data-duration-canonical-value
    >
    <div class="form-control metadata-duration-editor <%= editable ? '' : 'is-readonly' %>" data-duration-editor>
      <% for (const unit of units) { %>
        <label class="metadata-duration-part">
          <span><%= unit === 'years' ? 'Years' : unit === 'months' ? 'Months' : 'Days' %></span>
          <input
            class="form-control form-control-sm"
            type="number"
            min="0"
            step="1"
            inputmode="numeric"
            value="<%= duration[unit] ?? '' %>"
            data-duration-part="<%= unit %>"
            aria-label="<%= fieldLabel(field) %> <%= unit %>"
            <%= editable ? '' : 'readonly' %>
          >
        </label>
      <% } %>
    </div>
    <%- include('field-tools-menu', { key, editable, actions: [
      { action: 'duration-zero', icon: '0-circle', label: 'Set zero duration' },
      { action: 'clear', icon: 'eraser', label: 'Clear duration' },
    ] }) %>
  </div>
</div>
