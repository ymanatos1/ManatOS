<%
  /*
   * Generic three-field calendar validity layout. This component deliberately
   * owns presentation only: every value is rendered by its canonical field
   * component and all calculation/CTX semantics remain on the fields themselves.
   *
   * Row 1 keeps the start date beside the (naturally capped) Duration editor;
   * row 2 carries the end date. This preserves the visual relationship while
   * giving the structured Duration enough room without stretching it across the
   * complete entity form.
   */
  const options = component?.options || {};
  const startField = String(options.startField || '');
  const durationField = String(options.durationField || '');
  const endField = String(options.endField || '');
%>
<div
  class="metadata-date-duration-range"
  data-date-duration-range
  data-start-field="<%= startField %>"
  data-duration-field-key="<%= durationField %>"
  data-end-field="<%= endField %>"
  data-authoritative-field=""
>
  <div class="row g-3 metadata-date-duration-range-primary">
    <% if (startField) { %>
      <%- include('../field-components/form-field', { ...fieldComponentContext, key: startField, span: 6 }) %>
    <% } %>
    <% if (durationField) { %>
      <%- include('../field-components/form-field', { ...fieldComponentContext, key: durationField, span: 6 }) %>
    <% } %>
  </div>
  <% if (endField) { %>
    <div class="row g-3 mt-0 metadata-date-duration-range-end">
      <%- include('../field-components/form-field', { ...fieldComponentContext, key: endField, span: 6 }) %>
    </div>
  <% } %>
</div>
