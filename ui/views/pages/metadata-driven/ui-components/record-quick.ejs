<%
  /*
   * Generic compact owner-managed record editor. `recordQuick` chooses the
   * fields, while the canonical field-components render their controls. The
   * editor deliberately does not bind controls directly to CTX: its owner
   * commits the complete draft atomically into its working entries[] graph.
   */
  const quick = metadataUI && metadataUI.recordQuick;
  const quickContent = quick && Array.isArray(quick.content) ? quick.content : [];
  const quickFieldLabel = (field) => field?.label || field?.name || '';
  const quickEnumItemsFor = (field) => Array.isArray(field?.enumItems) ? field.enumItems : [];
  const emptyReferences = {};
  const emptyReferenceIcons = {};
  const quickDateOnlyValue = (value) => value == null ? '' : String(value).slice(0, 10);
  const quickDatetimeLocalValue = (value) => value == null ? '' : String(value).slice(0, 16);
  const quickDurationParts = () => ({});
  const quickDurationSerializedValue = (value) => value == null ? '' : String(value);
  const quickDefaultValue = (key, field) => {
    const declared = quick?.fieldOverrides?.[key]?.createDefaultValue;
    if (declared === null || ['string', 'number', 'boolean'].includes(typeof declared)) return declared;
    return field?.defaultValue ?? '';
  };
  const quickEntityName = String(metadata?.name || 'entry');
  const quickCreateTitle = `Create ${quickEntityName.charAt(0).toLowerCase()}${quickEntityName.slice(1)}`;
%>
<% if (quickContent.length) { %>
  <div class="card shadow-sm metadata-record-quick" data-record-quick>
    <div class="card-header py-2 fw-semibold metadata-record-quick-title" data-record-quick-title><%= quickCreateTitle %></div>
    <div class="card-body p-3">
      <div class="row g-2">
        <% for (const content of quickContent) { %>
          <% if (content.kind === 'field') { %>
            <% const key = content.field; const field = metadata.fieldDefinition[key]; const quickValue = quickDraft?.[key] ?? quickDefaultValue(key, field); %>
            <% if (field && !field.sensitive) { %>
              <div class="col-12 col-md-<%= Number(content.span || 12) %>">
                <label class="form-label small fw-semibold" for="record-quick-<%= key %>"><%= quickFieldLabel(field) %>:<% if (field.required) { %><span class="metadata-field-required-marker" aria-label="required"> (*)</span><% } %></label>
                <div data-record-quick-field="<%= key %>">
                  <%- include('../field-components/entity-field', {
                    key, field, value: quickValue, editable: true,
                    fieldLabel: quickFieldLabel, enumItemsFor: quickEnumItemsFor,
                    referenceValues: emptyReferences, referenceEntityIcons: emptyReferenceIcons,
                    dateOnlyValue: quickDateOnlyValue, datetimeLocalValue: quickDatetimeLocalValue,
                    durationParts: quickDurationParts, durationSerializedValue: quickDurationSerializedValue,
                    bindCtx: false, inputId: `record-quick-${key}`, inputName: key
                  }) %>
                </div>
              </div>
            <% } %>
          <% } %>
        <% } %>
      </div>
      <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
        <span class="small text-secondary me-auto" data-record-quick-state>No changes</span>
        <button type="button" class="btn btn-outline-secondary" data-record-quick-cancel>Cancel</button>
        <button type="button" class="btn btn-primary" data-record-quick-commit disabled>Save</button>
      </div>
    </div>
  </div>
<% } %>
