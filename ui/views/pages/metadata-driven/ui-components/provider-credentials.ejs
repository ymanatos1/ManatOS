<%
  const provider = String(credentialTest?.provider || item.provider || '').toLowerCase();
  const providerDefinitions = externalAuthProviderDefinitions || [];
  const storedVerified = item.credentialsVerified === true;
  const hasStoredSecret = item.hasClientSecret === true;
  const pendingStatus = credentialTest?.status || null;
  const pendingVerified = pendingStatus === 'verified' && credentialTest?.hasPendingSecret;
  // A provider with no complete stored pair should already be in credential-edit
  // mode. Requiring an extra 'Change credentials' click after removal creates a
  // false read-only state around values that do not exist.
  const hasStoredPair = Boolean(item.clientId) && hasStoredSecret;
  const credentialChangeVisible = !pendingVerified && (isNew || pendingStatus === 'failed' || !hasStoredPair);
  const displayedClientId = credentialTest?.clientId || item.clientId || '';
  const displayedVerified = pendingVerified || (!credentialChangeVisible && storedVerified);
  const canTestStoredCredentials = !isNew && !storedVerified && hasStoredPair && !credentialChangeVisible;
%>
<div
  class="row g-3"
  data-ext-auth-provider-secrets
  data-stored-credentials-verified="<%= storedVerified ? 'true' : 'false' %>"
>
  <input
    type="hidden"
    value="<%= pendingVerified ? 'verified' : (credentialChangeVisible ? 'required' : (storedVerified ? 'stored-verified' : 'stored-unverified')) %>"
    data-provider-credential-test-state
  >
  <input
    type="hidden"
    value="<%= pendingVerified ? 'true' : 'false' %>"
    data-provider-pending-credential-save
  >
  <input
    type="hidden"
    name="providerCredentialMutation"
    value="<%= pendingVerified || pendingStatus === 'failed' ? 'true' : 'false' %>"
    data-provider-credential-mutation
  >

  <% if (!isNew) { %>
    <%
      const credentialStatusPanel = pendingVerified
        ? {
            tone: 'success',
            icon: 'check-circle-fill',
            title: 'New credentials tested successfully',
            text: 'The tested Client ID and Client secret are held securely in this server session. Click Save to replace the stored credential pair.',
          }
        : storedVerified
          ? {
              tone: 'success',
              icon: 'check-circle-fill',
              title: 'Credentials verified',
              text: `Client ID and Client secret are stored and were successfully tested${item.credentialsVerifiedAt ? ` on ${new Date(item.credentialsVerifiedAt).toLocaleString()}` : ''}. The plaintext secret is intentionally never returned to the UI.`,
            }
          : hasStoredPair
            ? {
                tone: 'warning',
                icon: 'exclamation-triangle-fill',
                title: 'Credentials stored, not verified',
                text: 'Client ID and Client secret are stored securely, but this credential pair has not passed provider verification. You can test the stored pair without re-entering it. Until verification succeeds, the provider is treated as not configured for sign-in.',
              }
            : {
                tone: 'info',
                icon: 'info-circle-fill',
                title: 'No credentials stored',
                text: 'Enter a Client ID and Client secret, then test or save the pair. The provider remains unavailable for sign-in until a stored credential pair is successfully verified.',
              };
    %>
    <div class="col-12">
      <%- include('information-panel', { panel: { ...credentialStatusPanel, id: 'provider-credential-status' } }) %>
    </div>
  <% } %>

  <% if (pendingStatus === 'failed') { %>
    <div class="col-12">
      <%- include('information-panel', {
        panel: {
          id: 'provider-credential-test-failed',
          tone: 'danger',
          icon: 'x-circle-fill',
          title: 'Credential test failed',
          text: `${credentialTest.errorMessage || 'The provider rejected the proposed Client ID / Client secret pair.'} You may correct and test the pair again, or save it securely as unverified and return to verification later.`,
        },
      }) %>
    </div>
  <% } %>

  <div class="col-md-6">
    <% const clientIdField = metadata.fieldDefinition.clientId || { key: 'clientId', label: 'Client ID', type: 'string', required: true, maxLength: 500 }; %>
    <label class="form-label" for="clientId">Client ID:</label>
    <%- include('../field-components/text-field', {
      key: 'clientId',
      field: { ...clientIdField, required: credentialChangeVisible },
      value: displayedClientId,
      editable: credentialChangeVisible && !readOnly,
      controlEditable: credentialChangeVisible && !readOnly,
      inputId: 'clientId',
      inputName: 'clientId',
      inputValue: displayedClientId,
      inputAutocomplete: 'off',
      inputDataAttributes: { 'data-provider-client-id': 'true' },
      fieldLabel,
    }) %>
  </div>

  <div class="col-md-6" data-provider-secret-display <%= credentialChangeVisible ? 'hidden' : '' %>>
    <label class="form-label">Client secret:</label>
    <div class="form-control bg-body-secondary text-secondary" aria-readonly="true">
      <i class="bi <%= hasStoredSecret || pendingVerified ? 'bi-lock-fill' : 'bi-lock' %> me-1"></i>
      <%= pendingVerified
        ? 'New secret tested successfully; ready to save'
        : (hasStoredSecret ? 'Secret stored securely' : 'No secret stored') %>
    </div>
  </div>

  <div class="col-md-6" data-provider-secret-editor <%= credentialChangeVisible ? '' : 'hidden' %>>
    <% const clientSecretField = { key: 'clientSecret', label: 'Client secret', type: 'string', required: credentialChangeVisible, maxLength: 2000 }; %>
    <label class="form-label" for="clientSecret">Client secret:</label>
    <%- include('../field-components/text-field', {
      key: 'clientSecret',
      field: clientSecretField,
      value: '',
      editable: credentialChangeVisible && !readOnly,
      controlEditable: credentialChangeVisible && !readOnly,
      inputTypeOverride: 'password',
      inputId: 'clientSecret',
      inputName: 'clientSecret',
      inputValue: '',
      inputAutocomplete: 'new-password',
      inputDataAttributes: { 'data-provider-client-secret': 'true' },
      // Plaintext Client secret is workflow-local transient state. It must not
      // masquerade as a canonical ctx.page.page.fields member.
      bindCtx: false,
      fieldLabel,
    }) %>
    <div class="form-text">Client ID and Client secret are changed as one credential pair. You may save them securely before testing; the provider is not available for sign-in until the pair is verified.</div>
  </div>

  <div class="col-12 d-flex gap-2 flex-wrap align-items-center" data-provider-credential-actions>
    <% if (!readOnly) { %>
      <% if (!credentialChangeVisible && !pendingVerified) { %>
        <button class="btn btn-outline-primary" type="button" data-provider-change-credentials>
          <i class="bi bi-pencil-square me-1"></i>Change credentials
        </button>
      <% } %>

      <button
        class="btn btn-outline-success"
        type="button"
        data-provider-test-credentials
        data-provider-test-url="/bo/sys-ext-auth-providers/test-credentials"
        data-provider-test-stored="<%= canTestStoredCredentials ? 'true' : 'false' %>"
        <%= credentialChangeVisible || canTestStoredCredentials ? '' : 'hidden' %>
        <%= canTestStoredCredentials ? '' : 'disabled' %>
      >
        <i class="bi bi-check2-circle me-1"></i>Test credentials
      </button>

      <% if (!isNew && (hasStoredSecret || item.clientId)) { %>
        <button
          class="btn btn-outline-danger"
          type="button"
          data-bs-toggle="modal"
          data-bs-target="#removeProviderCredentialsModal"
        >
          <i class="bi bi-key me-1"></i>Remove credentials
        </button>
      <% } %>
    <% } %>

    <div class="d-flex align-items-center gap-2 small" data-provider-credentials-verified-indicator>
      <span class="text-secondary">Credentials verified</span>
      <span class="badge rounded-pill <%= displayedVerified ? 'text-bg-success' : 'text-bg-secondary' %>">
        <i class="bi <%= displayedVerified ? 'bi-check-circle-fill' : 'bi-x-circle' %> me-1"></i><%= displayedVerified ? 'Yes' : 'No' %>
      </span>
    </div>
  </div>

  <% if (!readOnly) { %>
    <div class="col-12">
      <div class="alert alert-danger border small mb-0 w-100" data-provider-credential-test-feedback hidden></div>
    </div>
  <% } %>


</div>
