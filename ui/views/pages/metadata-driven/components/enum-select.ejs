<%
  /*
   * Reusable metadata-driven enum control. The native select remains the
   * submitted value/HTML-validity adapter; the Bootstrap dropdown is only its
   * rich presentation. CTX therefore sees exactly the same field change event
   * regardless of whether a renderer uses this component or a native select.
   */
  const richSelected = enumItems.find((option) => option.value === value);
  const richHasIcons = enumItems.some((option) => typeof option.icon === 'string' && option.icon);
%>
<div class="metadata-enum-select" data-metadata-enum-select>
  <select
    class="visually-hidden"
    id="metadata-field-<%= key %>"
    name="<%= key %>"
    data-ctx-field="<%= key %>"
    data-enum-items="<%= JSON.stringify(enumItems) %>"
    tabindex="-1"
    aria-hidden="true"
    <%= field.required ? 'required' : '' %>
    <%= editable ? '' : 'disabled' %>
  >
    <option value="">Choose...</option>
    <% for (const option of enumItems) { %>
      <option value="<%= option.value %>" data-enum-item="<%= JSON.stringify(option) %>" <%= value === option.value ? 'selected' : '' %>><%= option.label || option.value %></option>
    <% } %>
  </select>

  <button
    type="button"
    class="form-select metadata-enum-select-toggle text-start"
    data-bs-toggle="dropdown"
    data-metadata-enum-toggle
    aria-expanded="false"
    <%= editable ? '' : 'disabled' %>
  >
    <span class="d-flex align-items-center gap-2">
      <% if (richHasIcons) { %><i class="bi bi-<%= richSelected?.icon || 'list' %>" data-enum-selected-icon aria-hidden="true"></i><% } %>
      <span data-enum-selected-label><%= richSelected?.label || richSelected?.value || 'Choose...' %></span>
    </span>
  </button>

  <ul class="dropdown-menu metadata-enum-select-menu w-100" role="listbox">
    <li><button type="button" class="dropdown-item d-flex justify-content-between align-items-center" data-enum-choice="" role="option">Choose...</button></li>
    <% for (const option of enumItems) { %>
      <li>
        <button
          type="button"
          class="dropdown-item d-flex justify-content-between align-items-center <%= value === option.value ? 'active' : '' %>"
          data-enum-choice="<%= option.value %>"
          role="option"
          aria-selected="<%= value === option.value ? 'true' : 'false' %>"
        >
          <span><%= option.label || option.value %></span>
          <% if (option.icon) { %><i class="bi bi-<%= option.icon %> ms-3" aria-hidden="true"></i><% } %>
        </button>
      </li>
    <% } %>
  </ul>
</div>
