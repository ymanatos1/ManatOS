<div
  class="modal fade auth-primary-modal auth-password-modal auth-password-reset-modal"
  id="passwordResetModal"
  tabindex="-1"
  aria-labelledby="passwordResetModalLabel"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered auth-modal-dialog auth-password-form-dialog">
    <% if (tokenInfo) { %>
      <form
        class="modal-content password-form"
        method="post"
        action="/auth/password/reset"
        data-password-form="true"
        data-busy-submit
        data-busy-title="Setting your password…"
        data-busy-message="Please wait while the new password is saved securely."
        data-busy-icon="bi-key"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">

        <div class="modal-header">
          <div>
            <h2 class="modal-title h4 mb-1" id="passwordResetModalLabel">
              <i class="bi bi-key me-2" aria-hidden="true"></i>
              Set or reset password
            </h2>
            <p class="modal-subtitle mb-0">
              Choose a new secure password for your account.
            </p>
          </div>
          <a class="btn-close" href="/" aria-label="Close"></a>
        </div>

        <div class="modal-body auth-primary-modal-body auth-password-modal-body">
          <div class="auth-entry-intro auth-password-intro">
            <%- include('../partials/auth/auth-entry-illustration', { mode: 'password' }) %>

            <div class="auth-entry-copy">
              <h3>Create a new password</h3>
              <p class="mb-0">
                Enter and confirm a replacement password for
                <strong><%= tokenInfo.subjectLabel || 'this account' %></strong> that satisfies all password rules.
              </p>
            </div>
          </div>

          <section class="auth-registration-form-card" aria-labelledby="passwordResetDetailsHeading">
            <div class="auth-modal-section-heading" id="passwordResetDetailsHeading">
              <i class="bi bi-shield-lock" aria-hidden="true"></i>
              Password details
            </div>

            <div class="auth-password-fields">
              <div class="auth-password-new-fields">
                <div>
                  <label class="form-label" for="resetPassword">New password</label>
                  <input
                    class="form-control password-policy-input"
                    id="resetPassword"
                    type="password"
                    name="password"
                    autocomplete="new-password"
                    required
                    autofocus
                  >
                </div>

                <div>
                  <label class="form-label" for="resetPasswordConfirm">Confirm password</label>
                  <input
                    class="form-control"
                    id="resetPasswordConfirm"
                    type="password"
                    name="confirmPassword"
                    autocomplete="new-password"
                    required
                    data-password-confirmation
                  >
                </div>
              </div>

              <div class="auth-password-guidance">
                <div class="auth-password-guidance-title">
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  Choose a secure password
                </div>
                <%- include('../partials/password-rules', { includeMatchRule: true }) %>
              </div>
            </div>
          </section>
        </div>

        <div class="modal-footer auth-password-modal-footer">
          <button
            class="btn btn-outline-secondary"
            type="button"
            data-bs-dismiss="modal"
            data-bs-toggle="modal"
            data-bs-target="#signInModal"
          >
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back
          </button>

          <button class="btn btn-primary" type="submit" data-password-submit disabled>
            <i class="bi bi-key me-1" aria-hidden="true"></i>
            Set password
          </button>
        </div>
      </form>
    <% } else { %>
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h2 class="modal-title h4 mb-1" id="passwordResetModalLabel">
              <i class="bi bi-key me-2" aria-hidden="true"></i>
              Password link unavailable
            </h2>
            <p class="modal-subtitle mb-0">
              This password link is invalid, expired, or has already been used.
            </p>
          </div>
          <a class="btn-close" href="/" aria-label="Close"></a>
        </div>

        <div class="modal-body auth-primary-modal-body auth-password-request-body">
          <div class="auth-entry-intro auth-password-request-intro">
            <%- include('../partials/auth/auth-entry-illustration', { mode: 'password' }) %>
            <div class="auth-entry-copy">
              <h3>Request a new link</h3>
              <p class="mb-0">
                For security, password links are one-time and time-limited. Request new
                instructions to continue account recovery.
              </p>
            </div>
          </div>
        </div>

        <div class="modal-footer auth-step-footer">
          <button
            class="btn btn-outline-secondary"
            type="button"
            data-bs-dismiss="modal"
            data-bs-toggle="modal"
            data-bs-target="#signInModal"
          >
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
            Back to sign in
          </button>

          <button
            class="btn btn-primary"
            type="button"
            data-bs-dismiss="modal"
            data-bs-toggle="modal"
            data-bs-target="#passwordRequestModal"
          >
            <i class="bi bi-send me-1" aria-hidden="true"></i>
            Request a new link
          </button>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('passwordResetModal');
    if (!element || typeof bootstrap === 'undefined') return;
    bootstrap.Modal.getOrCreateInstance(element).show();
  });
</script>
