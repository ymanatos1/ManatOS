<section class="content-card col-xl-7">
  <h2>Set or reset password</h2>
  <form method="post" action="/auth/password/reset">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input
      type="hidden"
      name="token"
      value="<%= token %>"
    /><label class="form-label">New password</label
    ><input
      class="form-control password-policy-input"
      type="password"
      name="password"
      required
    /><label class="form-label mt-3">Confirm password</label
    ><input class="form-control" type="password" name="confirmPassword" required /><%-
    include('../partials/password-rules') %><button class="btn btn-primary mt-3">
      Set password
    </button>
  </form>
</section>
