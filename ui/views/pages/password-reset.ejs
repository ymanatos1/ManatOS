<%#
  Password reset/set popup page.

  This page supplies flow-specific form fields to the shared popup architecture. The header,
  hero/illustration and footer are reusable components; tokenInfo is trusted server-side token
  metadata used only to identify the validated account to the user. The token itself remains a
  hidden form value and is revalidated authoritatively when the password is submitted.
%>
<div
  class="modal fade auth-primary-modal auth-password-modal auth-password-reset-modal"
  id="passwordResetModal"
  tabindex="-1"
  aria-labelledby="passwordResetModalLabel"
  aria-hidden="true"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog modal-dialog-centered auth-modal-dialog auth-password-form-dialog">
    <% if (tokenInfo) { %>
      <form
        class="modal-content password-form"
        method="post"
        action="/auth/password/reset"
        data-password-form="true"
        data-busy-submit
        data-busy-title="Setting your password…"
        data-busy-message="Please wait while the new password is saved securely."
        data-busy-icon="bi-key"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="token" value="<%= token %>">

        <%- include('../popups/shared/popup-header', {
          labelId: 'passwordResetModalLabel',
          icon: 'bi-key',
          modalTitle: popupContent.auth.passwordReset.modalTitle,
          modalSubtitle: popupContent.auth.passwordReset.modalSubtitle,
          closeHref: '/'
        }) %>

        <div class="modal-body auth-primary-modal-body auth-password-modal-body">
          <%- include('../popups/shared/rich-popup-hero', {
            introClass: 'auth-entry-intro auth-password-intro',
            illustration: { kind: 'static', name: 'password' },
            contentTitle: popupContent.auth.passwordReset.contentTitle,
            contentParagraphs: [{
              prefix: popupContent.auth.passwordReset.contentParagraphPrefix,
              emphasis: tokenInfo.subjectLabel || 'this account',
              suffix: popupContent.auth.passwordReset.contentParagraphSuffix
            }]
          }) %>

          <section class="auth-registration-form-card" aria-labelledby="passwordResetDetailsHeading">
            <div class="auth-modal-section-heading" id="passwordResetDetailsHeading">
              <i class="bi bi-shield-lock" aria-hidden="true"></i>
              Password details
            </div>

            <div class="auth-password-fields">
              <div class="auth-password-new-fields">
                <div>
                  <label class="form-label" for="resetPassword">New password</label>
                  <input
                    class="form-control password-policy-input"
                    id="resetPassword"
                    type="password"
                    name="password"
                    autocomplete="new-password"
                    required
                    autofocus
                  >
                </div>

                <div>
                  <label class="form-label" for="resetPasswordConfirm">Confirm password</label>
                  <input
                    class="form-control"
                    id="resetPasswordConfirm"
                    type="password"
                    name="confirmPassword"
                    autocomplete="new-password"
                    required
                    data-password-confirmation
                  >
                </div>
              </div>

              <div class="auth-password-guidance">
                <div class="auth-password-guidance-title">
                  <i class="bi bi-shield-check" aria-hidden="true"></i>
                  Choose a secure password
                </div>
                <%- include('../components/auth/password-rules', { includeMatchRule: true }) %>
              </div>
            </div>
          </section>
        </div>

        <%- include('../popups/shared/popup-footer', {
          footerClass: 'auth-password-modal-footer',
          leftActions: [{ label: 'Back', icon: 'bi-arrow-left', variant: 'btn-outline-secondary', dismiss: true, toggle: 'modal', target: '#signInModal' }],
          rightActions: [{ label: 'Set password', icon: 'bi-key', variant: 'btn-primary', type: 'submit', disabled: true, data: { 'password-submit': '' } }]
        }) %>
      </form>
    <% } else { %>
      <div class="modal-content">
        <%- include('../popups/shared/popup-header', {
          labelId: 'passwordResetModalLabel',
          icon: 'bi-key',
          modalTitle: popupContent.auth.passwordLinkUnavailable.modalTitle,
          modalSubtitle: popupContent.auth.passwordLinkUnavailable.modalSubtitle,
          closeHref: '/'
        }) %>

        <div class="modal-body auth-primary-modal-body auth-password-request-body auth-password-link-unavailable-body">
          <%- include('../popups/shared/rich-popup-hero', {
            introClass: 'auth-entry-intro auth-password-request-intro',
            illustration: { kind: 'static', name: 'password' },
            contentTitle: popupContent.auth.passwordLinkUnavailable.contentTitle,
            contentParagraphs: popupContent.auth.passwordLinkUnavailable.contentParagraphs
          }) %>
        </div>

        <%- include('../popups/shared/popup-footer', {
          footerClass: 'auth-step-footer',
          leftActions: [{ label: 'Back to sign in', icon: 'bi-arrow-left', variant: 'btn-outline-secondary', dismiss: true, toggle: 'modal', target: '#signInModal' }],
          rightActions: [{ label: 'Request a new link', icon: 'bi-send', variant: 'btn-primary', dismiss: true, toggle: 'modal', target: '#passwordRequestModal' }]
        }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const element = document.getElementById('passwordResetModal');
    if (!element || typeof bootstrap === 'undefined') return;
    bootstrap.Modal.getOrCreateInstance(element).show();
  });
</script>
