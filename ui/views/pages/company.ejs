<section class="content-card company-page">
  <% if (app.company.branding.companyPageImage) { %>
    <img
      class="company-hero-image"
      src="<%= app.company.branding.companyPageImage.src %>"
      alt="<%= app.company.branding.companyPageImage.alt %>"
    >
  <% } %>

  <h2 class="mt-4"><%= app.company.name %></h2>

  <% if (app.company.description) { %>
    <p><%= app.company.description %></p>
  <% } %>

  <!--
    The catalogue is intentionally data-driven even though mCRM is currently
    the only platform. Adding another SysPlatform should therefore make it
    visible here without introducing another hard-coded Company-page block.
  -->
  <div class="company-platform-catalogue mt-4">
    <% for (const platform of app.company.platforms.filter((entry) => entry.enabled)) { %>
      <article class="company-platform-card">
        <div class="company-platform-card-title">
          <strong><a href="/platform/<%= encodeURIComponent(platform.id) %>"><%= platform.shortName %></a></strong>
          <span><%= platform.name %></span>
        </div>
        <% if (platform.description) { %>
          <p class="mb-0"><%= platform.description %></p>
        <% } %>
      </article>
    <% } %>
  </div>
</section>
