<section class="home-hero content-card">
  <div class="home-hero-grid">
    <div class="home-hero-copy">
      <span class="eyebrow"><%= app.company.home.eyebrow %></span>

      <div class="home-hero-heading-row">
        <h2><%= app.company.home.title %></h2>
      </div>

      <p class="home-hero-lead">
        <%= app.company.home.description %>
      </p>

      <% if (!currentUser) { %>
        <div class="home-hero-actions">
          <button class="btn btn-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#signInModal">
            <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Sign in
          </button>
          <button class="btn btn-outline-primary btn-lg" type="button" data-bs-toggle="modal" data-bs-target="#signUpMethodModal">
            <i class="bi bi-person-plus me-2" aria-hidden="true"></i>Create account
          </button>
        </div>
      <% } %>

      <div class="home-benefits" aria-label="ManatOS foundation strengths">
        <div class="home-benefit">
          <span class="home-benefit-icon is-security"><i class="bi bi-shield-check" aria-hidden="true"></i></span>
          <div>
            <strong>Governed by design</strong>
            <span>Authentication, authorization and policy stay explicit and centrally enforced.</span>
          </div>
        </div>

        <div class="home-benefit">
          <span class="home-benefit-icon is-metadata"><i class="bi bi-diagram-3" aria-hidden="true"></i></span>
          <div>
            <strong>Business semantics</strong>
            <span>Metadata + CTX express business objects, relationships, rules and contextual behavior.</span>
          </div>
        </div>

        <div class="home-benefit">
          <span class="home-benefit-icon is-api"><i class="bi bi-braces" aria-hidden="true"></i></span>
          <div>
            <strong>One model, many experiences</strong>
            <span>Shared semantics drive consistent UI, APIs and future application experiences.</span>
          </div>
        </div>
      </div>
    </div>

    <div class="home-platform-map" aria-label="ManatOS application foundation architecture">
      <div class="home-platform-node home-platform-app">
        <span class="home-platform-node-icon"><i class="bi bi-layers" aria-hidden="true"></i></span>
        <div>
          <strong>Business Platforms & Applications</strong>
          <span>Domain applications shaped by business semantics</span>
        </div>
      </div>

      <div class="home-platform-connector home-platform-connector-top" aria-hidden="true"></div>

      <div class="home-platform-services">
        <div class="home-platform-service is-auth">
          <span><i class="bi bi-boxes" aria-hidden="true"></i></span>
          <strong>Business Objects</strong>
          <small>Models, relationships<br>and presentation</small>
        </div>

        <div class="home-platform-service is-sysbo">
          <span><i class="bi bi-diagram-3-fill" aria-hidden="true"></i></span>
          <strong>Context + Rules</strong>
          <small>CTX, calculations<br>and declarative behavior</small>
        </div>

        <div class="home-platform-service is-api">
          <span><i class="bi bi-braces" aria-hidden="true"></i></span>
          <strong>Policy + APIs</strong>
          <small>Capabilities, authorization<br>and REST endpoints</small>
        </div>
      </div>

      <div class="home-platform-connector home-platform-connector-bottom" aria-hidden="true"></div>

      <div class="home-platform-node home-platform-foundation">
        <span class="home-platform-node-icon"><i class="bi bi-database-fill" aria-hidden="true"></i></span>
        <div>
          <strong>ManatOS Application Foundation</strong>
          <span>Governed, reusable semantic runtime</span>
        </div>
      </div>
    </div>
  </div>
</section>
