<% const readOnly = !isNew && !permissions.edit; %>
<% const isOwnSysUser = !isNew && definition.key === 'sys-users' && currentUser && item.id === currentUser.id; %>

<section class="content-card">
  <form
    id="boEditForm"
    method="post"
    action="/bo/<%= definition.key %>/save"
    data-dirty-guard="true"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="id" value="<%= item.id || '' %>">

    <ul class="nav nav-tabs entity-tabs" role="tablist">
      <% for (let tabIndex = 0; tabIndex < tabs.length; tabIndex += 1) { %>
        <% const tab = tabs[tabIndex]; %>
        <li class="nav-item" role="presentation">
          <button
            class="nav-link <%= tabIndex === 0 ? 'active' : '' %>"
            id="bo-<%= tab.id %>-tab"
            data-bs-toggle="tab"
            data-bs-target="#bo-<%= tab.id %>-pane"
            type="button"
            role="tab"
            aria-controls="bo-<%= tab.id %>-pane"
            aria-selected="<%= tabIndex === 0 ? 'true' : 'false' %>"
          >
            <% if (tab.icon) { %>
              <i class="bi <%= tab.icon %> me-1" aria-hidden="true"></i>
            <% } %>
            <%= tab.title %>
          </button>
        </li>
      <% } %>
    </ul>

    <div class="tab-content entity-tab-content">
      <% for (let tabIndex = 0; tabIndex < tabs.length; tabIndex += 1) { %>
        <% const tab = tabs[tabIndex]; %>
        <div
          class="tab-pane fade <%= tabIndex === 0 ? 'show active' : '' %>"
          id="bo-<%= tab.id %>-pane"
          role="tabpanel"
          aria-labelledby="bo-<%= tab.id %>-tab"
          tabindex="0"
        >
          <% if (tab.id === 'general') { %>
            <%- include('../partials/sysbo-general-fields', { readOnly }) %>
          <% } else if (tab.id === 'authentication' && definition.key === 'sys-users') { %>
            <%- include('../partials/authentication-summary', {
              authenticationUser: item,
              authenticationIdentities: authenticationIdentities || [],
              showPasswordAction: false
            }) %>
          <% } else if (tab.partial) { %>
            <%- include(tab.partial) %>
          <% } else { %>
            <div class="text-secondary small">No content is configured for this tab yet.</div>
          <% } %>
        </div>
      <% } %>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4 gap-3 flex-wrap">
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (
          !isNew &&
          definition.key === 'sys-users' &&
          permissions.edit &&
          app.ui.allowAdminEmailVerification &&
          currentUser &&
          item.id !== currentUser.id &&
          item.emailVerified !== true
        ) { %>
          <button
            class="btn btn-outline-success"
            type="submit"
            form="verifyUserEmailForm"
          >
            <i class="bi bi-envelope-check me-1"></i>
            Verify email
          </button>
        <% } %>

        <% if (!isNew && permissions.delete && definition.uiMetadata.editViewModel.showDeleteButton) { %>
          <button
            class="btn btn-danger"
            type="button"
            <%= isOwnSysUser ? 'disabled' : '' %>
            <% if (!isOwnSysUser) { %>
              data-bs-toggle="modal"
              data-bs-target="#deleteEntryModal"
            <% } %>
            <% if (isOwnSysUser) { %>
              title="You cannot delete your own user account."
            <% } %>
          >
            <i class="bi bi-trash me-1"></i>
            Delete entry
          </button>
        <% } %>
      </div>

      <div class="d-flex gap-2">
        <a
          class="btn btn-secondary dirty-navigation"
          href="/bo/<%= definition.key %>"
        >
          <i class="bi bi-x-circle me-1"></i>
          <%= readOnly ? 'Back' : 'Cancel' %>
        </a>

        <% if (!readOnly) { %>
        <button class="btn btn-primary" type="submit">
          <i class="bi bi-check-circle me-1"></i>
          Save
        </button>
        <% } %>
      </div>
    </div>
  </form>
</section>

<% if (
  !isNew &&
  definition.key === 'sys-users' &&
  permissions.edit &&
  app.ui.allowAdminEmailVerification &&
  currentUser &&
  item.id !== currentUser.id &&
  item.emailVerified !== true
) { %>
  <form
    id="verifyUserEmailForm"
    method="post"
    action="/bo/sys-users/<%= item.id %>/verify-email"
  >
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>
<% } %>

<%- include('../popups/messages/bo-edit-confirmations', {
  isNew,
  permissions,
  isOwnSysUser,
  definition,
  item,
  csrfToken
}) %>
