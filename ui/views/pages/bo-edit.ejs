<section class="content-card"><form id="boEditForm" method="post" action="/bo/<%= definition.key %>/save" data-dirty-guard="true"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= item.id || '' %>"><div class="row g-3"><% for(const field of Object.values(definition.boMetadata.fieldDefinition).sort((a,b)=>a.order-b.order)){ if(field.generated||field.readOnly||field.sensitive)continue; %><div class="col-md-6"><label class="form-label"><%= field.label %></label><% if(field.type==='boolean'){ %><div class="form-check form-switch"><input class="form-check-input" type="checkbox" name="<%= field.key %>" <%= item[field.key]!==false?'checked':'' %>></div><% }else if(field.type==='enum'){ %><select class="form-select" name="<%= field.key %>" <%= field.required?'required':'' %>><option value="">Choose...</option><% for(const o of field.enumValues||[]){ %><option value="<%= o %>" <%= item[field.key]===o?'selected':'' %>><%= o %></option><% } %></select><% }else if(field.type==='reference'){ %><select class="form-select" name="<%= field.key %>" <%= field.required?'required':'' %>><option value="">None</option><% for(const ref of referenceData[field.key]||[]){ %><option value="<%= ref.id %>" <%= item[field.key]===ref.id?'selected':'' %>><%= ref.name %></option><% } %></select><% }else{ %><input class="form-control" name="<%= field.key %>" type="<%= field.type==='email'?'email':field.type==='number'?'number':field.type==='date'?'datetime-local':'text' %>" value="<%= item[field.key] ?? '' %>" <%= field.required?'required':'' %>><% } %></div><% } %></div><div class="d-flex justify-content-between align-items-center mt-4"><div><% if(!isNew&&definition.uiMetadata.editViewModel.showDeleteButton){ %><button class="btn btn-danger" type="button" data-bs-toggle="modal" data-bs-target="#deleteEntryModal"><i class="bi bi-trash me-1"></i>Delete entry</button><% } %></div><div class="d-flex gap-2"><a class="btn btn-secondary dirty-navigation" href="/bo/<%= definition.key %>"><i class="bi bi-x-circle me-1"></i>Cancel</a><button class="btn btn-primary" type="submit"><i class="bi bi-check-circle me-1"></i>Save</button></div></div></form></section>
<% if(!isNew){ %><div class="modal fade" id="deleteEntryModal" tabindex="-1"><div class="modal-dialog"><form class="modal-content" method="post" action="/bo/<%= definition.key %>/<%= item.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-header bg-danger-subtle"><h2 class="modal-title h5"><i class="bi bi-trash me-2"></i>Delete <%= definition.boMetadata.name %></h2><button class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Are you sure you want to permanently delete <strong><%= item[definition.boMetadata.primaryField] %></strong>?<p class="text-danger mt-2 mb-0">This action cannot be undone.</p></div><div class="modal-footer"><button class="btn btn-secondary" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-danger">Delete</button></div></form></div></div><% } %>
<div class="modal fade" id="unsavedChangesModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-warning-subtle"><h2 class="modal-title h5"><i class="bi bi-exclamation-triangle me-2"></i>Unsaved changes</h2></div><div class="modal-body">You have changes that have not been saved.</div><div class="modal-footer"><button class="btn btn-secondary" data-unsaved-action="cancel">Cancel</button><button class="btn btn-outline-danger" data-unsaved-action="discard">Discard</button><button class="btn btn-primary" data-unsaved-action="save">Save</button></div></div></div></div>
