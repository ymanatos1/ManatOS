<%
  const provider =
    authProviders.find((candidate) => candidate.key === profile.provider) || {
      key: profile.provider,
      label: profile.provider,
      icon: 'bi-box-arrow-in-right',
      configured: false
    };
%>

<div
  class="modal fade external-link-modal"
  id="externalLinkModal"
  tabindex="-1"
  aria-labelledby="externalLinkModalLabel"
  aria-hidden="true"
  data-auto-show="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered external-link-modal-dialog">
    <form
      class="modal-content"
      method="post"
      action="/auth/link/external"
      data-busy-submit
      data-busy-title="Linking <%= provider.label %>…"
      data-busy-message="Please wait while ManatOS verifies your account and securely links <%= provider.label %>."
      data-busy-icon="<%= provider.icon %>"
    >
      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <%- include('../popups/shared/popup-header', {
        labelId: 'externalLinkModalLabel',
        icon: 'bi-link-45deg',
        modalTitle: 'Link external account',
        modalSubtitle: 'Confirm the existing account that should be connected.',
        closeHref: '/',
        closeLabel: 'Cancel external account linking',
        closeTitle: 'Cancel'
      }) %>

      <div class="modal-body external-link-modal-body">
        <div class="external-link-intro">
          <%- include('../popups/illustrations/external-link-illustration', { provider }) %>

          <div class="external-link-copy">
            <p class="mb-2">
              <strong><%= provider.label %></strong> authenticated the email address
              <strong><%= profile.email %></strong>. That email already belongs to the existing
              account <strong><%= profile.existingUserName %></strong>.
            </p>

            <p class="text-secondary mb-0">
              For security, we do not link accounts automatically just because their email
              addresses match. Sign in to the existing account once to confirm that you own it and
              authorize this connection.
            </p>
          </div>
        </div>

        <div class="external-link-fields">
          <div class="external-link-field-row">
            <label
              class="form-label mb-0"
              for="externalLinkProvider"
            >
              <i class="bi <%= provider.icon %> external-link-field-icon" aria-hidden="true"></i>
              External provider
            </label>

            <div class="input-group">
              <span class="input-group-text" aria-hidden="true">
                <i class="bi <%= provider.icon %>"></i>
              </span>
              <input
                id="externalLinkProvider"
                class="form-control"
                value="<%= provider.label %>"
                readonly
              >
            </div>
          </div>

          <div class="external-link-field-row">
            <label
              class="form-label mb-0"
              for="externalLinkEmail"
            >
              <i class="bi bi-envelope external-link-field-icon" aria-hidden="true"></i>
              External email
            </label>

            <input
              id="externalLinkEmail"
              class="form-control"
              value="<%= profile.email %>"
              readonly
            >
          </div>

          <div class="external-link-field-row">
            <label
              class="form-label mb-0"
              for="externalLinkIdentity"
            >
              <i class="bi bi-person external-link-field-icon" aria-hidden="true"></i>
              Existing account user-name/email
            </label>

            <input
              id="externalLinkIdentity"
              class="form-control"
              name="identity"
              type="text"
              value="<%= profile.existingUserName || profile.email %>"
              autocomplete="username"
              required
            >
          </div>

          <div class="external-link-field-row">
            <label
              class="form-label mb-0"
              for="externalLinkPassword"
            >
              <i class="bi bi-lock external-link-field-icon" aria-hidden="true"></i>
              Confirm with password
            </label>

            <div>
              <input
                id="externalLinkPassword"
                class="form-control"
                name="password"
                type="password"
                autocomplete="current-password"
                required
                autofocus
              >

              <div class="form-text">
                Enter or confirm the password for the existing account to authorize this connection.
              </div>
            </div>
          </div>
      </div>

      <%- include('../popups/shared/popup-footer', {
        leftActions: [],
        rightActions: [
          { label: 'Cancel', variant: 'btn-outline-secondary', href: '/' },
          { label: `Sign in and link ${provider.label}`, icon: 'bi-link-45deg', variant: 'btn-primary', type: 'submit' }
        ]
      }) %>
    </form>
  </div>
</div>
