<section class="content-card"><div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3"><div><% if(definition.uiMetadata.listViewModel.showResultCount&&paging){ %><span class="text-secondary"><%= paging.total %> entries</span><% } %></div><a class="btn btn-success" href="/bo/<%= definition.key %>/new"><i class="bi bi-plus-circle me-1"></i><%= definition.uiMetadata.listViewModel.addButtonText %></a></div>
<form class="filter-panel row g-2 mb-3" method="get"><% for(const key of definition.uiMetadata.filterDefinition.fields){ const field=definition.boMetadata.fieldDefinition[key]; %><div class="col-md-3"><label class="form-label small"><i class="bi bi-funnel me-1"></i><%= field.label %></label><% if(field.type==='enum'){ %><select class="form-select" name="filter.<%= key %>"><option value="">All</option><% for(const o of field.enumValues||[]){ %><option value="<%= o %>" <%= query[`filter.${key}`]===o?'selected':'' %>><%= o %></option><% } %></select><% }else{ %><input class="form-control" name="filter.<%= key %>" value="<%= query[`filter.${key}`] || '' %>"><% } %></div><% } %><div class="col-md-3 d-flex align-items-end gap-2"><button class="btn btn-outline-primary"><i class="bi bi-funnel me-1"></i>Filter</button><a class="btn btn-outline-secondary" href="/bo/<%= definition.key %>"><i class="bi bi-x-circle me-1"></i>Clear</a></div></form>
<div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><% for(const key of definition.uiMetadata.gridConfiguration.visibleFields){ const field=definition.boMetadata.fieldDefinition[key]; %><th><a class="table-sort-link" href="?<%= new URLSearchParams({...query,sort:key,direction:query.sort===key&&query.direction!=='desc'?'desc':'asc'}).toString() %>"><%= field.label %> <% if(query.sort===key){ %><i class="bi <%= query.direction==='desc'?'bi-sort-down':'bi-sort-up' %>"></i><% } %></a></th><% } %><% if(definition.uiMetadata.gridConfiguration.showPlayAction){ %><th>Play</th><% } %></tr></thead><tbody><% for(const item of items){ %><tr><% for(const key of definition.uiMetadata.gridConfiguration.visibleFields){ %><td><% if(key===definition.boMetadata.primaryField){ %><a href="/bo/<%= definition.key %>/<%= item.id %>"><%= item[key] %></a><% }else{ %><%= item[key] ?? '' %><% } %></td><% } %><% if(definition.uiMetadata.gridConfiguration.showPlayAction){ %><td><a class="btn btn-sm btn-primary" href="/bo/sys-applications/<%= item.id %>/play" title="Open application playground"><i class="bi bi-play-circle-fill"></i></a></td><% } %></tr><% } %></tbody></table></div>
<% if(paging&&definition.uiMetadata.paginationConfiguration.enabled){ const pc=definition.uiMetadata.paginationConfiguration; const half=Math.floor(pc.maxVisiblePageButtons/2); let firstPage=Math.max(1,paging.page-half); let lastPage=Math.min(paging.totalPages,firstPage+pc.maxVisiblePageButtons-1); firstPage=Math.max(1,lastPage-pc.maxVisiblePageButtons+1); %><div class="d-flex justify-content-between align-items-center flex-wrap gap-3"><div class="small text-secondary">Page <%= paging.page %> of <%= paging.totalPages %></div><nav><ul class="pagination mb-0"><% if(pc.showFirstLastButtons){ %><li class="page-item <%= paging.page<=1?'disabled':'' %>"><a class="page-link" href="?<%= new URLSearchParams({...query,page:'1'}).toString() %>">First</a></li><% } %><li class="page-item <%= paging.page<=1?'disabled':'' %>"><a class="page-link" href="?<%= new URLSearchParams({...query,page:String(Math.max(1,paging.page-1))}).toString() %>">Previous</a></li><% for(let pageNo=firstPage;pageNo<=lastPage;pageNo++){ %><li class="page-item <%= pageNo===paging.page?'active':'' %>"><a class="page-link" href="?<%= new URLSearchParams({...query,page:String(pageNo)}).toString() %>"><%= pageNo %></a></li><% } %><li class="page-item <%= paging.page>=paging.totalPages?'disabled':'' %>"><a class="page-link" href="?<%= new URLSearchParams({...query,page:String(Math.min(paging.totalPages,paging.page+1))}).toString() %>">Next</a></li><% if(pc.showFirstLastButtons){ %><li class="page-item <%= paging.page>=paging.totalPages?'disabled':'' %>"><a class="page-link" href="?<%= new URLSearchParams({...query,page:String(paging.totalPages)}).toString() %>">Last</a></li><% } %></ul></nav><% if(pc.showPageSizeSelector){ %><form method="get" class="d-flex align-items-center gap-2"><% for(const [k,v] of Object.entries(query)){if(k!=='pageSize'&&k!=='page'){ %><input type="hidden" name="<%= k %>" value="<%= v %>"><% }} %><label class="small">Rows</label><select class="form-select form-select-sm" name="pageSize" onchange="this.form.submit()"><% for(const size of pc.allowedPageSizes){ %><option value="<%= size %>" <%= Number(query.pageSize||pc.defaultPageSize)===size?'selected':'' %>><%= size %></option><% } %></select></form><% } %></div><% } %></section>
