<% if (!hasAnyEntries) { %>
  <section class="empty-entity-state">
    <i class="bi bi-inbox" aria-hidden="true"></i>
    <strong>No entries found</strong>
    <span>This entity does not contain any entries yet.</span>

    <% if (permissions.create) { %>
      <a class="btn btn-success mt-2" href="/bo/<%= definition.key %>/new">
        <i class="bi bi-plus-circle me-1"></i>
        Add the first entry
      </a>
    <% } %>
  </section>
<% } else { %>
  <section
    class="content-card sysbo-list-page"
    data-entity-key="<%= definition.key %>"
    data-default-page-size="<%= definition.uiMetadata.paginationConfiguration.defaultPageSize %>"
  >
    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3">
      <div>
        <% if (definition.uiMetadata.listViewModel.showResultCount && paging) { %>
          <span class="text-secondary">
            <strong class="text-body"><%= paging.total %></strong>
            <%= paging.total === 1 ? 'entry' : 'entries' %>
          </span>
        <% } %>
      </div>

      <% if (permissions.create) { %>
        <a class="btn btn-success" href="/bo/<%= definition.key %>/new">
          <i class="bi bi-plus-circle me-1"></i>
          <%= definition.uiMetadata.listViewModel.addButtonText %>
        </a>
      <% } %>
    </div>

    <form class="filter-panel row g-2 mb-3" method="get">
      <% for (const key of definition.uiMetadata.filterDefinition.fields) { %>
        <% const field = definition.boMetadata.fieldDefinition[key]; %>

        <div class="col-xl-3 col-md-4">
          <label class="form-label small" for="filter-<%= key %>">
            <i class="bi bi-funnel me-1"></i>
            <%= field.label %>
          </label>

          <% if (field.type === 'enum') { %>
            <select class="form-select" id="filter-<%= key %>" name="filter.<%= key %>">
              <option value="">All</option>
              <% for (const option of field.enumValues || []) { %>
                <option value="<%= option %>" <%= query[`filter.${key}`] === option ? 'selected' : '' %>><%= option %></option>
              <% } %>
            </select>
          <% } else { %>
            <input class="form-control" id="filter-<%= key %>" name="filter.<%= key %>" value="<%= query[`filter.${key}`] || '' %>">
          <% } %>
        </div>
      <% } %>

      <div class="col-xl-3 col-md-4 d-flex align-items-end gap-2">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-funnel me-1"></i>Filter</button>
        <a class="btn btn-outline-secondary" href="/bo/<%= definition.key %>"><i class="bi bi-x-circle me-1"></i>Clear</a>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <% for (const key of definition.uiMetadata.gridConfiguration.visibleFields) { %>
              <% const field = definition.boMetadata.fieldDefinition[key]; %>
              <th>
                <a class="table-sort-link" href="?<%= new URLSearchParams({...query, sort: key, direction: query.sort === key && query.direction !== 'desc' ? 'desc' : 'asc'}).toString() %>">
                  <%= field.label %>
                  <% if (query.sort === key) { %>
                    <i class="bi <%= query.direction === 'desc' ? 'bi-sort-down' : 'bi-sort-up' %>"></i>
                  <% } else { %>
                    <i class="bi bi-arrow-down-up table-sort-muted"></i>
                  <% } %>
                </a>
              </th>
            <% } %>
            <% if (definition.uiMetadata.gridConfiguration.showPlayAction) { %><th class="text-center">Play</th><% } %>
          </tr>
        </thead>

        <tbody>
          <% if (!items.length) { %>
            <tr>
              <td class="empty-table-state" colspan="<%= definition.uiMetadata.gridConfiguration.visibleFields.length + (definition.uiMetadata.gridConfiguration.showPlayAction ? 1 : 0) %>">
                <i class="bi bi-search"></i>
                <strong>No entries found</strong>
                <span>No existing entries match the current filter. Change or clear the filters.</span>
              </td>
            </tr>
          <% } %>

          <% for (const item of items) { %>
            <tr>
              <% for (const key of definition.uiMetadata.gridConfiguration.visibleFields) { %>
                <% const field = definition.boMetadata.fieldDefinition[key]; %>
                <td>
                  <% if (key === definition.boMetadata.primaryField) { %>
                    <a class="fw-semibold" href="/bo/<%= definition.key %>/<%= item.id %>"><%= item[key] %></a>
                  <% } else if (field.type === 'boolean') { %>
                    <% const positive = Boolean(item[key]); %>
                    <% const positiveLabel = key === 'emailVerified' ? 'Verified' : (key === 'enabled' ? 'Enabled' : 'Yes'); %>
                    <% const negativeLabel = key === 'emailVerified' ? 'Not verified' : (key === 'enabled' ? 'Disabled' : 'No'); %>
                    <span class="boolean-badge <%= positive ? 'boolean-true' : 'boolean-false' %>">
                      <i class="bi <%= positive ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"></i>
                      <%= positive ? positiveLabel : negativeLabel %>
                    </span>
                  <% } else { %>
                    <%= item[key] ?? '' %>
                  <% } %>
                </td>
              <% } %>

              <% if (definition.uiMetadata.gridConfiguration.showPlayAction) { %>
                <td class="text-center">
                  <a class="btn btn-sm btn-primary" href="/bo/sys-applications/<%= item.id %>/play" title="Open application playground" aria-label="Open application playground">
                    <i class="bi bi-play-fill"></i><span class="d-none d-xl-inline ms-1">Play</span>
                  </a>
                </td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (paging && definition.uiMetadata.paginationConfiguration.enabled) { %>
      <% const pc = definition.uiMetadata.paginationConfiguration; %>
      <% const half = Math.floor(pc.maxVisiblePageButtons / 2); %>
      <% let firstPage = Math.max(1, paging.page - half); %>
      <% let lastPage = Math.min(paging.totalPages, firstPage + pc.maxVisiblePageButtons - 1); %>
      <% firstPage = Math.max(1, lastPage - pc.maxVisiblePageButtons + 1); %>

      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mt-2">
        <div class="small text-secondary">Page <%= paging.page %> of <%= paging.totalPages %></div>

        <nav aria-label="Result pages">
          <ul class="pagination pagination-sm mb-0">
            <% if (pc.showFirstLastButtons) { %>
              <li class="page-item <%= paging.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?<%= new URLSearchParams({...query, page: '1'}).toString() %>">First</a></li>
            <% } %>
            <li class="page-item <%= paging.page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="?<%= new URLSearchParams({...query, page: String(Math.max(1, paging.page - 1))}).toString() %>">Previous</a></li>
            <% for (let pageNo = firstPage; pageNo <= lastPage; pageNo++) { %>
              <li class="page-item <%= pageNo === paging.page ? 'active' : '' %>"><a class="page-link" href="?<%= new URLSearchParams({...query, page: String(pageNo)}).toString() %>"><%= pageNo %></a></li>
            <% } %>
            <li class="page-item <%= paging.page >= paging.totalPages ? 'disabled' : '' %>"><a class="page-link" href="?<%= new URLSearchParams({...query, page: String(Math.min(paging.totalPages, paging.page + 1))}).toString() %>">Next</a></li>
            <% if (pc.showFirstLastButtons) { %>
              <li class="page-item <%= paging.page >= paging.totalPages ? 'disabled' : '' %>"><a class="page-link" href="?<%= new URLSearchParams({...query, page: String(paging.totalPages)}).toString() %>">Last</a></li>
            <% } %>
          </ul>
        </nav>

        <% if (pc.showPageSizeSelector) { %>
          <form method="get" class="d-flex align-items-center gap-2">
            <% for (const [key, value] of Object.entries(query)) { %>
              <% if (key !== 'pageSize' && key !== 'page') { %><input type="hidden" name="<%= key %>" value="<%= value %>"><% } %>
            <% } %>
            <label class="small" for="pageSize-<%= definition.key %>">Rows</label>
            <select class="form-select form-select-sm page-size-select" id="pageSize-<%= definition.key %>" name="pageSize" data-page-size-select>
              <% for (const size of pc.allowedPageSizes) { %>
                <option value="<%= size %>" <%= Number(query.pageSize || pc.defaultPageSize) === size ? 'selected' : '' %>><%= size %></option>
              <% } %>
            </select>
          </form>
        <% } %>
      </div>
    <% } %>
  </section>
<% } %>
