<%#
  COMPONENT: Busy overlay

  Purpose:
  - Renders the global blocking/busy affordance used while a ManatOS workflow is in progress.

  Inputs / metadata:
  - Static shell component; runtime supplies message and optional cancel action.

  CTX contract:
  - None.

  Embeds / delegates:
  - None.

  Runtime contract:
  - busy runtime owns visibility, message text and cancellation behavior.
%>

<div
  class="manatos-busy-overlay"
  id="manatosBusyOverlay"
  role="status"
  aria-live="polite"
  aria-hidden="true"
>
  <div class="manatos-busy-panel">
    <div class="manatos-busy-animation" aria-hidden="true">
      <div class="manatos-busy-provider">
        <i class="bi bi-arrow-repeat" id="manatosBusyIcon"></i>
      </div>
      <div class="manatos-busy-pulse"></div>
    </div>

    <div class="manatos-busy-copy">
      <h2 class="h5 mb-1" id="manatosBusyTitle">Please wait…</h2>
      <p class="mb-0 text-secondary" id="manatosBusyMessage">
        ManatOS is completing the requested operation.
      </p>
    </div>
    <div class="mt-3 text-center" id="manatosBusyActionWrap" hidden><button type="button" class="btn btn-outline-secondary btn-sm" id="manatosBusyAction">Cancel</button></div>
  </div>
</div>
