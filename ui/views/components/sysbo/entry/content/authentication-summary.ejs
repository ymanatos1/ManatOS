<%#
  COMPONENT: Authentication summary adapter

  Purpose:
  - Exposes the reusable authentication summary through metadata-declared entry components.

  Inputs / metadata:
  - Canonical entry item, rendered calculated values, reference catalogues and related-collection resources.
  - component.options.showPasswordAction / showPrincipalReference control self-service affordances.

  CTX contract:
  - Read-only projection of the active entry; no CTX mutation.

  Embeds / delegates:
  - Delegates visual/authentication presentation to components/auth/authentication-summary.ejs.

  Runtime contract:
  - Factual data comes from the generic entry supplemental-data pipeline; no SysUser route special case is required.
%>
<%
  const options = component?.options || {};
  const principalId = item?.principalId ? String(item.principalId) : '';
  const principalCandidates = Array.isArray(referenceData?.principalId) ? referenceData.principalId : [];
  const accountPrincipal = principalId
    ? principalCandidates.find((candidate) => String(candidate?.id ?? candidate?.value ?? '') === principalId) || null
    : null;
  const authenticationIdentities = Array.isArray(componentData?.collectionResourceData?.externalIdentities?.rows)
    ? componentData.collectionResourceData.externalIdentities.rows
    : [];
%>
<%- include('../../../auth/authentication-summary', {
  authenticationUser: item,
  authenticationIdentities,
  emailVerificationStatus: entryRenderValues?.emailVerificationStatus || null,
  localPasswordStatus: entryRenderValues?.localPasswordStatus || null,
  showPasswordAction: options.showPasswordAction === true,
  showPrincipalReference: options.showPrincipalReference === true,
  accountPrincipal,
}) %>
