<%#
  COMPONENT: Entry summary

  Purpose:
  - Renders a compact metadata-driven read-only summary for entry fields and values.

  Inputs / metadata:
  - Canonical metadata/UI metadata, current entry values, option/reference presentation helpers.

  CTX contract:
  - Reads current entry values only; no CTX mutation.

  Embeds / delegates:
  - entry-icons.ejs where entry representation is shown.

  Runtime contract:
  - Pure presentation.
%>

<%
  /*
   * Higher-level read-only field container. Summary owns compact arrangement
   * and decoration only; canonical fields keep their normal type/value-source
   * semantics. A calculation never creates a second summary field model.
   */
%>
<div class="account-summary-grid authentication-summary-grid" data-metadata-summary>
  <% for (const key of tab.fields) { %>
    <% const collection = relatedCollections[key]; %>
    <% const field = metadata.fieldDefinition[key]; %>
    <% if (collection || !field || !fieldVisible(field) || field.sensitive) continue; %>
    <% const presentation = overrides[key]?.presentation || {}; %>
    <% const rawValue = valueFor(key); %>
    <%# Dynamic summary presentation is interpreted by the browser against the owning V2 entry CTX. %>
    <% const toneDeclaration = presentation.tone; %>
    <% const iconDeclaration = presentation.icon; %>
    <% const toneExpression = toneDeclaration
      && typeof toneDeclaration === 'object'
      && typeof toneDeclaration.expression === 'string'
        ? toneDeclaration.expression
        : null; %>
    <% const iconExpression = iconDeclaration
      && typeof iconDeclaration === 'object'
      && typeof iconDeclaration.expression === 'string'
        ? iconDeclaration.expression
        : null; %>
    <% const tone = toneExpression ? null : toneDeclaration; %>
    <% const stateIcon = iconExpression ? null : iconDeclaration; %>
    <% const rendered = field.type === 'reference'
      ? referenceLabel(key, rawValue)
      : formatValue(rawValue, presentation); %>
    <div class="account-summary-label"><%= fieldLabel(field) %>:</div>
    <div
      class="account-summary-value"
      data-v2-summary-presentation
      <% if (toneExpression) { %>
        data-v2-summary-tone-expression="<%= toneExpression %>"
      <% } %>
      <% if (iconExpression) { %>
        data-v2-summary-icon-expression="<%= iconExpression %>"
      <% } %>
    >
      <% if (field.type === 'reference' && fieldEditable(field)) { %>
        <%- include('../fields/reference-select', {
          key,
          field,
          value: rawValue,
          editable: true,
          referenceValues,
          fieldLabel
        }) %>
      <% } else if (
        toneExpression || iconExpression
      ) { %>
        <span data-v2-summary-dynamic-value><%= rendered %></span>
      <% } else if (stateIcon) { %>
        <span class="status-value <%= tone === 'success' ? 'status-positive' : 'status-neutral' %>">
          <i class="bi bi-<%= stateIcon %>" aria-hidden="true"></i>
          <%= rendered %>
        </span>
      <% } else if (tone) { %>
        <span class="badge text-bg-<%= tone %>"><%= rendered %></span>
      <% } else if (rendered === (presentation.emptyText || '—')) { %>
        <span class="text-secondary"><%= rendered %></span>
      <% } else { %>
        <%- include('readonly-value', {
          field,
          presentation,
          rendered,
          enhancedReadonlyPresentation:
            typeof enhancedReadonlyPresentation !== 'undefined' &&
            enhancedReadonlyPresentation === true,
        }) %>
      <% } %>
    </div>
  <% } %>
</div>

<%- include('related-collections', {
  tab,
  relatedCollections,
  pageRelatedData,
  relatedMetadataRegistry,
  collectionValue,
  relatedRowHref,
  relatedReferenceLabel,
  optionItemForField,
  enumToneClass,
  formatValue,
}) %>
