<%#
  COMPONENT: Related collections

  Purpose:
  - Renders metadata-declared related entity collections consistently across SysBO entry pages.

  Inputs / metadata:
  - related collection metadata, related entity metadata/UI metadata, option/reference presentation helpers and row values.

  CTX contract:
  - Reads the owning entry projection; collection mutation belongs to the configured editor/action path.

  Embeds / delegates:
  - ../shell/entry-icons.ejs and collection-editor.ejs where editing is enabled.

  Runtime contract:
  - Collection action hooks delegate behavior to shared metadata collection runtimes.
%>

<%#
  Generic metadata-driven related-collection renderer.

  The owning entity supplies only collection metadata/data. This component owns
  table/panel visualization consistently for every entity and never branches on
  the parent SysBO key.
%>
<% for (const key of tab.fields) { %>
  <% const collection = relatedCollections[key]; %>
  <% if (!collection) continue; %>
  <% const collectionSourceKey = collection.sourceKey ?? key; %>
  <% const collectionResource = pageCollectionResourceData?.[collectionSourceKey]; %>
  <% const rows = Array.isArray(collectionResource?.rows) ? collectionResource.rows : []; %>
  <% const rowMetadata = relatedMetadataRegistry[collection.entityKey]; %>
  <% const relatedRowIcon = collection.rowIcon || collection.icon || null; %>
  <% const relatedEntryIcons = (row) => {
    const representation = entryRepresentationFor(collection.entityKey, row, relatedRowIcon);
    return Array.isArray(representation?.icons) ? representation.icons : [];
  }; %>

  <div class="metadata-related-collection mt-3">
    <% if (collection.layout !== 'table-list') { %>
      <h3 class="h6 mb-3">
        <% if (collection.icon) { %><i class="bi bi-<%= collection.icon %> me-1" aria-hidden="true"></i><% } %>
        <%= collection.label %>
      </h3>
    <% } %>

    <% if (rows.length > 0 && collection.layout === 'table-list') { %>
      <div class="table-responsive metadata-related-table-wrap">
        <table class="table table-hover align-middle metadata-related-table mb-0">
          <thead>
            <tr>
              <% for (const [collectionFieldKey, collectionField] of Object.entries(collection.fields || {})) { %>
                <% const canonicalField = rowMetadata?.fieldDefinition?.[collectionFieldKey]; %>
                <th scope="col"><%= collectionField.label || canonicalField?.label || collectionFieldKey %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% for (const [relatedRowIndex, row] of rows.entries()) { %>
              <% const rowHref = relatedRowHref(collection, row); %>
              <% let relatedFieldIndex = 0; %>
              <tr
                data-v2-related-row-index="<%= relatedRowIndex %>"
              >
                <% for (const [collectionFieldKey, collectionField] of Object.entries(collection.fields || {})) { %>
                  <% const canonicalField = rowMetadata?.fieldDefinition?.[collectionFieldKey]; %>
                  <% const renderedValue = collectionValue(row, key, collection, collectionFieldKey, collectionField); %>
                  <% const valueExpression = renderedValue.expression || null; %>
                  <% const toneExpression = collectionField.presentation?.tone?.expression || null; %>
                  <% const iconExpression = collectionField.presentation?.icon?.expression || null; %>
                  <% const dynamicRelatedValue = Boolean(
                    valueExpression || toneExpression || iconExpression
                  ); %>
                  <% const selectedOptionItem = optionItemForField(canonicalField, renderedValue.raw); %>
                  <td
                    <% if (dynamicRelatedValue) { %>
                      data-v2-related-value
                      data-v2-related-entity-key="<%= collection.entityKey %>"
                      data-v2-related-source-key="<%= collectionSourceKey %>"
                      data-v2-related-field-key="<%= collectionFieldKey %>"
                      data-v2-related-source-field="<%= renderedValue.sourceField %>"
                      data-v2-related-field-type="<%= canonicalField?.type || 'string' %>"
                      data-v2-related-option-items="<%= JSON.stringify([...(canonicalField?.optionItems || []), ...(canonicalField?.enumItems || [])]) %>"
                      data-v2-related-empty-text="<%= collectionField.presentation?.emptyText || '—' %>"
                      <% if (valueExpression) { %>
                      data-v2-related-value-expression="<%= valueExpression %>"
                      <% } %>
                      <% if (toneExpression) { %>
                      data-v2-related-tone-expression="<%= toneExpression %>"
                      <% } %>
                      <% if (iconExpression) { %>
                      data-v2-related-icon-expression="<%= iconExpression %>"
                      <% } %>
                    <% } %>
                  >
                    <% if (relatedFieldIndex === 0) { %><span class="metadata-related-primary-value"><% } %>
                    <% if (relatedFieldIndex === 0) { %>
                      <% const entryIcons = relatedEntryIcons(row); %>
                      <%- include('../shell/entry-icons', {
                        entryRepresentation: { icons: entryIcons },
                        iconGroupClass: 'metadata-entry-icons me-1 text-secondary'
                      }) %>
                    <% } %>
                    <% if (dynamicRelatedValue) { %>
                      <span data-v2-related-dynamic-value><%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %></span>
                    <% } else if (rowHref && relatedFieldIndex === 0) { %>
                      <% const viewOnlyHref = `${rowHref}${String(rowHref).includes('?') ? '&' : '?'}_entryMode=view`; %>
                      <a
                        class="fw-semibold"
                        href="<%= viewOnlyHref %>"
                        data-related-entry-view-popup
                        data-related-entry-entity-key="<%= collection.entityKey %>"
                        data-related-entry-title="<%= renderedValue.raw ?? collection.label ?? 'View entry' %>"
                      ><%= renderedValue.raw ?? '—' %></a>
                    <% } else if (canonicalField?.type === 'reference') { %>
                      <%= relatedReferenceLabel(collectionSourceKey, collectionFieldKey, renderedValue.raw) %>
                    <% } else if (selectedOptionItem) { %>
                      <% if (selectedOptionItem.icon) { %>
                        <i
                          class="bi bi-<%= selectedOptionItem.icon %> <%= enumToneClass(selectedOptionItem) %> me-1"
                          aria-hidden="true"
                        ></i>
                      <% } %>
                      <%= selectedOptionItem.label || renderedValue.raw || '—' %>
                    <% } else if (canonicalField?.type === 'boolean') { %>
                      <% const positive = Boolean(renderedValue.raw); %>
                      <span class="boolean-badge <%= positive ? 'boolean-true' : 'boolean-false' %>">
                        <i class="bi <%= positive ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"></i>
                        <%= positive ? 'Enabled' : 'Disabled' %>
                      </span>
                    <% } else if (canonicalField?.type === 'date') { %>
                      <%= formatValue(renderedValue.raw, { format: 'datetime', emptyText: '—' }) %>
                    <% } else if (renderedValue.calculated && (renderedValue.tone || renderedValue.icon)) { %>
                      <span class="badge text-bg-<%= renderedValue.tone || 'secondary' %>">
                        <% if (renderedValue.icon) { %><i class="bi bi-<%= renderedValue.icon %> me-1" aria-hidden="true"></i><% } %>
                        <%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %>
                      </span>
                    <% } else { %>
                      <%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %>
                    <% } %>
                    <% if (relatedFieldIndex === 0) { %></span><% } %>
                  </td>
                  <% relatedFieldIndex += 1; %>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } else if (rows.length > 0) { %>
      <div class="authentication-identity-list">
        <% for (const [relatedRowIndex, row] of rows.entries()) { %>
          <div
            class="authentication-identity-row"
            data-v2-related-row-index="<%= relatedRowIndex %>"
          >
            <% let relatedPanelFieldIndex = 0; %>
            <% for (const [collectionFieldKey, collectionField] of Object.entries(collection.fields || {})) { %>
              <% const canonicalField = rowMetadata?.fieldDefinition?.[collectionFieldKey]; %>
              <% const renderedValue = collectionValue(row, key, collection, collectionFieldKey, collectionField); %>
              <% const valueExpression = renderedValue.expression || null; %>
              <% const toneExpression = collectionField.presentation?.tone?.expression || null; %>
              <% const iconExpression = collectionField.presentation?.icon?.expression || null; %>
              <% const dynamicRelatedValue = Boolean(
                valueExpression || toneExpression || iconExpression
              ); %>
              <% const selectedOptionItem = optionItemForField(canonicalField, renderedValue.raw); %>
              <div
                class="<%= relatedPanelFieldIndex === 0 ? 'metadata-related-primary-cell' : '' %>"
                <% if (dynamicRelatedValue) { %>
                  data-v2-related-value
                  data-v2-related-entity-key="<%= collection.entityKey %>"
                  data-v2-related-source-key="<%= collectionSourceKey %>"
                  data-v2-related-field-key="<%= collectionFieldKey %>"
                  data-v2-related-source-field="<%= renderedValue.sourceField %>"
                  data-v2-related-field-type="<%= canonicalField?.type || 'string' %>"
                  data-v2-related-option-items="<%= JSON.stringify([...(canonicalField?.optionItems || []), ...(canonicalField?.enumItems || [])]) %>"
                  data-v2-related-empty-text="<%= collectionField.presentation?.emptyText || '—' %>"
                  <% if (valueExpression) { %>
                      data-v2-related-value-expression="<%= valueExpression %>"
                      <% } %>
                  <% if (toneExpression) { %>
                      data-v2-related-tone-expression="<%= toneExpression %>"
                      <% } %>
                  <% if (iconExpression) { %>
                      data-v2-related-icon-expression="<%= iconExpression %>"
                      <% } %>
                <% } %>
              >
                <% if (relatedPanelFieldIndex === 0) { %><span class="metadata-related-primary-value"><% } %>
                <% if (relatedPanelFieldIndex === 0) { %>
                  <% const entryIcons = relatedEntryIcons(row); %>
                  <%- include('../shell/entry-icons', {
                    entryRepresentation: { icons: entryIcons },
                    iconGroupClass: 'metadata-entry-icons me-1 text-secondary'
                  }) %>
                <% } %>
                <% if (dynamicRelatedValue) { %>
                  <span data-v2-related-dynamic-value><%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %></span>
                <% } else if (renderedValue.calculated && (renderedValue.tone || renderedValue.icon)) { %>
                  <span class="badge text-bg-<%= renderedValue.tone || 'secondary' %>">
                    <% if (renderedValue.icon) { %><i class="bi bi-<%= renderedValue.icon %> me-1" aria-hidden="true"></i><% } %>
                    <%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %>
                  </span>
                <% } else if (selectedOptionItem) { %>
                  <% if (selectedOptionItem.icon) { %><i class="bi bi-<%= selectedOptionItem.icon %> <%= enumToneClass(selectedOptionItem) %> me-1" aria-hidden="true"></i><% } %>
                  <%= selectedOptionItem.label || renderedValue.raw || '—' %>
                <% } else { %>
                  <%= renderedValue.raw ?? collectionField.presentation?.emptyText ?? '—' %>
                <% } %>
                <% if (relatedPanelFieldIndex === 0) { %></span><% } %>
              </div>
              <% relatedPanelFieldIndex += 1; %>
            <% } %>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-secondary small py-2"><%= collection.emptyText || 'No related entries.' %></div>
    <% } %>
  </div>
<% } %>
