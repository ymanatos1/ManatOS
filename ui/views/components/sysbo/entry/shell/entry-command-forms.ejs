<%#
  COMPONENT: Entry command forms

  Purpose:
  - Renders hidden command forms required by metadata-driven entry actions such as delete.

  Inputs / metadata:
  - Entity route/id, CSRF token and resolved command availability.

  CTX contract:
  - None.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Submitted only through explicit entry action workflows; API remains authoritative.
%>

<% for (const [actionKey, action] of commandActionEntries) { %>
  <% if (!isNew && recordId && action.command) { %>
    <form
      id="metadata-command-<%= actionKey %>"
      method="post"
      action="/bo/<%= definition.key %>/<%= recordId %>/<%= action.command %>"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>
  <% } %>
<% } %>

