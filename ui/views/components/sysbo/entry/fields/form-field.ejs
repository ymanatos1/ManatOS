<%#
  COMPONENT: Form field wrapper

  Purpose:
  - Owns form-level placement, label/help, visibility/editability and calculated-value bindings for one canonical field.

  Inputs / metadata:
  - metadata, metadata UI overrides, compiled UI record, key and form helper functions.

  CTX contract:
  - Projects canonical field state/expressions and delegates value binding to entity-field.

  Embeds / delegates:
  - entity-field.ejs.

  Runtime contract:
  - Metadata-form runtime consumes field container/expression/calculation data attributes.
%>
<%
  /*
   * FORM-FIELD WRAPPER (not a concrete field-type component).
   *
   * This layer owns how one canonical field participates in a form: outer grid
   * placement, label/help, visibility/editability, normalization/calculation
   * bindings and read-only submission support. It always delegates the actual
   * type-specific control to entity-field.ejs.
   *
   * Value-source semantics (direct, calculated, default, application-managed)
   * are deliberately orthogonal to presentation. They may change the resolved
   * value or mutability, but they must never choose the concrete UI control.
   */
  const field = metadata.fieldDefinition[key];
  // Selector supplemental data is optional at this wrapper boundary. Preserve
  // the canonical context when supplied, while keeping ordinary field rendering
  // independent from selector-specific page preparation.
  const safeReferenceSelectorContexts =
    typeof referenceSelectorContexts !== 'undefined' ? referenceSelectorContexts : {};
  const visibilityExpression = expressionText(overrides[key]?.visible);
%>
<% if (field && !field.sensitive && (fieldVisible(field) !== false || visibilityExpression)) { %>
  <% const editable = fieldEditable(field); %>
  <% const hasReadOnlyValue = Object.prototype.hasOwnProperty.call(overrides[key] || {}, 'readOnlyValue'); %>
  <% const readOnlyValue = hasReadOnlyValue ? overrides[key].readOnlyValue : undefined; %>
  <% const value = !editable && hasReadOnlyValue ? readOnlyValue : valueFor(key); %>
  <% const effectiveFieldContext = typeof effectiveFieldFor === 'function' ? effectiveFieldFor(key) : null; %>
  <% const visibleExpression = expressionText(overrides[key]?.visible); %>
  <% const editableExpression = expressionText(overrides[key]?.editable); %>
  <% const calculation = field.calculation; %>
  <% const normalization = field.normalize; %>
  <div
    class="col-md-<%= span || 6 %>"
    data-ctx-field-container="<%= key %>"
    <% if (typeof spanExpression !== 'undefined' && spanExpression) { %>
      data-ui-grid-span-expression="<%= spanExpression %>"
      data-ui-grid-span-fallback="<%= span || 6 %>"
    <% } %>
    <% if (normalization?.expression) { %>
      data-field-normalize-expression="<%= normalization.expression %>"
    <% } %>
    <% if (calculation?.expression) { %>
      data-field-calculation-expression="<%= calculation.expression %>"
      data-field-calculation-triggered-by="<%= JSON.stringify(calculation.triggeredBy || []) %>"
      data-field-calculation-persisted="<%= calculation.persisted === true ? 'true' : 'false' %>"
    <% } %>
    <% if (visibleExpression) { %>
      data-ui-visible-expression="<%= visibleExpression %>"
    <% } %>
    <% if (editableExpression) { %>
      data-ui-editable-expression="<%= editableExpression %>"
    <% } %>
    <% if (hasReadOnlyValue) { %>
      data-ui-has-readonly-value="true"
      data-ui-readonly-value="<%= JSON.stringify(readOnlyValue) %>"
    <% } %>
    <%= !fieldVisible(field) ? 'hidden' : '' %>
  >
    <label
      class="form-label" for="metadata-field-<%= key %>"
      data-metadata-field-label="<%= key %>"><%= fieldLabel(field) %>:<% if (field.required) { %><span
      class="metadata-field-required-marker"
      aria-label="required"> (*)</span><% } %></label>
    <%- include('entity-field', {
      key,
      field,
      value,
      editable,
      fieldLabel,
      enumItemsFor,
      referenceValues,
      referenceSelectorContexts: safeReferenceSelectorContexts,
      effectiveFieldContext,
      dateOnlyValue,
      datetimeLocalValue,
      durationParts,
      durationSerializedValue
    }) %>
    <% if (overrides[key]?.helpText) { %>
      <div class="form-text"><%= overrides[key].helpText %></div>
    <% } %>
    <% if (!isViewMode && hasReadOnlyValue) { %>
      <input
        type="hidden"
        name="<%= key %>"
        value="<%= readOnlyValue ?? '' %>"
        data-readonly-submit="<%= key %>"
        <%= editable ? 'disabled' : '' %>
      >
    <% } %>
  </div>
<% } %>
