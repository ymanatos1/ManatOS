<%#
  COMPONENT: Field tools menu

  Purpose:
  - Provides shared copy/inspect/mutation actions for enhanced entity-field controls.

  Inputs / metadata:
  - key, editable, actions; optional developerToolsEnabled/ctxBound.

  CTX contract:
  - Inspect action targets the canonical field CTX node; mutation actions operate through the field runtime.

  Embeds / delegates:
  - None.

  Runtime contract:
  - data-field-input-action hooks are handled by the metadata form/field runtime.
%>
<%
  /*
   * Shared field-component functionality menu. Read-only fields remain fully
   * inspectable; only actions that mutate the canonical field value are disabled.
   */
  const mutationActions = Array.isArray(actions) ? actions : [];
  const showDeveloperTools = typeof developerToolsEnabled === 'boolean' ? developerToolsEnabled : false;
  const inspectCtx = typeof ctxBound === 'boolean' ? ctxBound : true;
%>
<ul class="dropdown-menu metadata-field-input-menu <%= editable ? 'is-enabled' : 'is-readonly' %>">
  <li>
    <button class="dropdown-item" type="button" data-field-input-action="copy">
      <i class="bi bi-copy me-2" aria-hidden="true"></i>Copy current value
    </button>
  </li>
  <% if (showDeveloperTools && inspectCtx) { %>
    <li>
      <button class="dropdown-item" type="button" data-field-input-action="inspect-ctx" data-field-key="<%= key %>">
        <i class="bi bi-bug me-2" aria-hidden="true"></i>Inspect in CTX Viewer
      </button>
    </li>
  <% } %>
  <% if (mutationActions.length) { %>
    <li><hr class="dropdown-divider"></li>
    <% for (const action of mutationActions) { %>
      <li>
        <button
          class="dropdown-item"
          type="button"
          data-field-input-action="<%= action.action %>"
          <%= editable ? '' : 'disabled aria-disabled="true"' %>
        >
          <% if (action.icon) { %><i class="bi bi-<%= action.icon %> me-2" aria-hidden="true"></i><% } %><%= action.label %>
        </button>
      </li>
    <% } %>
  <% } %>
</ul>
