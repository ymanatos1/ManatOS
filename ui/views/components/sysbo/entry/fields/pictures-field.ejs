<%#
  COMPONENT: Ordered pictures field

  Purpose:
  - Renders one metadata-driven ordered picture collection with add, delete and drag-to-reorder behavior.

  Inputs / metadata:
  - Uses the canonical pictures array plus fieldOverride.pictureEditor presentation policy.

  CTX contract:
  - CTX owns the ordered storage-neutral descriptor array. Source/cropped bytes and editor bookkeeping remain private until Save.

  Embeds / delegates:
  - Delegates cropping/editing to picture-editor.ejs and collection behavior to the shared picture field runtime.

  Runtime contract:
  - data-pictures-* hooks are owned by field-runtime.js; binary payloads remain outside semantic CTX state.
%>
<%
  const pictures = Array.isArray(value) ? value : [];
  const recordId = item?.id ? String(item.id) : '';
  const pictureEditor = fieldOverride?.presentation?.pictureEditor || {};
  const maxSourceBytes = Number(pictureEditor.maxSourceBytes || 20_000_000);
  const cropAspectRatio = Number(pictureEditor.cropAspectRatio || 1);
  const cropModes = Array.isArray(pictureEditor.cropModes) && pictureEditor.cropModes.length
    ? pictureEditor.cropModes
    : ['proportional', 'free'];
  const outputSize = Number(pictureEditor.outputSize || 1024);
  const outputContentType = String(pictureEditor.outputContentType || 'image/jpeg');
  const outputQuality = Number(pictureEditor.outputQuality || 0.9);
  const editorId = `metadata-pictures-editor-${key}`;
%>
<div
  class="metadata-pictures-field"
  data-pictures-field
  data-record-id="<%= recordId %>"
  data-entity-key="<%= definition.key %>"
  data-field-key="<%= key %>"
  data-picture-max-source-bytes="<%= maxSourceBytes %>"
  data-picture-crop-aspect-ratio="<%= cropAspectRatio %>"
  data-picture-crop-modes="<%= cropModes.join(',') %>"
  data-picture-output-size="<%= outputSize %>"
  data-picture-output-content-type="<%= outputContentType %>"
  data-picture-output-quality="<%= outputQuality %>"
  data-picture-editor-id="<%= editorId %>"
>
  <div class="metadata-pictures-strip" data-pictures-strip>
    <% for (const picture of pictures) { %>
      <% if (!picture?.id) continue; %>
      <%
        const pictureSrc =
          `/bo/${definition.key}/${encodeURIComponent(recordId)}/pictures/` +
          `${encodeURIComponent(key)}/${encodeURIComponent(picture.id)}` +
          `?revision=${encodeURIComponent(String(picture.revision || ''))}`;
      %>
      <div
        class="metadata-pictures-item"
        draggable="<%= editable ? 'true' : 'false' %>"
        data-picture-item
        data-picture-id="<%= picture.id %>"
        data-picture-descriptor="<%= encodeURIComponent(JSON.stringify(picture)) %>"
        title="Drag to reorder"
      >
        <img
          src="<%= pictureSrc %>"
          alt="<%= fieldLabel(field) %> thumbnail"
        >
        <% if (editable) { %>
          <button
            type="button"
            class="btn btn-sm btn-danger metadata-pictures-delete"
            data-pictures-delete
            title="Delete picture"
            aria-label="Delete picture"
          ><i class="bi bi-trash"></i></button>
        <% } %>
      </div>
    <% } %>
    <% if (editable) { %>
      <button type="button" class="metadata-pictures-add" data-pictures-add title="Add picture" aria-label="Add picture"><i class="bi bi-plus-lg"></i></button>
    <% } %>
  </div>
  <input type="file" class="d-none" accept="image/jpeg,image/png,image/webp,image/gif" data-pictures-file multiple>
  <input type="hidden" name="picturesChange.<%= key %>" value="" data-pictures-change-payload>
  <input type="hidden" name="<%= key %>" value="<%= JSON.stringify(pictures) %>" data-ctx-field="<%= key %>" data-ctx-value-type="json" data-pictures-canonical-value>
  <div class="form-text">
    <span data-pictures-count><%= pictures.length %> picture<%= pictures.length === 1 ? '' : 's' %>.</span>
    Add pictures, drag thumbnails to reorder, or delete individual pictures. Changes are committed with Save.
  </div>
  <%- include('picture-editor', { editorId, editorTitle: 'Add picture', applyLabel: 'Add picture' }) %>
</div>
