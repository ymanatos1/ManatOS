<%#
  COMPONENT: Shared picture crop editor

  Purpose:
  - Renders one reusable crop/edit popup for scalar picture and ordered pictures fields.

  Inputs / metadata:
  - editorId, editorTitle and applyLabel identify and caption the editor instance.

  CTX contract:
  - Owns no semantic CTX values; picture-field runtimes publish semantic descriptors through canonical field mutation.

  Embeds / delegates:
  - PopupRuntime supplies the universal popup CTX action immediately before the close control.

  Runtime contract:
  - data-picture-editor* and data-picture-crop* hooks are owned by the shared picture field runtime.
%>
<div
  class="modal fade metadata-picture-editor-modal"
  id="<%= editorId %>"
  tabindex="-1"
  aria-labelledby="<%= editorId %>-label"
  aria-hidden="true"
  data-popup-purpose="picture-editor"
  data-picture-editor-modal
>
  <div class="modal-dialog modal-dialog-centered metadata-picture-editor-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="<%= editorId %>-label"><%= editorTitle %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-danger d-none py-2" role="alert" data-picture-editor-error></div>
        <div class="metadata-picture-editor-workspace">
          <aside
            class="metadata-picture-editor-file-list d-none"
            data-picture-editor-file-list
            aria-label="Selected pictures"
          ></aside>
          <div class="metadata-picture-editor-main">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
              <div class="btn-group btn-group-sm" role="group" aria-label="Picture editor tool">
                <button type="button" class="btn btn-primary" data-picture-editor-tool="move"><i class="bi bi-arrows-move me-1"></i>Move</button>
                <button type="button" class="btn btn-outline-secondary" data-picture-editor-tool="crop"><i class="bi bi-crop me-1"></i>Crop area</button>
              </div>
              <div class="btn-group btn-group-sm d-none" role="group" aria-label="Crop shape" data-picture-crop-mode-group>
                <button type="button" class="btn btn-primary" data-picture-crop-mode="proportional">Proportional</button>
                <button type="button" class="btn btn-outline-secondary" data-picture-crop-mode="free">Free</button>
              </div>
            </div>
            <div class="metadata-picture-crop-stage" data-picture-crop-stage>
              <canvas width="560" height="560" data-picture-crop-canvas aria-label="Picture crop preview"></canvas>
            </div>
            <div class="metadata-picture-crop-help small text-secondary mt-2">
              Move/zoom the picture, or choose Crop area and drag over the portion to keep. Drag an existing
              crop rectangle to reposition it; click outside it and drag to crop again. When available, choose
              Proportional or Free crop.
            </div>
            <div class="d-flex align-items-center gap-2 mt-3">
              <i class="bi bi-image small text-secondary" aria-hidden="true"></i>
              <input class="form-range mb-0" type="range" min="1" max="3" step="0.01" value="1" aria-label="Picture zoom" data-picture-crop-zoom>
              <i class="bi bi-zoom-in small text-secondary" aria-hidden="true"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" data-picture-crop-apply disabled data-picture-apply-label="<%= applyLabel %>">
          <i class="bi bi-crop me-1"></i><span data-picture-apply-text><%= applyLabel %></span>
        </button>
      </div>
    </div>
  </div>
</div>
