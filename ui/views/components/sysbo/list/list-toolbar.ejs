<%#
  COMPONENT: SysBO list toolbar

  Purpose:
  - Renders count, filter/search controls and optional Add action for browse and selector surfaces.

  Inputs / metadata:
  - totalEntries, filterFields, query, searchPlaceholder, resolvedAddAction and selectorMode.

  CTX contract:
  - None; caller owns list/selector state.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Browse search submits through the list route; selector hooks are handled by record-selector.js.
%>

<%
  /*
   * Shared metadata-driven list toolbar.
   *
   * Browse pages and selection surfaces intentionally use the same structure.
   * Only behavior differs: browse Search submits through the owning list route,
   * while selection Search is handled by the owner workspace against its local
   * selection collection.
   */
  const toolbarSelectorMode = typeof selectorMode !== 'undefined' && selectorMode === true;
  const toolbarCount = Number(typeof totalEntries !== 'undefined' ? totalEntries : 0);
  const toolbarQuery = typeof query !== 'undefined' && query ? query : {};
  const toolbarSearchValue = String(toolbarQuery.search || '');
  const toolbarSearchPlaceholder = typeof searchPlaceholder === 'string' && searchPlaceholder ? searchPlaceholder : 'Search entries';
%>
<div class="metadata-list-toolbar d-flex justify-content-between align-items-center gap-3 flex-wrap mb-3" <%= toolbarSelectorMode ? 'data-selector-toolbar' : '' %>>
  <div class="text-secondary">
    <strong class="text-body" <%= toolbarSelectorMode ? 'data-selector-count' : '' %>><%= toolbarCount %></strong>
    <%= toolbarCount === 1 ? 'entry' : 'entries' %>
  </div>

  <div class="d-flex align-items-center gap-2 flex-wrap ms-auto metadata-list-toolbar-actions">
    <% if (filterFields.length) { %>
      <button
        class="btn <%= hasActiveFilters ? 'btn-outline-primary' : 'btn-outline-secondary' %>"
        type="button"
        <% if (toolbarSelectorMode) { %>
          data-selector-filters-toggle
        <% } else { %>
          data-bs-toggle="collapse"
          data-bs-target="#<%= filterCollapseId %>"
        <% } %>
        aria-expanded="<%= hasActiveFilters ? 'true' : 'false' %>"
        aria-controls="<%= filterCollapseId %>"
      >
        <i class="bi bi-funnel me-1" aria-hidden="true"></i>
        Filters
        <% if (activeFilterCount) { %><span class="badge text-bg-primary ms-1"><%= activeFilterCount %></span><% } %>
      </button>
    <% } %>

    <% if (toolbarSelectorMode) { %>
      <input class="form-control metadata-list-search" type="search" placeholder="<%= toolbarSearchPlaceholder %>" data-selector-filter>
    <% } else { %>
      <form method="get" class="metadata-list-search-form d-flex align-items-center" role="search">
        <% for (const [key, value] of Object.entries(toolbarQuery)) { %>
          <% if (key === 'search' || key === 'page') continue; %>
          <input type="hidden" name="<%= key %>" value="<%= value %>">
        <% } %>
        <input
          class="form-control metadata-list-search"
          type="search"
          name="search"
          value="<%= toolbarSearchValue %>"
          placeholder="<%= toolbarSearchPlaceholder %>"
          aria-label="Search entries"
        >
      </form>
    <% } %>

    <% if (!toolbarSelectorMode) { %>
      <% for (const action of (typeof clientPageActions !== 'undefined' ? clientPageActions : [])) { %>
        <% if (action.kind !== 'navigate') continue; %>
        <a
          class="<%= action.cssClass %>"
          href="<%= action.href %>"
          title="<%= action.title || action.label %>"
          data-v2-list-action="page:<%= action.key %>"
          data-action-href="<%= action.href %>"
          data-action-title="<%= action.title || action.label %>"
          hidden
        >
          <% if (action.icon) { %><i class="bi bi-<%= action.icon %> me-1" aria-hidden="true"></i><% } %><%= action.label %>
        </a>
      <% } %>

      <% if (typeof clientAddAction !== 'undefined' && clientAddAction) { %>
        <a
          class="btn btn-success"
          href="<%= clientAddAction.href %>"
          data-v2-list-action="add"
          data-action-href="<%= clientAddAction.href %>"
          hidden
        >
          <i class="bi bi-plus-circle me-1"></i><%= clientAddAction.label %>
        </a>
      <% } %>
    <% } %>
  </div>
</div>
