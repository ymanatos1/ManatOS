<%
  const defaultTooltips = {
    Home: 'Go to Home',
    Company: 'Company information',
    Platform: 'Current platform',
    Resources: 'Resources',
    'Apps Playground': 'Open Apps Playground',
  };
  const itemTooltip = item.tooltip || defaultTooltips[item.text] || item.text;
%>
<% if (item.children?.length) { %>
  <li class="<%= level === 0 ? 'nav-item dropdown' : 'dropdown-submenu' %>">
    <a
      class="<%= level === 0 ? 'nav-link dropdown-toggle' : 'dropdown-item dropdown-toggle' %>"
      href="#"
      role="button"
      data-bs-toggle="dropdown"
      aria-expanded="false"
      title="<%= itemTooltip %>"
    >
      <% if (item.icon) { %><i class="bi <%= item.icon %> me-1"></i><% } %>
      <%= item.text %>
    </a>
    <ul class="dropdown-menu shadow-sm">
      <% for (const child of item.children) { %>
        <%- include('horizontal-nav-item', { item: child, level: level + 1 }) %>
      <% } %>
    </ul>
  </li>
<% } else { %>
  <li class="<%= level === 0 ? 'nav-item' : '' %>">
    <a
      class="<%= level === 0 ? 'nav-link' : 'dropdown-item' %>"
      href="<%= item.url || '#' %>"
      title="<%= itemTooltip %>"
    >
      <% if (item.icon) { %><i class="bi <%= item.icon %> me-1"></i><% } %>
      <%= item.text %>
    </a>
  </li>
<% } %>
