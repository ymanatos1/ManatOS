<% if (app.navigation.horizontal?.length) { %>
<nav class="horizontal-nav navbar navbar-expand-lg" aria-label="Main navigation">
  <div class="container-fluid px-3 px-lg-4">
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#horizontalMenu"
      aria-controls="horizontalMenu"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="horizontalMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% for (const item of app.navigation.horizontal) { %>
          <%- include('horizontal-nav-item', { item, level: 0 }) %>
        <% } %>
      </ul>

      <% if (currentUser) { %>
        <div class="horizontal-user-identity" aria-label="Signed-in account">
          <i class="bi bi-person-check" aria-hidden="true"></i>
          <span class="horizontal-user-name"><%= currentUser.name %></span>
          <span class="horizontal-user-role"><%= currentUser.role %></span>
        </div>
      <% } %>

      <!--
        UI-language selector foundation.

        The selected locale is browser-persisted per signed-in website user
        (or per anonymous visitor) and updates document.lang. Full translation
        of metadata/page content can build on this locale in the i18n pass.
      -->
      <ul class="navbar-nav ms-lg-auto mb-2 mb-lg-0 horizontal-language-nav">
        <li class="nav-item dropdown">
          <button
            class="nav-link dropdown-toggle horizontal-language-toggle"
            id="languageMenuButton"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Select language"
            title="Select language"
          >
            <img
              id="languageMenuFlag"
              class="language-flag"
              src="/assets/flags/en.svg"
              alt=""
              aria-hidden="true"
            >
            <span id="languageMenuLabel">EN</span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="languageMenuButton">
            <li>
              <button
                class="dropdown-item language-option"
                type="button"
                data-ui-language="en"
                title="Use English"
                aria-label="Use English"
              >
                <img src="/assets/flags/en.svg" class="language-flag me-2" alt="" aria-hidden="true" >
                EN — English
              </button>
            </li>

            <li>
              <button
                class="dropdown-item language-option"
                type="button"
                data-ui-language="el"
                title="Χρήση Ελληνικών"
                aria-label="Χρήση Ελληνικών"
              >
                <img src="/assets/flags/el.svg" class="language-flag me-2" alt="" aria-hidden="true" >
                EL — Ελληνικά
              </button>
            </li>
          </ul>
        </li>
      </ul>

      <% if (app.ui?.debugTools) { %>
        <ul class="navbar-nav mb-2 mb-lg-0 horizontal-debug-nav">
          <li class="nav-item dropdown">
            <button
              class="nav-link dropdown-toggle horizontal-debug-menu-toggle"
              id="debugMenuButton"
              type="button"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              title="Developer tools"
              aria-label="Developer tools"
            >
              <i class="bi bi-bug" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="debugMenuButton">
              <li>
                <button
                  class="dropdown-item d-flex align-items-center gap-2"
                  id="toggleDebugPanel"
                  type="button"
                  role="menuitemcheckbox"
                  aria-checked="false"
                  aria-controls="developerToolsDock"
                  title="Show or hide the Developer Tools dock"
                >
                  <i class="bi bi-square debug-menu-check" aria-hidden="true"></i>
                  <i class="bi bi-tools" aria-hidden="true"></i>
                  <span>Show/hide Developer tools</span>
                </button>
              </li>
              <li><hr class="dropdown-divider"></li>
              <li>
                <button
                  class="dropdown-item d-flex align-items-center gap-2"
                  id="toggleDebugDiagnostics"
                  type="button"
                  role="menuitemcheckbox"
                  aria-checked="true"
                  title="Show CTX and expression warnings/errors as developer notifications"
                >
                  <i class="bi bi-check-square debug-menu-check" aria-hidden="true"></i>
                  <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                  <span>Show CTX errors/warnings</span>
                </button>
              </li>
            </ul>
          </li>
        </ul>
      <% } %>
    </div>
  </div>
</nav>
<% } %>
