<%#
  COMPONENT: CTX viewer

  Purpose:
  - Renders the live canonical CTX tree inspector and its navigation/properties controls.

  Inputs / metadata:
  - Developer-mode shell state; no entity-specific metadata contract.

  CTX contract:
  - Reads the live ManatOS CTX tree and selection/history state; inspection must never mutate business values.

  Embeds / delegates:
  - debugging-cli.ejs for the CTX-scoped command line.

  Runtime contract:
  - ctx-debug runtime owns tree rendering, selection, history, watch, properties, find, resize and CLI integration.
%>

<!--
  ManatOS development debugger.

  Debugger-only markup lives here. The CTX runtime/event contract is generic
  ManatOS infrastructure even though this inspector is currently its main
  interactive consumer.
-->
<aside
  class="debug-panel d-none"
  id="debugPanel"
  aria-label="ManatOS CTX viewer"
  aria-hidden="true"
  inert
  data-developer-tool-panel="ctx"
>
  <div class="debug-panel-tools" role="toolbar" aria-label="CTX viewer navigation">
    <button class="debug-tool-button" id="ctxDebugBack" type="button" title="Previous CTX selection" aria-label="Previous CTX selection" disabled>
      <i class="bi bi-arrow-left"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugForward" type="button" title="Next CTX selection" aria-label="Next CTX selection" disabled>
      <i class="bi bi-arrow-right"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugWatch" type="button" title="Watch selected CTX value for changes" aria-label="Watch selected CTX value for changes">
      <i class="bi bi-eye"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugProperties" type="button" title="Selected node properties" aria-label="Show selected CTX node properties">
      <i class="bi bi-info-square"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugFind" type="button" title="Find CTX variable by key or value" aria-label="Find CTX variable by key or value">
      <i class="bi bi-search"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugCli" type="button" title="Open CLI at selected CTX node" aria-label="Open CLI at selected CTX node" aria-pressed="false">
      <i class="bi bi-terminal"></i>
    </button>
    <button
      class="debug-tool-button"
      id="ctxDebugOpenView"
      type="button"
      title="Open selected CTX node in a dedicated view tab"
      aria-label="Open selected CTX node in a dedicated view tab"
    >
      <i class="bi bi-window-plus"></i>
    </button>
    <span
      class="ctx-debug-stats"
      id="ctxDebugStats"
      tabindex="0"
      aria-label="CTX viewer statistics"
    ></span>
  </div>
  <div class="ctx-debug-selection-path" id="ctxDebugSelectionPath" title="Current canonical CTX path">ctx</div>

  <div class="ctx-debug-find-row d-none" id="ctxDebugFindBox" role="search" aria-label="Find in CTX">
    <div class="ctx-debug-find-input-wrap">
      <input id="ctxDebugFindInput" type="text" autocomplete="off" placeholder="Find in CTX…" aria-label="CTX find pattern">
      <div class="ctx-debug-find-history d-none" id="ctxDebugFindHistory" role="listbox" aria-label="Recent CTX searches"></div>
    </div>
    <button class="debug-tool-button" id="ctxDebugFindPrevious" type="button" title="Find previous" aria-label="Find previous">
      <i class="bi bi-arrow-up"></i>
    </button>
    <button class="debug-tool-button" id="ctxDebugFindNext" type="button" title="Find next" aria-label="Find next">
      <i class="bi bi-arrow-down"></i>
    </button>
    <select id="ctxDebugFindMode" aria-label="CTX find target" title="Find by key, value, or both">
      <option value="key">By key</option>
      <option value="value">By value</option>
      <option value="both">By key + value</option>
    </select>
    <select id="ctxDebugFindSyntax" aria-label="CTX find syntax" title="Wildcard or regular-expression matching">
      <option value="wildcard">Wildcard</option>
      <option value="regex">RegExpr</option>
    </select>
  </div>

  <!--
    Docked between the toolbar and CTX tree: opening properties reduces the
    available tree height instead of covering nodes. The JS keeps the selected
    row visible when this panel opens/closes or selection changes programmatically.
  -->
  <section class="ctx-debug-properties d-none" id="ctxDebugPropertiesPanel" aria-hidden="true" aria-label="Selected CTX node properties">
    <div class="ctx-debug-properties-heading">
      <span id="ctxDebugPropertiesTitle"><strong class="ctx-debug-properties-variable-name">ctx</strong></span>
      <button class="btn-close btn-close-sm" type="button" id="ctxDebugPropertiesClose" aria-label="Close node properties"></button>
    </div>
    <div class="ctx-debug-properties-tabs" role="tablist" aria-label="CTX node property sections">
      <button type="button" class="ctx-debug-properties-tab is-active" data-properties-tab="main" role="tab" aria-selected="true">Main</button>
      <button type="button" class="ctx-debug-properties-tab" data-properties-tab="subscribers" role="tab" aria-selected="false">Subscribers</button>
    </div>
    <div class="ctx-debug-properties-body" id="ctxDebugPropertiesBody"></div>
    <div class="ctx-debug-properties-resize" id="ctxDebugPropertiesResize" title="Drag to resize; double-click to reset" aria-hidden="true"></div>
  </section>

  <div id="ctxDebugTree" class="ctx-debug-tree" role="tree" aria-label="ManatOS context tree"></div>

</aside>
