<%
  const externalIdentityCollection = relatedCollectionMetadataFor('sys-users', 'externalIdentities');
  const externalIdentityMetadata = externalIdentityCollection
    ? relatedEntityMetadata?.[externalIdentityCollection.entityKey]
    : null;
  const externalIdentityProviderField = externalIdentityMetadata?.fieldDefinition?.provider;
  const externalIdentityEntityIcon = externalIdentityCollection?.rowIcon || externalIdentityCollection?.icon || null;

  // Provider presentation comes from the same canonical option metadata used by
  // related-collections. Runtime authProviders is only a defensive fallback for
  // a future provider value not yet known to the canonical catalogue.
  const providerFor = (providerKey) => {
    const canonical = metadataOptionItemForField(externalIdentityProviderField, providerKey);
    if (canonical) return {
      key: providerKey,
      label: canonical.label || providerKey,
      icon: canonical.icon ? `bi-${String(canonical.icon).replace(/^bi-/, '')}` : null,
    };
    return authProviders.find((candidate) => candidate.key === providerKey);
  };

  /*
   * Status text comes from the same canonical SysUser calculated fields used by
   * metadata-driven SysUser forms. This partial owns presentation only; it must
   * not duplicate those business/presentation calculations from raw booleans.
   */
  const resolvedEmailVerificationStatus = emailVerificationStatus || 'Not verified';
  const resolvedLocalPasswordStatus = localPasswordStatus || 'Not configured';
  const emailIsVerified = resolvedEmailVerificationStatus === 'Verified';
  const localPasswordConfigured = resolvedLocalPasswordStatus === 'Configured';

  const verificationSourceDisplayName = (source) => {
    if (source === 'internal') {
      return 'ManatOS';
    }

    return providerFor(source)?.label || source;
  };
%>

<div class="account-summary-grid authentication-summary-grid">
  <div class="account-summary-label">Email verification</div>
  <div class="account-summary-value">
    <span class="badge text-bg-<%= emailIsVerified ? 'success' : 'secondary' %>">
      <%= resolvedEmailVerificationStatus %>
    </span>
  </div>

  <div class="account-summary-label">Verification source</div>
  <div class="account-summary-value">
    <% if (emailIsVerified && authenticationUser.emailVerificationSource) { %>
      <%= verificationSourceDisplayName(authenticationUser.emailVerificationSource) %>
    <% } else { %>
      <span class="text-secondary">—</span>
    <% } %>
  </div>

  <div class="account-summary-label">Verified at</div>
  <div class="account-summary-value">
    <% if (authenticationUser.emailVerifiedAt) { %>
      <%= new Date(authenticationUser.emailVerifiedAt).toLocaleString() %>
    <% } else { %>
      <span class="text-secondary">—</span>
    <% } %>
  </div>

  <div class="account-summary-label">Local password</div>
  <div class="account-summary-value account-password-status">
    <span
      class="status-value <%= localPasswordConfigured ? 'status-positive' : 'status-neutral' %>"
    >
      <i
        class="bi <%= localPasswordConfigured ? 'bi-check-circle-fill' : 'bi-dash-circle' %>"
      ></i>
      <%= resolvedLocalPasswordStatus %>
    </span>

    <% if (showPasswordAction === true) { %>
      <a class="btn btn-outline-primary btn-sm" href="/account/password">
        <i class="bi bi-key me-1"></i>
        <%= localPasswordConfigured ? 'Change password' : 'Set password' %>
      </a>
    <% } %>
  </div>
</div>

<div class="authentication-identities mt-4">
  <h3 class="h6 mb-3">
    <% if (externalIdentityCollection?.icon) { %><i class="bi bi-<%= externalIdentityCollection.icon %> me-1"></i><% } %>
    <%= externalIdentityCollection?.label || 'External identities' %>
  </h3>

  <% if (authenticationIdentities && authenticationIdentities.length > 0) { %>
    <div class="authentication-identity-list">
      <% for (const identity of authenticationIdentities) { %>
        <div class="authentication-identity-row">
          <div class="authentication-provider">
            <%
              const identityProvider = providerFor(identity.provider);
              const identityRepresentation = externalIdentityCollection
                ? entryRepresentationFor(externalIdentityCollection.entityKey, identity, externalIdentityEntityIcon)
                : null;
            %>
            <%- include('../sysbo/entry/entry-icons', {
              entryRepresentation: identityRepresentation,
              iconGroupClass: 'metadata-entry-icons me-1 text-secondary'
            }) %>
            <i
              class="bi <%= identityProvider?.icon || 'bi-box-arrow-in-right' %>"
              aria-hidden="true"
            ></i>
            <strong><%= identityProvider?.label || identity.provider %></strong>
          </div>

          <div class="authentication-identity-email">
            <%= identity.email || 'No email supplied' %>
          </div>

          <div>
            <span class="badge text-bg-<%= identity.emailVerified ? 'success' : 'secondary' %>">
              <%= identity.emailVerified ? 'Provider email verified' : 'Provider email not verified' %>
            </span>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="text-secondary small">No external authentication providers are linked.</div>
  <% } %>
</div>
