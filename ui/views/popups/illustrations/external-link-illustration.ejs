<%#
  COMPONENT: External-link illustration

  Purpose:
  - Renders the reusable external-provider linking illustration.

  Inputs / metadata:
  - Provider/linking presentation inputs.

  CTX contract:
  - None.

  Embeds / delegates:
  - None.

  Runtime contract:
  - None; purely presentational SVG/markup.
%>

<%#
  Provider-aware illustration used when an external identity is being linked or resolved.
  Unlike static auth illustrations, this component derives its provider tile from metadata,
  allowing the same rich-popup structure to represent Microsoft, Google, Facebook, GitHub
  and future authentication providers without provider-specific popup templates.
%>
<div class="external-link-illustration" aria-hidden="true">
  <div class="external-link-provider-tile">
    <i class="bi <%= provider.icon %>"></i>
  </div>

  <div class="external-link-manatos-tile">
    <img
      src="/assets/m1/favicon-96x96.png"
      alt=""
    >
  </div>

  <div class="external-link-connector">
    <i class="bi bi-link-45deg"></i>
  </div>

  <div class="external-link-shield">
    <i class="bi bi-shield-check"></i>
  </div>
</div>
