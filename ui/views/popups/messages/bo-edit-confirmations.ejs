<%#
  SysBO edit-page confirmation dialogs.

  These remain in the message popup family because they ask for confirmation rather than
  collecting domain input. Required bo-edit state is passed explicitly by the caller; do not
  rely on undeclared ambient EJS variables, which makes partial dependencies hard to test.
%>
<%
  // deleteImpact is a non-mutating server preflight. `authorized:false` means
  // this particular row is not deletable by the current caller even if their
  // role normally has entity-level delete permission.
  const deleteAuthorized = typeof deleteImpact === 'undefined' || deleteImpact?.authorized !== false;
%>
<% if (!isNew && permissions.delete && deleteEnabled && deleteAuthorized) { %>
  <div
    class="modal fade"
    id="deleteEntryModal"
    tabindex="-1"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    aria-labelledby="deleteEntryModalLabel"
  >
    <div class="modal-dialog">
      <form
        class="modal-content"
        method="post"
        action="/bo/<%= definition.key %>/<%= item.id %>/delete"
        data-allow-dirty-page-exit="true"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <%- include('../partials/popup-header', {
          labelId: 'deleteEntryModalLabel',
          icon: 'bi-trash',
          titleClass: 'h5',
          headerClass: 'bg-danger-subtle',
          modalTitle: `Delete ${deletePresentation.displayValue} ${deletePresentation.entityLabel}`,
          modalSubtitle: null
        }) %>

        <%
          const effectiveDeleteImpact = typeof deleteImpact !== 'undefined' ? deleteImpact : null;
          const impactAvailable = Boolean(effectiveDeleteImpact && Array.isArray(effectiveDeleteImpact.impacts));

          /*
           * A delete confirmation is deliberately more informative than the
           * relationship confirmation policy itself. Even a relationship marked
           * "silent" is shown here because the Admin has already opened a
           * destructive confirmation and should see every known consequence.
           */
          const visibleImpacts = impactAvailable ? effectiveDeleteImpact.impacts : [];
          const deleteBlocked = !impactAvailable || effectiveDeleteImpact?.canExecute === false;

          const impactPresentation = (impact) => {
            if (impact.action === 'cascade') {
              return {
                icon: 'bi-trash3',
                tone: 'text-danger',
                title: 'dependent record(s) will also be permanently deleted',
                detail: 'The relationship policy requires these dependent records to be removed to preserve referential integrity.',
              };
            }

            if (impact.action === 'unlink') {
              return {
                icon: 'bi-link-45deg',
                tone: 'text-warning-emphasis',
                title: 'relationship link(s) will be removed',
                detail: 'Only the relationship data are removed; the related business records remain and referential integrity is preserved.',
              };
            }

            if (impact.action === 'set-null') {
              return {
                icon: 'bi-eraser',
                tone: 'text-info-emphasis',
                title: 'reference(s) will be cleared',
                detail: 'The related records remain; their reference to this entry is cleared to preserve referential integrity.',
              };
            }

            return {
              icon: 'bi-ban',
              tone: 'text-danger',
              title: 'relationship(s) block this deletion',
              detail: 'Referential-integrity rules require these relationships to be resolved before this entry can be deleted.',
            };
          };
        %>
        <div class="modal-body">
          <p class="mb-0">
            Are you sure you want to permanently delete
            <strong><%= deletePresentation.displayValue %></strong>?
          </p>

          <div
            class="border rounded-3 p-3 mt-3 <%= deleteBlocked ? 'border-danger-subtle bg-danger-subtle' : 'bg-body-tertiary' %>"
            data-delete-impact-summary
          >
            <div class="d-flex align-items-center gap-2 fw-semibold mb-2">
              <i class="bi bi-diagram-3" aria-hidden="true"></i>
              <span>Data &amp; referential-integrity impact</span>
            </div>

            <% if (!impactAvailable) { %>
              <div class="d-flex gap-2 align-items-start text-warning-emphasis">
                <i class="bi bi-exclamation-triangle mt-1" aria-hidden="true"></i>
                <div>
                  <div class="fw-semibold">Data-integrity impact could not be verified.</div>
                  <div class="small">
                    ManatOS could not complete the relationship-metadata check needed to verify
                    referential-integrity consequences. Cancel and retry before deleting.
                  </div>
                </div>
              </div>
            <% } else if (!visibleImpacts.length) { %>
              <div class="d-flex gap-2 align-items-start text-success">
                <i class="bi bi-check-circle mt-1" aria-hidden="true"></i>
                <div>
                  <div class="fw-semibold">No related data or referential-integrity impact was found.</div>
                  <div class="small text-body-secondary">
                    The current relationship metadata were checked; no related records were found that
                    would be deleted, unlinked, changed, or block this deletion.
                  </div>
                </div>
              </div>
            <% } else { %>
              <div class="vstack gap-2">
                <% for (const impact of visibleImpacts) {
                  const presentation = impactPresentation(impact);
                %>
                  <div class="d-flex gap-2 align-items-start" data-delete-impact-action="<%= impact.action %>">
                    <i class="bi <%= presentation.icon %> <%= presentation.tone %> mt-1" aria-hidden="true"></i>
                    <div>
                      <div>
                        <strong><%= impact.count %></strong>
                        <strong><%= impact.objectName %></strong>
                        — <span class="<%= presentation.tone %>"><%= presentation.title %></span>.
                      </div>
                      <div class="small text-body-secondary"><%= presentation.detail %></div>
                      <div class="small text-body-tertiary">
                        Relationship: <code><%= impact.relationship %></code>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <% if (deleteBlocked) { %>
            <div class="alert alert-danger mt-3 mb-0" role="alert">
              <div class="fw-semibold">
                <i class="bi bi-ban me-1" aria-hidden="true"></i>
                Deletion cannot continue
              </div>
              <div class="small mt-1">
                One or more related records restrict deletion. Resolve those relationships first.
              </div>
            </div>
          <% } else { %>
            <p class="text-danger fw-semibold mt-3 mb-0">
              <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>
              This action cannot be undone.
            </p>
          <% } %>
        </div>

        <%- include('../partials/popup-footer', {
          leftActions: [],
          rightActions: [
            { label: 'Cancel', variant: 'btn-secondary', dismiss: true },
            { label: 'Delete', variant: 'btn-danger', type: 'submit', disabled: deleteBlocked }
          ]
        }) %>
      </form>
    </div>
  </div>
<% } %>

<% if (!isNew && definition.key === 'sys-ext-auth-providers' && permissions.edit) { %>
  <div
    class="modal fade"
    id="removeProviderCredentialsModal"
    tabindex="-1"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
    aria-labelledby="removeProviderCredentialsModalLabel"
  >
    <div class="modal-dialog">
      <form
        class="modal-content"
        method="post"
        action="/bo/sys-ext-auth-providers/<%= item.id %>/remove-credentials"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <%- include('../partials/popup-header', {
          labelId: 'removeProviderCredentialsModalLabel',
          icon: 'bi-key',
          titleClass: 'h5',
          headerClass: 'bg-danger-subtle',
          modalTitle: 'Remove provider credentials',
          modalSubtitle: null
        }) %>

        <div class="modal-body">
          Remove the stored Client ID and Client secret for
          <strong><%= deletePresentation.displayValue %></strong>?
          <p class="text-danger mt-2 mb-0">The provider will also be disabled. New credentials must be tested successfully before it can be enabled again.</p>
        </div>

        <%- include('../partials/popup-footer', {
          leftActions: [],
          rightActions: [
            { label: 'Cancel', variant: 'btn-secondary', dismiss: true },
            { label: 'Remove credentials', variant: 'btn-danger', type: 'submit' }
          ]
        }) %>
      </form>
    </div>
  </div>
<% } %>

<div
  class="modal fade"
  id="unsavedChangesModal"
  tabindex="-1"
  aria-labelledby="unsavedChangesModalLabel"
  data-bs-backdrop="static"
  data-bs-keyboard="false"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <%- include('../partials/popup-header', {
        labelId: 'unsavedChangesModalLabel',
        icon: 'bi-exclamation-triangle',
        titleClass: 'h5',
        headerClass: 'bg-warning-subtle',
        modalTitle: 'Unsaved changes',
        modalSubtitle: null,
        dismissible: false
      }) %>

      <div class="modal-body">
        You have changes that have not been saved.
      </div>

      <%- include('../partials/popup-footer', {
        leftActions: [],
        rightActions: [
          { label: 'Cancel', variant: 'btn-secondary', data: { 'unsaved-action': 'cancel' } },
          { label: 'Discard', variant: 'btn-outline-danger', data: { 'unsaved-action': 'discard' } },
          { label: 'Save', variant: 'btn-primary', data: { 'unsaved-action': 'save' } }
        ]
      }) %>
    </div>
  </div>
</div>
