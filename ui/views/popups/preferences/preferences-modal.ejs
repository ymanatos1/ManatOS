<%#
  Independent/form popup example outside the auth and generic-message families.
  Preferences uses the common popup header/footer conventions but owns its specialized form
  body. Future unrelated settings/tools can live beside it under popups/preferences without forcing
  them into authentication-specific abstractions.
%>
<% if (currentUser) { %>
  <div
    class="modal fade"
    id="preferencesModal"
    tabindex="-1"
    aria-labelledby="preferencesModalLabel"
    aria-hidden="true"
    data-bs-backdrop="static"
    data-bs-keyboard="false"
  >
    <div class="modal-dialog preferences-modal-dialog">
      <div class="modal-content">
        <%- include('../shared/popup-header', {
          labelId: 'preferencesModalLabel',
          icon: 'bi-sliders',
          titleClass: 'h5 mb-1',
          modalTitle: 'Website user preferences',
          modalSubtitle: 'Personalize the ManatOS website experience for this browser.'
        }) %>

        <div class="modal-body">
          <fieldset>
            <legend class="h6 mb-3">UI Theme</legend>

            <div class="preferences-theme-options">
              <label class="preferences-theme-option">
                <input
                  class="form-check-input"
                  type="radio"
                  name="uiTheme"
                  value="lighter"
                  data-ui-theme-option
                >

                <span>
                  <strong>Lighter</strong>
                  <small>Light blue header and title surfaces.</small>
                </span>
              </label>

              <label class="preferences-theme-option">
                <input
                  class="form-check-input"
                  type="radio"
                  name="uiTheme"
                  value="darker"
                  data-ui-theme-option
                >

                <span>
                  <strong>Darker</strong>
                  <small>Current navy header and stronger title surfaces.</small>
                </span>
              </label>
            </div>

            <div class="preferences-theme-preview mt-3" data-ui-theme-preview data-preview-theme="darker">
              <div class="small text-secondary mb-2">Selected theme preview</div>
              <div class="preferences-theme-preview-grid">
                <div class="preferences-theme-preview-swatch is-header"><span>Header</span></div>
                <div class="preferences-theme-preview-swatch is-title"><span>Title</span></div>
                <div class="preferences-theme-preview-swatch is-text"><span>Text</span></div>
                <div class="preferences-theme-preview-swatch is-date"><span>Date</span></div>
                <div class="preferences-theme-preview-swatch is-enum"><span>Enum</span></div>
                <div class="preferences-theme-preview-swatch is-reference"><span>Related</span></div>
              </div>
            </div>
          </fieldset>
        </div>

        <%- include('../shared/popup-footer', {
          leftActions: [],
          rightActions: [
            { label: 'Cancel', variant: 'btn-secondary', dismiss: true },
            { label: 'Save preferences', icon: 'bi-check-circle', variant: 'btn-primary', id: 'savePreferencesButton' }
          ]
        }) %>
      </div>
    </div>
  </div>
<% } %>
