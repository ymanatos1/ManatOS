<%#
  COMPONENT: External-provider buttons

  Purpose:
  - Renders a reusable list of external authentication provider actions.

  Inputs / metadata:
  - Provider definitions, mode and configured/available state.

  CTX contract:
  - None directly.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Authentication provider runtime handles provider actions.
%>

<%#
  Shared external-provider action list used by Sign in and Register.

  The initial server-side value is deliberately allowed to be empty. The browser
  refreshes this list from /auth/external-providers whenever either authentication
  dialog opens, so provider availability reflects current API/database state rather
  than UI startup state.
%>
<%
  const actionLabel = mode === 'register' ? 'Register with' : 'Continue with';
%>

<div class="auth-provider-list" data-auth-provider-list data-auth-provider-mode="<%= mode %>">
  <% for (const provider of authProviders) { %>
    <% if (provider.configured) { %>
      <a
        class="btn btn-outline-secondary auth-provider-button"
        href="/auth/<%= provider.key %>?intent=<%= mode %>"
        data-busy
        data-busy-title="Connecting to <%= provider.label %>…"
        data-busy-message="Please wait while <%= provider.label %> authenticates your account."
        data-busy-icon="<%= provider.icon %>"
      >
        <i class="bi <%= provider.icon %> auth-provider-icon" aria-hidden="true"></i>
        <span><%= actionLabel %> <%= provider.label %></span>
        <i class="bi bi-chevron-right auth-provider-chevron" aria-hidden="true"></i>
      </a>
    <% } else { %>
      <button
        class="btn btn-outline-secondary auth-provider-button is-unavailable"
        type="button"
        disabled
        title="<%= provider.label %> authentication is not configured yet."
      >
        <i class="bi <%= provider.icon %> auth-provider-icon" aria-hidden="true"></i>
        <span><%= actionLabel %> <%= provider.label %></span>
        <span class="badge auth-provider-status ms-auto">Not configured</span>
      </button>
    <% } %>
  <% } %>

  <% if (!authProviders.length) { %>
    <div class="small text-secondary py-2" data-auth-provider-placeholder>
      Checking external provider availability…
    </div>
  <% } %>
</div>
