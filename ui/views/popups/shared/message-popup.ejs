<%#
  Compact message/confirmation popup layout.

  Message popups intentionally use the same shared header/footer infrastructure as rich
  popups but omit hero/form regions that would otherwise create a nullable, over-generalized
  layout. Optional operationTrace is reserved for power-user diagnostics on failures.
%>
<%
  const messageDialogClass = typeof dialogClass !== 'undefined' && dialogClass ? dialogClass : 'modal-md';
  const messageActions = Array.isArray(actions) ? actions : [];
  const messageTrace = typeof operationTrace !== 'undefined' && Array.isArray(operationTrace)
    ? operationTrace
    : [];
%>
<div
  class="modal fade"
  id="<%= modalId %>"
  tabindex="-1"
  data-auto-show="true"
  aria-labelledby="<%= labelId %>"
  aria-hidden="true"
>
  <div class="modal-dialog <%= messageDialogClass %>">
    <div class="modal-content">
      <%- include('popup-header', {
        labelId,
        icon,
        titleClass: 'h5',
        headerClass,
        modalTitle,
        modalSubtitle: null
      }) %>

      <div class="modal-body">
        <p class="<%= messageTrace.length ? '' : 'mb-0' %>"><%= message %></p>

        <% if (messageTrace.length) { %>
          <details>
            <summary><%= typeof detailsLabel !== 'undefined' && detailsLabel ? detailsLabel : 'Show operation details' %></summary>
            <pre class="operation-trace mt-2"><%= JSON.stringify(messageTrace, null, 2) %></pre>
          </details>
        <% } %>
      </div>

      <%- include('popup-footer', {
        leftActions: [],
        rightActions: messageActions
      }) %>
    </div>
  </div>
</div>
