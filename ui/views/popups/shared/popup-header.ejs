<%#
  COMPONENT: Popup header

  Purpose:
  - Renders canonical popup title/subtitle, CTX inspection and explicit close chrome.

  Inputs / metadata:
  - Title/subtitle/icon/close behavior and ctxInspectable presentation inputs.

  CTX contract:
  - CTX button delegates popup-path selection to the shared popup runtime.

  Embeds / delegates:
  - None.

  Runtime contract:
  - Shared popup runtime binds CTX toggle and Bootstrap close lifecycle.
%>

<%#
  Shared popup header.

  The popup architecture distinguishes the modal-level title/subtitle rendered here from
  the contentTitle/contentParagraphs rendered inside a rich popup hero. This partial also
  centralizes close behavior so normal Bootstrap dismissal and navigation-style close links
  remain visually identical. Callers should pass semantic values, not presentation markup.
%>
<%
  const popupHeaderClass = typeof headerClass !== 'undefined' && headerClass ? headerClass : '';
  const popupTitleClass = typeof titleClass !== 'undefined' && titleClass ? titleClass : 'h4 mb-1';
  const popupCloseLabel = typeof closeLabel !== 'undefined' && closeLabel ? closeLabel : 'Close';
  const popupCloseTitle = typeof closeTitle !== 'undefined' && closeTitle ? closeTitle : '';
  const popupCloseHref = typeof closeHref !== 'undefined' && closeHref ? closeHref : null;
  const popupDismissible = typeof dismissible === 'undefined' ? true : Boolean(dismissible);
  const popupCtxInspectable = typeof ctxInspectable === 'undefined' ? true : Boolean(ctxInspectable);
%>
<div class="modal-header <%= popupHeaderClass %>">
  <div>
    <h2 class="modal-title <%= popupTitleClass %>" id="<%= labelId %>">
      <% if (typeof icon !== 'undefined' && icon) { %>
        <i class="bi <%= icon %> me-2" aria-hidden="true"></i>
      <% } %>
      <%= modalTitle %>
    </h2>

    <% if (typeof modalSubtitle !== 'undefined' && modalSubtitle) { %>
      <p class="modal-subtitle mb-0"><%= modalSubtitle %></p>
    <% } %>
  </div>

  <div class="d-flex align-items-center gap-2 ms-auto">
    <% if (popupCtxInspectable) { %>
      <%#
        Popup CTX inspection is part of the shared header contract. The runtime
        reveals this button only when Developer Tools are available and binds it
        to the canonical ctx.<leaf-page>.popup node. Keeping it here guarantees
        the universal placement immediately before the close action.
      %>
      <button
        class="btn btn-sm btn-outline-secondary d-none"
        type="button"
        data-popup-ctx-inspect
        aria-pressed="false"
        title="Toggle this popup context in Developer Tools"
      >
        <i class="bi bi-bug me-1" aria-hidden="true"></i>CTX
      </button>
    <% } %>

    <% if (popupCloseHref) { %>
      <a
        class="btn-close"
        href="<%= popupCloseHref %>"
        aria-label="<%= popupCloseLabel %>"
        <% if (popupCloseTitle) { %>title="<%= popupCloseTitle %>"<% } %>
      ></a>
    <% } else if (popupDismissible) { %>
      <button
        class="btn-close"
        type="button"
        data-bs-dismiss="modal"
        aria-label="<%= popupCloseLabel %>"
        <% if (popupCloseTitle) { %>title="<%= popupCloseTitle %>"<% } %>
      ></button>
    <% } %>
  </div>
</div>
