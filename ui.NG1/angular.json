{
  "$schema": "../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "ui.NG1": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "outputPath": "dist/ui.NG1",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "../node_modules/bootstrap/dist/css/bootstrap.min.css",
              "../node_modules/bootstrap-icons/font/bootstrap-icons.css",
              "../shared.UI.NG/src/theme/Theme.css",
              "src/styles.css",
              "../shared.UI/src/pages/entities/FieldTools.css",
              "../shared.UI/src/pages/entities/EntryUIViewSelector.css"
            ]
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ui.NG1:build"
          }
        }
      }
    }
  }
}
