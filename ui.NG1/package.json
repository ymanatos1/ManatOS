    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@angular/common": "20.3.1",
    "@angular/compiler": "20.3.1",
    "@angular/core": "20.3.1",
    "@angular/platform-browser": "20.3.1",
    "@manatos/shared-ui": "0.1.0",
    "@manatos/shared-ui-ng": "0.1.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "express": "^5.1.0"
